<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NebulaLauncher.Core</RootNamespace>
    <AssemblyName>NebulaLauncher.Core</AssemblyName>
    <!--
      启用裁剪与 AOT 分析器：本项目会被单文件裁剪发布（build.ps1 的 portable 模式），
      分析器在编译期就报出反射/动态代码依赖，避免像 #26 那样等到发布包运行才炸。
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MC 百科译名表（数据来自 PCL 的 PCLCS/Resource/WikiEntries.txt，格式见 ModNameTable）。
      嵌入而不是复制到输出目录：单文件发布时 Content 项会漏，模组页会静默失去全部中文名。
    -->
    <EmbeddedResource Include="Resources\WikiEntries.txt" />
    <!--
      默认皮肤（Steve / Alex，64×64 PNG，自绘）。
      嵌入而不是 Content：单文件发布时 Content 会漏，离线账户的头像就没有兜底图。
    -->
    <EmbeddedResource Include="Resources\Skins\*.png" />
  </ItemGroup>

</Project>
