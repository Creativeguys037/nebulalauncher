<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:controls="using:NebulaLauncher.Controls"
             xmlns:views="using:NebulaLauncher.Views"
             xmlns:services="using:NebulaLauncher.Services"
             x:Class="NebulaLauncher.Views.SkinsView"
             x:DataType="vm:SkinsViewModel">

  <!--
    内容·皮肤（票 #92），结构照 .oil-ui/nebula-2/explore/skins-glass.html：
      Row0 40  来源页签（网络皮肤库 / 本地皮肤）
      Row1 48  搜索 + 体型分段 + 上传菜单 + 云端衣柜 + 导入皮肤
      Row2 *   两列：左 = 网格（GlassPanel 内唯一滚动），右 = 固定 300 的预览卡
      Row3 44  结果条（换肤结果 / 皮肤站结果 / 页面错误，同时只会有一条）

    与旧实现的三处结构差异：
      1. 三套自绘页签（网络 / 本地 / 云端衣柜）收敛成两层：来源用 TabControl，
         体型用 ToggleButton 组；云端衣柜是另一个页面，改工具条上的按钮进。
      2. 预览卡从「右下角悬浮 220×260」改成「右侧固定 300 列」——悬浮卡会盖住
         网格最后一列，样板里的两列是并列关系，不是浮层关系。
      3. 账户条从页面顶部删掉：账户名与徽标在页面副标题里，换肤走预览卡下方的操作行。
  -->

  <UserControl.Styles>
    <!--
      皮肤卡（样板：160×200 / 圆角 16）：上半是缩略图，下半是名称与作者。
      卡片自己不做选中态视觉——选中由 ListBoxItem 的 Accent 边框表达，避免两层边框打架。
    -->
    <Style Selector="Border.skincard">
      <Setter Property="Width" Value="160" />
      <Setter Property="Height" Value="200" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
      <Setter Property="Background" Value="{DynamicResource Surface.CardSolid}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
          <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
          <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static services:Motion.Fast}" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.skincard:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
      <Setter Property="RenderTransform" Value="translate(0,-2px)" />
    </Style>

    <Style Selector="TextBox.sksearch">
      <Setter Property="Width" Value="320" />
    </Style>

    <Style Selector="Window.compact TextBox.sksearch">
      <Setter Property="Width" Value="180" />
    </Style>

    <Style Selector="ListBoxItem:selected Border.skincard">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

    <!-- ==================== Row0（40）：来源页签 ==================== -->
    <TabControl Grid.Row="0"
                Classes="strip"
                VerticalAlignment="Center"
                SelectedIndex="{Binding SourceTabIndex, Mode=TwoWay}">
      <TabItem Header="网络皮肤库" />
      <TabItem Header="本地皮肤" />
    </TabControl>

    <!-- ==================== Row1（48）：工具条 ==================== -->
    <Grid Grid.Row="1" Height="48" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">

      <TextBox Grid.Column="0"
               Classes="sksearch"
               Height="36"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               VerticalContentAlignment="Center"
               Watermark="搜索皮肤名称或作者"
               Text="{Binding Keyword}"
               KeyDown="OnSearchKeyDown"
               CornerRadius="{DynamicResource Radius.Md}" />

      <!-- 体型：轻量选中（白底主色字），与实心主色的来源页签分开 -->
      <Border Grid.Column="1"
              Classes="sunken"
              Padding="3"
              Height="36"
              VerticalAlignment="Center"
              CornerRadius="{DynamicResource Radius.Md}">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ToggleButton Classes="segmented"
                        Content="细 (Alex)"
                        IsChecked="{Binding IsSlimModel, Mode=OneWay}"
                        Command="{Binding SetSlimModelCommand}" />
          <ToggleButton Classes="segmented"
                        Content="粗 (Steve)"
                        IsChecked="{Binding IsClassicModel, Mode=OneWay}"
                        Command="{Binding SetClassicModelCommand}" />
        </StackPanel>
      </Border>

      <!--
        上传入口：官方换肤与皮肤站材质是两条通道（可用条件不同），
        三条结果也各报各的；五种按钮排开会把工具条撑满，收进一个菜单里。
      -->
      <Button Grid.Column="2"
              Classes="ghost"
              Height="36"
              VerticalAlignment="Center"
              Content="上传 / 应用到账户">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="应用到微软账户"
                      IsEnabled="{Binding !IsOfficialBusy}"
                      Command="{Binding ApplyToOfficialCommand}" />
            <MenuItem Header="上传本地皮肤到微软账户"
                      IsEnabled="{Binding !IsOfficialBusy}"
                      Click="OnUploadLocalSkinClick" />
            <MenuItem Header="重置为默认皮肤"
                      IsVisible="{Binding Official.CanReset}"
                      Command="{Binding ResetOfficialSkinCommand}" />
            <Separator />
            <MenuItem Header="应用到皮肤站账户"
                      IsEnabled="{Binding !IsAuthlibBusy}"
                      Command="{Binding ApplyToAuthlibCommand}" />
            <MenuItem Header="上传本地皮肤到皮肤站"
                      IsEnabled="{Binding !IsAuthlibBusy}"
                      Click="OnUploadLocalSkinClick" />
            <MenuItem Header="上传披风"
                      IsEnabled="{Binding Authlib.CanUploadCape}"
                      Click="OnUploadCapeClick" />
            <Separator />
            <MenuItem Header="删除皮肤站皮肤"
                      IsEnabled="{Binding Authlib.CanDeleteSkin}"
                      Command="{Binding DeleteAuthlibSkinCommand}" />
            <MenuItem Header="删除皮肤站披风"
                      IsEnabled="{Binding Authlib.CanDeleteCape}"
                      Command="{Binding DeleteAuthlibCapeCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>

      <!-- 云端衣柜不是「来源」，它是另一个页面（Blessing Skin 网页会话），用按钮进 -->
      <Button Grid.Column="3"
              Classes="ghost"
              Height="36"
              VerticalAlignment="Center"
              IsEnabled="{Binding IsCloudAvailable}"
              ToolTip.Tip="云端衣柜是另一个页面：Blessing Skin 网页会话"
              Content="云端衣柜"
              Command="{Binding GoToCloudClosetCommand}" />

      <Button Grid.Column="4"
              Classes="ghost"
              Height="36"
              VerticalAlignment="Center"
              Click="OnImportLocalSkinClick"
              ToolTip.Tip="把本地 PNG 导入皮肤目录">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Data="{StaticResource Icon.Upload}"
                Stroke="{DynamicResource Text.Secondary}"
                StrokeThickness="1.8"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Stretch="Uniform"
                Width="14" Height="14" />
          <TextBlock Text="导入皮肤" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- ==================== Row2（*）：网格 + 固定 300 预览列 ==================== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="16">

      <!--  左列：网格  -->
      <controls:GlassPanel Grid.Column="0" Padding="0">
        <Grid RowDefinitions="*,Auto">

          <ScrollViewer Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Panel Margin="8">

              <!-- 网络皮肤库：首屏占位 / 列表 / 空态 -->
              <Panel IsVisible="{Binding IsNetworkTab}">
                <Border Classes="card"
                        IsVisible="{Binding ShowLoadingPlaceholder}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24,28">
                  <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
                    <TextBlock Text="正在从皮肤库读取…" Classes="muted" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         IsVisible="{Binding !IsEmpty}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkinEntryViewModel">
                      <Border Classes="skincard" Margin="0,0,12,12">
                        <Grid RowDefinitions="*,Auto" RowSpacing="8">
                          <!-- 缩略图：没有图时用人形轮廓撑住版式 -->
                          <Border Grid.Row="0"
                                  CornerRadius="{DynamicResource Radius.Sm}"
                                  ClipToBounds="True"
                                  Background="{DynamicResource Surface.Sunken}">
                            <Panel>
                              <Border Background="{DynamicResource Gradient.CardOverlay}" />
                              <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                                    IsVisible="{Binding !HasThumbnail}"
                                    Stroke="{DynamicResource Text.Muted}"
                                    StrokeThickness="1.4"
                                    Stretch="Uniform"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                              <Image Source="{Binding Thumbnail}"
                                     IsVisible="{Binding HasThumbnail}"
                                     Stretch="Uniform" />
                            </Panel>
                          </Border>

                          <StackPanel Grid.Row="1" Spacing="2">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Name}" />
                            <TextBlock Text="{Binding LikesLabel}"
                                       Classes="caption"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding IsEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="320"
                            Spacing="10">
                  <Border Width="48" Height="48"
                          CornerRadius="{DynamicResource Radius.Md}"
                          Background="{DynamicResource Surface.CardSolid}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource Stroke.Subtle}"
                          HorizontalAlignment="Center">
                    <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                          Stroke="{DynamicResource Text.Tertiary}"
                          StrokeThickness="1.6"
                          Stretch="Uniform"
                          Width="24" Height="24" />
                  </Border>
                  <TextBlock Text="没有找到皮肤" Classes="h3" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding EmptyHint}"
                             Classes="caption"
                             Foreground="{DynamicResource Text.Tertiary}"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             LineHeight="17" />
                </StackPanel>
              </Panel>

              <!-- 本地皮肤库：皮肤 / 披风两个分类 -->
              <Panel IsVisible="{Binding IsLocalTab}">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">

                  <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                            Classes="feedback"
                            IsVisible="{Binding HasLocalError}"
                            Padding="10,6">
                      <TextBlock Text="{Binding LocalErrorText}" Classes="caption" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                      <Button Classes="ghost" Content="刷新" Height="30"
                              ToolTip.Tip="重新扫描本地皮肤目录"
                              Command="{Binding RefreshLocalCommand}" />
                      <Button Classes="ghost" Content="打开目录" Height="30"
                              IsEnabled="{Binding IsLocalDirectoryAvailable}"
                              Command="{Binding OpenLocalDirectoryCommand}" />
                    </StackPanel>
                  </Grid>

                  <Panel Grid.Row="1">
                    <!-- 皮肤分类 -->
                    <Panel IsVisible="{Binding IsLocalSkinCategory}">
                      <Border Classes="card"
                              IsVisible="{Binding ShowLocalLoadingPlaceholder}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Padding="24,28">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                          <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
                          <TextBlock Text="正在读取本地皮肤目录…" Classes="muted" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <ListBox ItemsSource="{Binding LocalItems}"
                               SelectedItem="{Binding SelectedLocal}"
                               IsVisible="{Binding HasLocalItems}"
                               Background="Transparent"
                               BorderThickness="0"
                               Padding="0">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:LocalSkinEntryViewModel">
                            <Border Classes="skincard" Margin="0,0,12,12">
                              <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                <Border Grid.Row="0"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Surface.Sunken}">
                                  <Panel>
                                    <Border Background="{DynamicResource Gradient.CardOverlay}" />
                                    <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                                          IsVisible="{Binding !HasThumbnail}"
                                          Stroke="{DynamicResource Text.Muted}"
                                          StrokeThickness="1.4"
                                          Stretch="Uniform"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Image Source="{Binding Thumbnail}"
                                           IsVisible="{Binding HasThumbnail}"
                                           Stretch="Uniform" />
                                  </Panel>
                                </Border>

                                <StackPanel Grid.Row="1" Spacing="2">
                                  <TextBlock Text="{Binding Name}"
                                             FontSize="{DynamicResource FontSize.Body}"
                                             FontWeight="SemiBold"
                                             TextTrimming="CharacterEllipsis"
                                             ToolTip.Tip="{Binding Name}" />
                                  <TextBlock Text="{Binding DetailLabel}"
                                             Classes="caption"
                                             Foreground="{DynamicResource Text.Tertiary}"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <StackPanel IsVisible="{Binding IsLocalEmpty}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  MaxWidth="320"
                                  Spacing="10">
                        <TextBlock Text="本地还没有皮肤" Classes="h3" HorizontalAlignment="Center" />
                        <TextBlock Text="把皮肤 PNG 导进来，或者直接丢进下面这个目录——放进去之后回到这一页就能看见。"
                                   Classes="caption"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="17" />
                        <TextBlock Text="{Binding LocalDirectory}"
                                   Classes="mono"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button Classes="accent"
                                HorizontalAlignment="Center"
                                Content="从文件导入"
                                Click="OnImportLocalSkinClick" />
                      </StackPanel>
                    </Panel>

                    <!-- 披风分类：官方已拥有的披风，只能切换不能上传 -->
                    <Panel IsVisible="{Binding IsLocalCapeCategory}">
                      <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Grid.Row="0" Spacing="6">
                          <Border Classes="feedback"
                                  IsVisible="{Binding HasCapeStatus}"
                                  Padding="10,6">
                            <TextBlock Text="{Binding CapeStatusText}" Classes="caption" TextWrapping="Wrap" />
                          </Border>
                          <Border Classes="feedback"
                                  IsVisible="{Binding HasCapeError}"
                                  Padding="10,6">
                            <TextBlock Text="{Binding CapeErrorText}" Classes="caption" TextWrapping="Wrap" />
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="ghost" Content="刷新披风" Height="30"
                                    IsEnabled="{Binding CanRefreshCapes}"
                                    ToolTip.Tip="重新读取这个微软账户已拥有的披风"
                                    Command="{Binding RefreshCapesCommand}" />
                            <Button Classes="ghost" Content="隐藏披风" Height="30"
                                    IsEnabled="{Binding CanHideCape}"
                                    ToolTip.Tip="把当前披风从角色身上取下来"
                                    Command="{Binding HideCapeCommand}" />
                          </StackPanel>
                        </StackPanel>

                        <Panel Grid.Row="1">
                          <ItemsControl ItemsSource="{Binding Capes}"
                                        IsVisible="{Binding HasCapes}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MojangCapeViewModel">
                                <Border Classes="skincard" Margin="0,0,12,12">
                                  <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                    <Border Grid.Row="0"
                                            CornerRadius="{DynamicResource Radius.Sm}"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Surface.Sunken}">
                                      <Panel>
                                        <Border Background="{DynamicResource Gradient.CardOverlay}" />
                                        <Path Data="M8 6h8l2 4v10H6V10l2-4Zm2 8h4"
                                              IsVisible="{Binding !HasThumbnail}"
                                              Stroke="{DynamicResource Text.Muted}"
                                              StrokeThickness="1.4"
                                              Stretch="Uniform"
                                              Width="40" Height="40"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}"
                                               IsVisible="{Binding HasThumbnail}"
                                               Stretch="Uniform" />
                                      </Panel>
                                    </Border>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                      <TextBlock Grid.Column="0"
                                                 Text="{Binding DisplayName}"
                                                 FontSize="{DynamicResource FontSize.Body}"
                                                 FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" />
                                      <Border Grid.Column="1"
                                              Classes="badge success"
                                              IsVisible="{Binding IsActive}">
                                        <TextBlock Text="使用中" />
                                      </Border>
                                    </Grid>

                                    <Button Grid.Row="1"
                                            Classes="ghost"
                                            Height="26"
                                            VerticalAlignment="Bottom"
                                            Content="{Binding ActionLabel}"
                                            IsEnabled="{Binding CanUse}"
                                            Command="{Binding $parent[UserControl].((vm:SkinsViewModel)DataContext).UseCapeCommand}"
                                            CommandParameter="{Binding}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <StackPanel IsVisible="{Binding IsCapeEmpty}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MaxWidth="320"
                                      Spacing="10">
                            <TextBlock Text="没有可切换的披风" Classes="h3" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CapeHint}"
                                       Classes="caption"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="17" />
                          </StackPanel>
                        </Panel>
                      </Grid>
                    </Panel>
                  </Panel>
                </Grid>
              </Panel>

              <!-- 云端衣柜：Blessing Skin 网页会话 -->
              <Grid IsVisible="{Binding IsCloudTab}" ClipToBounds="True">
                <views:CloudClosetView DataContext="{Binding Cloud}" />
              </Grid>
            </Panel>
          </ScrollViewer>

          <!-- 本地页签的目录常驻行 -->
          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                Margin="8,4,8,8"
                IsVisible="{Binding ShowLocalFooter}">
            <TextBlock Text="{Binding LocalDirectory}"
                       Classes="caption"
                       Foreground="{DynamicResource Text.Tertiary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LocalSummary}"
                       Classes="caption"
                       Foreground="{DynamicResource Text.Tertiary}"
                       VerticalAlignment="Center" />
          </Grid>

          <!-- 网络页签的分页条：末页时「下一页」禁用 -->
          <Grid Grid.Row="1"
                ColumnDefinitions="Auto,*,Auto"
                Margin="8,4,8,8"
                IsVisible="{Binding IsNetworkTab}">
            <Button Classes="ghost" Height="28" Content="上一页"
                    IsEnabled="{Binding CanGoPrev}"
                    Command="{Binding PreviousPageCommand}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding PageLabel}" Classes="caption" />
              <TextBlock Text="{Binding PageSummary}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Height="28" Content="下一页"
                    IsEnabled="{Binding CanGoNext}"
                    Command="{Binding NextPageCommand}" />
          </Grid>
        </Grid>
      </controls:GlassPanel>

      <!--  右列：固定 300 的预览卡  -->
      <controls:GlassPanel Grid.Column="1" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

          <!-- 3D 预览：可拖动旋转；加载中共用一条细进度条。高度弹性，1024 下不挤掉操作行。 -->
          <Border Grid.Row="0"
                  MinHeight="200"
                  MaxHeight="300"
                  CornerRadius="{DynamicResource Radius.Md}"
                  ClipToBounds="True"
                  Background="{DynamicResource Surface.Sunken}">
            <Panel>
              <Panel IsVisible="{Binding !IsCloudTab}">
                <controls:SkinModelView Visual="{Binding PreviewVisual}"
                                        Cursor="SizeAll"
                                        ClipToBounds="True" />
                <Image Source="{Binding CapePreviewOverride}"
                       IsVisible="{Binding HasCapePreviewOverride}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <ProgressBar IsVisible="{Binding IsPreviewLoading}"
                             IsIndeterminate="True"
                             Height="3"
                             VerticalAlignment="Top" />
              </Panel>
              <Panel IsVisible="{Binding IsCloudTab}">
                <controls:SkinModelView Visual="{Binding Cloud.PreviewVisual}"
                                        Cursor="SizeAll"
                                        ClipToBounds="True" />
                <ProgressBar IsVisible="{Binding Cloud.IsPreviewLoading}"
                             IsIndeterminate="True"
                             Height="3"
                             VerticalAlignment="Top" />
              </Panel>
            </Panel>
          </Border>

          <!-- 名称 / 元信息 -->
          <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding !IsCloudTab}">
            <TextBlock Text="{Binding PreviewName}"
                       Classes="h3"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding PreviewDetail}"
                       Classes="caption"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       LineHeight="17" />
            <TextBlock Text="拖动旋转 · 滚轮缩放"
                       Classes="caption"
                       Foreground="{DynamicResource Text.Tertiary}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding IsCloudTab}">
            <TextBlock Text="{Binding Cloud.PreviewName}"
                       Classes="h3"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Cloud.PreviewDetail}"
                       Classes="caption"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       LineHeight="17" />
          </StackPanel>

          <!-- 操作行：应用（主）/ 导入 / 删除 -->
          <StackPanel Grid.Row="3" Spacing="8" Margin="0,10,0,0">
            <Border Classes="sunken" Padding="10,6"
                    IsVisible="{Binding HasAuthlibCooldown}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="上传冷却" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding AuthlibCooldownText}"
                           Classes="mono"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- 主行动只留官方通道这一条：300 宽塞不下两个应用入口，
                   皮肤站通道走工具条的上传菜单，两条结果各报各的。 -->
              <Button Classes="accent" Height="34"
                      Content="应用"
                      IsVisible="{Binding Official.CanUpload}"
                      IsEnabled="{Binding !IsOfficialBusy}"
                      ToolTip.Tip="把当前选中的皮肤传到官方账户"
                      Command="{Binding ApplyToOfficialCommand}" />
              <Button Classes="ghost" Height="34" Content="导入"
                      Click="OnImportLocalSkinClick" />
              <!-- 网络皮肤另有一条出口：存进云端衣柜（Blessing Skin 网页会话），
                   它与「应用到官方账户」不是同一个目标，失败原因也不同。 -->
              <Button Classes="ghost" Height="34"
                      Content="{Binding ApplyToCloudLabel}"
                      IsVisible="{Binding IsNetworkTab}"
                      IsEnabled="{Binding CanApplyNetworkToCloud}"
                      ToolTip.Tip="{Binding CloudApplyBlockedHint}"
                      ToolTip.ShowOnDisabled="True"
                      Command="{Binding ApplyToCloudCommand}" />
              <Button Classes="ghost" Height="34" Width="34"
                      ToolTip.Tip="删除皮肤站上的这套皮肤"
                      IsEnabled="{Binding Authlib.CanDeleteSkin}"
                      Command="{Binding DeleteAuthlibSkinCommand}">
                <Path Data="{StaticResource Icon.Close}"
                      Stroke="{DynamicResource Status.Danger}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      Stretch="Uniform"
                      Width="12" Height="12" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </controls:GlassPanel>
    </Grid>

    <!-- ==================== Row3（44）：结果条 ==================== -->
    <Grid Grid.Row="3" Height="44">

      <!-- 换肤结果（官方通道） -->
      <Border IsVisible="{Binding HasOfficialFeedback}"
              Padding="12,0"
              CornerRadius="{DynamicResource Radius.Md}"
              Background="{DynamicResource Surface.Sunken}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Subtle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0"
                     Classes="caption"
                     Text="{Binding OfficialFeedbackText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost" Height="28" Content="重试"
                    IsVisible="{Binding CanRetryOfficial}"
                    IsEnabled="{Binding !IsOfficialBusy}"
                    Command="{Binding RetryOfficialCommand}" />
            <Button Classes="ghost" Height="28" Content="去账户页"
                    IsVisible="{Binding GoToAccountPageVisible}"
                    Command="{Binding GoToAccountPageCommand}" />
            <Button Classes="icon" Width="26" Height="26"
                    ToolTip.Tip="关闭"
                    Command="{Binding DismissOfficialFeedbackCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 换肤结果（皮肤站通道） -->
      <Border IsVisible="{Binding HasAuthlibFeedback}"
              Padding="12,0"
              CornerRadius="{DynamicResource Radius.Md}"
              Background="{DynamicResource Surface.Sunken}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Subtle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0"
                     Classes="caption"
                     Text="{Binding AuthlibFeedbackText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost" Height="28" Content="重试"
                    IsVisible="{Binding CanRetryAuthlib}"
                    IsEnabled="{Binding !IsAuthlibBusy}"
                    Command="{Binding RetryAuthlibCommand}" />
            <Button Classes="ghost" Height="28" Content="去账户页"
                    IsVisible="{Binding GoToAccountPageFromAuthlibVisible}"
                    Command="{Binding GoToAccountPageFromAuthlibCommand}" />
            <Button Classes="icon" Width="26" Height="26"
                    ToolTip.Tip="关闭"
                    Command="{Binding DismissAuthlibFeedbackCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 应用到云端衣柜的结果 -->
      <Border IsVisible="{Binding HasCloudApplyFeedback}"
              Padding="12,0"
              CornerRadius="{DynamicResource Radius.Md}"
              Background="{DynamicResource Surface.Sunken}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Subtle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0"
                     Classes="caption"
                     Text="{Binding CloudApplyFeedbackText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost" Height="28" Content="重试"
                    IsVisible="{Binding CanRetryCloudApply}"
                    IsEnabled="{Binding CanStartCloudApply}"
                    Command="{Binding RetryCloudApplyCommand}" />
            <Button Classes="ghost" Height="28" Content="去云端衣柜"
                    IsVisible="{Binding CloudApplyGoToClosetVisible}"
                    Command="{Binding GoToCloudClosetCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页面级错误（皮肤站断网 / 状态码异常） -->
      <Border IsVisible="{Binding ShowErrorBar}"
              Padding="12,0"
              CornerRadius="{DynamicResource Radius.Md}"
              Background="{DynamicResource Surface.Sunken}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Status.Danger}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Grid.Column="0" Classes="badge danger" VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorBadge}" />
          </Border>
          <TextBlock Grid.Column="1"
                     Classes="caption"
                     Text="{Binding ErrorText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost" Height="28" Content="重试" Command="{Binding RetryCommand}" />
            <Button Classes="icon" Width="26" Height="26"
                    ToolTip.Tip="关闭"
                    Command="{Binding CloseErrorCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>