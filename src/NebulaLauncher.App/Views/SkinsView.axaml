<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:controls="using:NebulaLauncher.Controls"
             x:Class="NebulaLauncher.Views.SkinsView"
             x:DataType="vm:SkinsViewModel">

  <UserControl.Styles>
    <!-- 页签：选中态用强调色描边 + 柔底，与资源库页的分类胶囊同款。 -->
    <Style Selector="Button.pill.tab.active">
      <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- 浏览列表：卡片自带边框，去掉 ListBoxItem 的默认内边距与间距。 -->
    <Style Selector="ListBox.skinList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
    </Style>

    <!-- 选中态体现在卡片描边上：卡片背景不透明，ListBoxItem 的选中底色会被盖住。 -->
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glow}" />
    </Style>

    <!-- 官方换肤的结果条（票 44）：成功走强调色，失败走危险色。用类而不是转换器， -->
    <!-- 这样颜色始终来自令牌，深色与浅色两套都自动跟着主题走。 -->
    <Style Selector="Border.feedback">
      <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    </Style>

    <Style Selector="Border.feedback.danger">
      <Setter Property="Background" Value="{DynamicResource Status.Danger.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Edge}" />
    </Style>

    <Style Selector="Border.feedback TextBlock.feedbackText">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- 体型切换的选中态：与页签同一套观感，避免页面里出现第二种「选中的样子」。 -->
    <Style Selector="Button.pill.model.active">
      <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,320">

    <!-- 错误条：断网时出现，可关闭、可重试。已有内容不清空，所以重试成功即恢复。 -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            IsVisible="{Binding HasError}"
            Background="{DynamicResource Status.Danger.Soft}"
            BorderBrush="{DynamicResource Status.Danger}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Md}"
            Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Classes="badge danger" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorBadge}" />
        </Border>
        <TextBlock Grid.Column="1"
                   Margin="10,0,10,0"
                   Text="{Binding ErrorText}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Status.Danger}" />
        <Button Grid.Column="2" Classes="ghost" Content="重试" Command="{Binding RetryCommand}" />
        <Button Grid.Column="3" Classes="icon" Content="✕" Margin="4,0,0,0"
                ToolTip.Tip="关闭这条提示"
                Command="{Binding CloseErrorCommand}" />
      </Grid>
    </Border>

    <!-- 账户与官方换肤（票 44）：左边账户信息，右边「应用到当前账户」的三个动作。
         放在账户条里而不是右列底部：1024×660 下右列只剩 ~460px，预览卡占掉大半，
         操作区塞在下面就会被裁掉。这里横向有 ~750px，一行放得下三个按钮。 -->
    <Border Grid.Row="1" Grid.ColumnSpan="2"
            Classes="card"
            Padding="16,12"
            Margin="0,0,0,12">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <!-- 账户信息：只读展示，不提供切换器（切账户在账户页做） -->
          <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding AccountName}" Classes="h3" VerticalAlignment="Center" />
              <Border Classes="badge" VerticalAlignment="Center">
                <TextBlock Text="{Binding AccountBadge}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding AccountDetail}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 三个动作。可见性全部来自 OfficialSkinCapability：
               离线账户不出现上传/重置（AC5），披风按钮恒禁用（AC4）。 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="accent"
                    Content="应用到官方账户"
                    IsVisible="{Binding Official.CanUpload}"
                    IsEnabled="{Binding !IsOfficialBusy}"
                    ToolTip.Tip="把当前选中的皮肤传到官方账户"
                    Command="{Binding ApplyToOfficialCommand}" />
            <Button Classes="pill"
                    Content="重置为默认皮肤"
                    IsVisible="{Binding Official.CanReset}"
                    IsEnabled="{Binding !IsOfficialBusy}"
                    ToolTip.Tip="把官方档案恢复成默认皮肤"
                    Command="{Binding ResetOfficialSkinCommand}" />
            <Button Classes="pill"
                    Content="上传披风"
                    IsVisible="{Binding HasAccount}"
                    IsEnabled="False"
                    ToolTip.Tip="{Binding OfficialCapeText}" />
          </StackPanel>
        </Grid>

        <!-- 两条常驻说明：披风为什么点不了（AC4）与换肤的影响范围（AC8）。
             用 WrapPanel 而不是两段固定文本：1024 宽下会自动折行，不会被裁。 -->
        <WrapPanel>
          <TextBlock Text="{Binding OfficialCapeText}" Classes="caption" Margin="0,0,14,2" />
          <TextBlock Text="{Binding OfficialHint}" Classes="muted" Margin="0,0,0,2" />
        </WrapPanel>

        <!-- 离线账户的体型切换（AC5）。官方账户不显示：体型跟着上传时的 variant 走。
             与说明文字同一行：账户条每多一行就把下面的列表压掉一行卡片。 -->
        <Grid ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding Official.CanPickModel}">
          <TextBlock Text="体型" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="pill model"
                    Classes.active="{Binding IsClassicModel}"
                    Content="Steve"
                    IsEnabled="{Binding !IsOfficialBusy}"
                    Command="{Binding SetClassicModelCommand}" />
            <Button Classes="pill model"
                    Classes.active="{Binding IsSlimModel}"
                    Content="Alex"
                    IsEnabled="{Binding !IsOfficialBusy}"
                    Command="{Binding SetSlimModelCommand}" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     Text="{Binding Official.UnavailableText}"
                     Classes="caption"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </Grid>

        <!-- 不可用的原因：第三方 / 缺令牌写在这里，不给一个点了必然失败的按钮。
             离线账户的原因已在上面的体型行里，这里不重复。 -->
        <TextBlock Text="{Binding Official.UnavailableText}"
                   IsVisible="{Binding Official.ShowStandaloneReason}"
                   Classes="caption"
                   TextWrapping="Wrap"
                   LineHeight="18" />

        <ProgressBar IsVisible="{Binding IsOfficialBusy}"
                     IsIndeterminate="True"
                     Height="3" />

        <!-- 结果条：成功一句话，失败给原因 + 该走的那条路（重试 / 去账户页） -->
        <Border Classes="feedback"
                Classes.danger="{Binding IsOfficialFeedbackError}"
                IsVisible="{Binding HasOfficialFeedback}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Md}"
                Padding="10,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding OfficialFeedbackText}"
                       Classes="feedbackText"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="10,0,0,0">
              <Button Classes="pill"
                      Content="重试"
                      IsVisible="{Binding CanRetryOfficial}"
                      IsEnabled="{Binding !IsOfficialBusy}"
                      Command="{Binding RetryOfficialCommand}" />
              <Button Classes="pill"
                      Content="去账户页"
                      IsVisible="{Binding GoToAccountPageVisible}"
                      Command="{Binding GoToAccountPageCommand}" />
              <Button Classes="ghost"
                      Content="知道了"
                      Command="{Binding DismissOfficialFeedbackCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 冷却中：429 之后不让立刻再点，也不让用户以为是界面卡住了 -->
        <TextBlock Text="{Binding OfficialCooldownText}"
                   IsVisible="{Binding HasOfficialCooldown}"
                   Classes="caption"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 左列：页签 + 搜索 + 列表 + 页码 -->
    <Grid Grid.Row="2" Grid.Column="0"
          RowDefinitions="Auto,*,Auto"
          Margin="0,0,12,0">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <Button Classes="pill tab"
                  Classes.active="{Binding IsNetworkTab}"
                  Content="网络皮肤"
                  Command="{Binding SelectNetworkTabCommand}" />
          <Button Classes="pill tab"
                  Classes.active="{Binding IsLocalTab}"
                  Content="本地皮肤"
                  Command="{Binding SelectLocalTabCommand}" />
        </StackPanel>

        <!-- 本地页签的工具条：网络页签那边有搜索框，这里放目录相关的三个动作 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding IsLocalTab}">
          <Button Classes="pill"
                  Content="刷新"
                  ToolTip.Tip="重新扫描本地皮肤目录"
                  Command="{Binding RefreshLocalCommand}" />
          <Button Classes="pill"
                  Content="打开目录"
                  IsEnabled="{Binding IsLocalDirectoryAvailable}"
                  Command="{Binding OpenLocalDirectoryCommand}" />
          <Button Classes="accent"
                  Content="从文件导入"
                  Click="OnImportLocalSkinClick" />
        </StackPanel>
      </Grid>

      <!-- 网络皮肤页签的内容 -->
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*"
            IsVisible="{Binding IsNetworkTab}">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBox VerticalAlignment="Center"
                   Watermark="搜皮肤名，回车"
                   Text="{Binding Keyword}"
                   KeyDown="OnSearchKeyDown" />
          <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0"
                  Content="搜索"
                  Command="{Binding SearchCommand}" />
        </Grid>

        <!-- 顶部细进度条：翻页时不遮挡已有行，断网时也还能看缓存下来的列表。 -->
        <ProgressBar Grid.Row="1"
                     IsVisible="{Binding IsLoading}"
                     IsIndeterminate="True"
                     Height="3"
                     Margin="0,0,0,8" />

        <Grid Grid.Row="2">
          <!-- 首屏加载占位 -->
          <Border Classes="card"
                  IsVisible="{Binding ShowLoadingPlaceholder}"
                  VerticalAlignment="Top"
                  Padding="24,28">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
              <TextBlock Text="正在从皮肤库读取…" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- 浏览列表：一行 = 小图 + 名字 + 类型 + 人气 -->
          <ListBox Classes="skinList"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding Selected}"
                   IsVisible="{Binding !IsEmpty}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SkinEntryViewModel">
                <Border Classes="card hoverable"
                        Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                        Padding="10">
                  <Grid ColumnDefinitions="44,*,Auto">
                    <Border Width="44" Height="44"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            ClipToBounds="True"
                            Background="{DynamicResource Surface.Sunken}">
                      <Panel>
                        <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                              IsVisible="{Binding !HasThumbnail}"
                              Stroke="{DynamicResource Text.Muted}"
                              StrokeThickness="1.4"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}"
                               IsVisible="{Binding HasThumbnail}"
                               Stretch="Uniform" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding LikesLabel}" Classes="caption" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                      <Border Classes="badge" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ModelLabel}" />
                      </Border>

                      <!-- 票 42：把这一套存进本地皮肤目录，之后离线也能用 -->
                      <Button Classes="pill"
                              Content="下载到本地"
                              IsEnabled="{Binding !IsSavingToLocal}"
                              ToolTip.Tip="把这张皮肤存进本地皮肤目录"
                              Command="{Binding $parent[UserControl].((vm:SkinsViewModel)DataContext).DownloadToLocalCommand}"
                              CommandParameter="{Binding}" />

                      <TextBlock Text="{Binding LocalState}"
                                 IsVisible="{Binding HasLocalState}"
                                 Classes="caption"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空状态：搜不到、或者这一页真的没有 -->
          <Border Classes="card"
                  IsVisible="{Binding IsEmpty}"
                  VerticalAlignment="Top"
                  Padding="24,28">
            <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="420">
              <Border Width="52" Height="52"
                      CornerRadius="26"
                      Background="{DynamicResource Accent.Soft}"
                      HorizontalAlignment="Center">
                <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                      Stroke="{DynamicResource Accent.Primary}"
                      StrokeThickness="1.6"
                      Stretch="Uniform"
                      Width="24" Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="没有找到皮肤" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyHint}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- 本地皮肤页签（票 42）：磁盘上的 PNG，一行 = 平面小图 + 文件名 -->
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto"
            IsVisible="{Binding IsLocalTab}">

        <!-- 本地自己的错误条：打不开目录、删不掉文件都落在这里，不去挤网络那条 -->
        <Border Grid.Row="0"
                Classes="card"
                IsVisible="{Binding HasLocalError}"
                Padding="14,10"
                Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="badge" VerticalAlignment="Center">
              <TextBlock Text="本地目录" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding LocalErrorText}"
                       Margin="10,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="pill"
                    Content="重试"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshLocalCommand}" />
          </Grid>
        </Border>

        <!-- 细进度条：重扫时不遮已有行，用户手上还有旧列表可点 -->
        <ProgressBar Grid.Row="1"
                     IsVisible="{Binding IsLocalLoading}"
                     IsIndeterminate="True"
                     Height="3"
                     Margin="0,0,0,8" />

        <Grid Grid.Row="2">
          <!-- 首屏加载占位 -->
          <Border Classes="card"
                  IsVisible="{Binding ShowLocalLoadingPlaceholder}"
                  VerticalAlignment="Top"
                  Padding="24,28">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
              <TextBlock Text="正在读取本地皮肤目录…" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <ListBox Classes="skinList"
                   ItemsSource="{Binding LocalItems}"
                   SelectedItem="{Binding SelectedLocal}"
                   IsVisible="{Binding HasLocalItems}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalSkinEntryViewModel">
                <Border Classes="card hoverable"
                        Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                        Padding="10">
                  <Grid ColumnDefinitions="44,*,Auto,Auto">
                    <Border Width="44" Height="44"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            ClipToBounds="True"
                            Background="{DynamicResource Surface.Sunken}">
                      <Panel>
                        <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                              IsVisible="{Binding !HasThumbnail}"
                              Stroke="{DynamicResource Text.Muted}"
                              StrokeThickness="1.4"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}"
                               IsVisible="{Binding HasThumbnail}"
                               Stretch="Uniform" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DetailLabel}" Classes="caption" />
                    </StackPanel>

                    <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ModelLabel}" />
                    </Border>

                    <Button Grid.Column="3" Classes="pill"
                            Content="删除"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="删除这个皮肤文件"
                            Command="{Binding $parent[UserControl].((vm:SkinsViewModel)DataContext).DeleteLocalCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空态：引导 + 两个按钮（AC8：不白屏，给的是一条走得通的路） -->
          <Border Classes="card"
                  IsVisible="{Binding IsLocalEmpty}"
                  VerticalAlignment="Top"
                  Padding="24,28">
            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="460">
              <Border Width="52" Height="52"
                      CornerRadius="26"
                      Background="{DynamicResource Accent.Soft}"
                      HorizontalAlignment="Center">
                <Path Data="M12 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 4ZM6 20v-2.4a6 6 0 0 1 12 0V20"
                      Stroke="{DynamicResource Accent.Primary}"
                      StrokeThickness="1.6"
                      Stretch="Uniform"
                      Width="24" Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="本地还没有皮肤" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="把皮肤 PNG 导进来，或者直接丢进下面这个目录——放进去之后回到这一页就能看见。"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
              <TextBlock Text="{Binding LocalDirectory}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="accent"
                        Content="从文件导入"
                        Click="OnImportLocalSkinClick" />
                <Button Classes="pill"
                        Content="打开目录"
                        IsEnabled="{Binding IsLocalDirectoryAvailable}"
                        Command="{Binding OpenLocalDirectoryCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- 底部：目录路径常驻，用户想手丢文件时不用去别处找 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0"
              IsVisible="{Binding HasLocalItems}">
          <TextBlock Text="{Binding LocalDirectory}"
                     Classes="caption"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1"
                     Text="{Binding LocalSummary}"
                     Classes="caption"
                     VerticalAlignment="Center" />
        </Grid>
      </Grid>

      <!-- 页码：末页时「下一页」禁用 -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0"
            IsVisible="{Binding IsNetworkTab}">
        <Button Classes="pill"
                Content="上一页"
                IsEnabled="{Binding CanGoPrev}"
                Command="{Binding PreviousPageCommand}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding PageLabel}" Classes="caption" />
          <TextBlock Text="{Binding PageSummary}" Classes="caption" />
        </StackPanel>
        <Button Grid.Column="2" Classes="pill"
                Content="下一页"
                IsEnabled="{Binding CanGoNext}"
                Command="{Binding NextPageCommand}" />
      </Grid>
    </Grid>

    <!-- 右列：中等尺寸 3D 预览卡。可自转、可拖动。 -->
    <Border Grid.Row="2" Grid.Column="1"
            Classes="card"
            Padding="0"
            VerticalAlignment="Top"
            ClipToBounds="True">
      <StackPanel>
        <Border Height="300"
                Background="{DynamicResource Surface.Sunken}"
                ClipToBounds="True">
          <Panel>
            <controls:SkinModelView Visual="{Binding PreviewVisual}"
                                    Cursor="SizeAll"
                                    ClipToBounds="True" />
            <ProgressBar IsVisible="{Binding IsPreviewLoading}"
                         IsIndeterminate="True"
                         Height="3"
                         VerticalAlignment="Top" />
          </Panel>
        </Border>

        <StackPanel Margin="14,10,14,14" Spacing="4">
          <TextBlock Text="{Binding PreviewName}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding PreviewDetail}"
                     Classes="caption"
                     TextWrapping="Wrap" />
          <TextBlock Text="按住拖动可以转视角，松手继续自转"
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
