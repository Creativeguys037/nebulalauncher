<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:views="using:NebulaLauncher.Views"
             xmlns:conv="using:NebulaLauncher.Converters"
             xmlns:controls="using:NebulaLauncher.Controls"
             xmlns:services="using:NebulaLauncher.Services"
             xmlns:sys="using:System"
             x:Class="NebulaLauncher.Views.ServersView"
             x:DataType="vm:ServersViewModel">

  <!--
    服务器页：四行固定栅格（40 / Auto / * / 44），视觉基线 .oil-ui/nebula-2/explore/servers-glass.html。
    Row1 是「提示条 + 新建表单」，两者都隐藏时整行塌到 0；RowSpacing 固定 12、隐藏行仍占间隔，
    所以收起态 Row2 是 509（宽屏）/ 369（紧凑），与 UI-STRUCTURE §3 的表一致。
  -->

  <UserControl.Styles>
    <!--
      服务器行：收起态 72 高，圆角 12。用 MinHeight 而不是 Height，
      因为「玩家名单」展开时这一行要比 72 高，写死 Height 会把名单裁掉。
    -->
    <Style Selector="Border.serverrow">
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.serverrow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>

    <!-- 状态点：语义色只落在这 8×8 上，不铺满行；文字永远并列，不靠颜色单独表意 -->
    <Style Selector="Border.statusDot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Background" Value="{DynamicResource Text.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.statusDot.online">
      <Setter Property="Background" Value="{DynamicResource Status.Success}" />
    </Style>

    <Style Selector="Border.statusDot.timeout">
      <Setter Property="Background" Value="{DynamicResource Status.Warning}" />
    </Style>

    <Style Selector="Button.icon.small">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- 搜索框宽度写样式不写内联：内联值会压过下面的紧凑档 -->
    <Style Selector="TextBox.svsearch">
      <Setter Property="Width" Value="320" />
    </Style>

    <Style Selector="Window.compact TextBox.svsearch">
      <Setter Property="Width" Value="180" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

    <!-- ============ Row0：工具条（固定，不随列表滚动） ============ -->
    <controls:GlassPanel Grid.Row="0" Height="40" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*">
        <TextBox Classes="svsearch"
                 Height="32"
                 Watermark="搜索名称或地址"
                 Text="{Binding Keyword}"
                 VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    HorizontalAlignment="Right">
          <Button Classes="icon small"
                  ToolTip.Tip="刷新全部状态"
                  Command="{Binding RefreshAllCommand}">
            <Path Data="M20 12a8 8 0 1 1-2.3-5.6M20 4v4h-4"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="14" Height="14" />
          </Button>

          <Button Classes="tglass"
                  Command="{Binding ImportFromServersDatCommand}"
                  IsEnabled="{Binding !IsImporting}"
                  ToolTip.Tip="读取当前游戏目录的 servers.dat（Minecraft 自带的服务器列表），已存在的地址会跳过">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="M3 6h6l2 2h10v11H3zM12 12v5M9.5 14.5L12 17l2.5-2.5"
                    Stroke="{DynamicResource Text.Secondary}"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="Uniform"
                    Width="14" Height="14"
                    VerticalAlignment="Center" />
              <TextBlock Text="从 servers.dat 导入" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="accent" Content="添加服务器" Command="{Binding OpenFormCommand}" />
        </StackPanel>
      </Grid>
    </controls:GlassPanel>

    <!-- ============ Row1：提示条与新建/编辑表单（全隐藏时整行塌到 0） ============ -->
    <StackPanel Grid.Row="1" Spacing="12">

      <Border IsVisible="{Binding IsDemoMode}"
              Background="{DynamicResource Status.Warning.Soft}"
              BorderBrush="{DynamicResource Status.Warning}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Md}"
              Padding="14,10">
        <TextBlock Text="示例数据 · Core 服务尚未接线，状态为本地模拟，不会发起网络请求"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Warning}" />
      </Border>

      <Border IsVisible="{Binding HasError}"
              Background="{DynamicResource Status.Danger.Soft}"
              BorderBrush="{DynamicResource Status.Danger}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Md}"
              Padding="14,10">
        <TextBlock Text="{Binding ErrorText}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Danger}" />
      </Border>

      <!-- 表单就地展开在工具条下方，不插进列表、不弹窗：列表整体下移而不是被遮住 -->
      <controls:GlassPanel IsVisible="{Binding IsFormOpen}" Padding="16">
        <Grid ColumnDefinitions="*,12,1.4*,Auto" RowDefinitions="Auto,Auto">

          <TextBox Watermark="名称，可留空（默认用域名）"
                   Text="{Binding FormName}" />

          <TextBox Grid.Column="2"
                   Watermark="地址，例如 play.example.com:25565"
                   Text="{Binding FormAddress}" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <Button Classes="accent" Content="保存" Command="{Binding SaveFormCommand}" />
            <Button Classes="ghost" Content="取消" Command="{Binding CancelFormCommand}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                     Text="{Binding FormError}"
                     IsVisible="{Binding FormError, Converter={x:Static conv:Converters.HasValue}}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Status.Danger}"
                     Classes="muted" />
        </Grid>
      </controls:GlassPanel>
    </StackPanel>

    <!-- ============ Row2：服务器列表（玻璃框内唯一滚动，票 #106） ============ -->
    <controls:GlassPanel Grid.Row="2" Padding="0">
      <Grid>
        <Grid RowDefinitions="Auto,*">

          <!-- 刷新进度：细条压在框顶，不占行高 -->
          <ProgressBar Grid.Row="0"
                       IsVisible="{Binding IsLoading}"
                       IsIndeterminate="True"
                       Height="2"
                       Margin="1,1,1,0" />

          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Grid>

              <ItemsControl ItemsSource="{Binding Servers}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ServerCardViewModel">
                    <Border Classes="serverrow" IsVisible="{Binding !IsFilteredOut}">
      <Border.ContextMenu>
      <ContextMenu>
      <MenuItem Header="加入服务器"
      Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).JoinServerCommand}"
      CommandParameter="{Binding}" />
      <MenuItem Header="刷新状态"
      Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).RefreshOneCommand}"
      CommandParameter="{Binding}" />
      <MenuItem Header="查询玩家名单"
      Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).QueryPlayersCommand}"
      CommandParameter="{Binding}" />
      <Separator />
      <MenuItem Header="编辑"
      Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).EditServerCommand}"
      CommandParameter="{Binding}" />
      <MenuItem Header="复制地址"
      Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).CopyAddressCommand}"
      CommandParameter="{Binding}" />
      </ContextMenu>
      </Border.ContextMenu>
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="8" VerticalAlignment="Center">

                        <!-- 主行：图标 / 名称+MOTD / 地址 180 / 人数延迟 120 / 状态 / 动作 -->
                        <Grid Grid.Row="0"
                              ColumnDefinitions="Auto,*,180,120,Auto,Auto"
                              ColumnSpacing="12">

                          <!-- 图标槽固定 32×32：有没有 favicon 都不改变行高与列宽 -->
                          <Border Width="32" Height="32"
                                  VerticalAlignment="Center"
                                  CornerRadius="{DynamicResource Radius.Sm}"
                                  ClipToBounds="True">
                            <Panel>
                              <Border Background="{DynamicResource Surface.Sunken}"
                                      BorderBrush="{DynamicResource Stroke.Subtle}"
                                      BorderThickness="1"
                                      IsVisible="{Binding !HasFavicon}">
                                <TextBlock Text="{Binding Initial}"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                              </Border>
                              <Image Source="{Binding Favicon}"
                                     Stretch="UniformToFill"
                                     IsVisible="{Binding HasFavicon}" />
                            </Panel>
                          </Border>

                          <!-- 名称 + MOTD：MOTD 单行截断，超长不换行（换行会把 72 撑破） -->
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <views:MotdBlock Motd="{Binding MotdRaw}"
                                             MaxLines="1"
                                             IsVisible="{Binding !HasError}"
                                             TextTrimming="CharacterEllipsis"
                                             FontSize="{DynamicResource FontSize.Small}" />
                            <TextBlock Text="{Binding ErrorText}"
                                       IsVisible="{Binding HasError}"
                                       Classes="caption"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Status.Warning}" />
                          </StackPanel>

                          <!-- 地址列固定 180 + 等宽：长地址截断，不挤掉右边的人数列 -->
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Address}"
                                     Classes="mono"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Address}"
                                     Foreground="{DynamicResource Text.Secondary}" />

                          <!-- 人数与延迟上下两行右对齐，固定 120 -->
                          <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center" Width="120">
                            <TextBlock Text="{Binding PlayerText}"
                                       Classes="mono"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right" />
                            <TextBlock Text="{Binding LatencyText}"
                                       Classes="mono"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource Text.Tertiary}" />
                          </StackPanel>

                          <!-- 状态：点 + 文字，不只靠颜色 -->
                          <StackPanel Grid.Column="4"
                                      Orientation="Horizontal"
                                      Spacing="6"
                                      VerticalAlignment="Center"
                                      MinWidth="72">
                            <Border Classes="statusDot"
                                    Classes.online="{Binding IsOnline}"
                                    Classes.timeout="{Binding IsTimeout}" />
                            <TextBlock Text="{Binding StatusText}"
                                       Classes="caption"
                                       VerticalAlignment="Center" />
                          </StackPanel>

                          <!-- 行内动作两位：加入（主）+ 删除。其余（刷新/查询玩家/复制地址/编辑）走右键菜单 -->
                          <StackPanel Grid.Column="5"
                                      Orientation="Horizontal"
                                      Spacing="4"
                                      VerticalAlignment="Center">
                            <Button Classes="accent"
                                    Classes.tglass="{Binding !IsOnline}"
                                    Content="加入"
                                    Padding="12,0"
                                    Height="30"
                                    MinHeight="30"
                                    FontSize="{DynamicResource FontSize.Small}"
                                    IsEnabled="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).IsJoining, Converter={x:Static conv:Converters.InverseBool}}"
                                    Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).JoinServerCommand}"
                                    CommandParameter="{Binding}" />

                            <Button Classes="icon small" ToolTip.Tip="删除"
                                    Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).DeleteServerCommand}"
                                    CommandParameter="{Binding}">
                              <Path Data="M5 7h14M9 7V5h6v2M7 7l1 13h8l1-13M10 11v5M14 11v5"
                                    Stroke="{DynamicResource Status.Danger}"
                                    StrokeThickness="1.6"
                                    StrokeLineCap="Round"
                                    StrokeJoin="Round"
                                    Stretch="Uniform"
                                    Width="14" Height="14" />
                            </Button>
                          </StackPanel>

                        </Grid>

                        <!-- 玩家名单：点右键「查询玩家名单」才查（GameSpy4 Query，UDP）。
                             Query 关闭时只给说明，不算错误。 -->
                        <Border Grid.Row="1"
                                Classes="sunken"
                                IsVisible="{Binding IsPlayersOpen}">
                          <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding PlayersHeaderText}"
                                         FontWeight="SemiBold"
                                         Classes="secondary"
                                         VerticalAlignment="Center" />
                              <TextBlock Text="Query · UDP"
                                         Classes="caption"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding PlayersHint}"
                                       IsVisible="{Binding PlayersHint, Converter={x:Static conv:Converters.HasValue}}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding PlayerNames}" IsVisible="{Binding HasPlayerList}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                  <Border Classes="badge" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 空态一：一台都没有 -->
              <Border IsVisible="{Binding IsEmpty}" Padding="24">
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Width="56" Height="56"
                          CornerRadius="{DynamicResource Radius.Xl}"
                          Background="{DynamicResource Surface.Sunken}"
                          HorizontalAlignment="Center">
                    <Path Data="M4 6h16v5H4zM4 13h16v5H4zM7.5 8.5h.01M7.5 15.5h.01"
                          Stroke="{DynamicResource Text.Tertiary}"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="Uniform"
                          Width="26" Height="26"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="还没有收藏服务器" Classes="h3" HorizontalAlignment="Center" />
                  <TextBlock Text="加一个地址，启动游戏时能直接连过去"
                             Classes="muted"
                             HorizontalAlignment="Center" />
                  <Button Classes="accent"
                          Content="添加服务器"
                          HorizontalAlignment="Center"
                          Command="{Binding OpenFormCommand}" />
                </StackPanel>
              </Border>

              <!-- 空态二：有收藏但没搜到 -->
              <Border IsVisible="{Binding IsFilterEmpty}" Padding="24">
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="没有匹配的服务器" Classes="h3" HorizontalAlignment="Center" />
                  <TextBlock Text="换个名字或地址再搜一次"
                             Classes="muted"
                             HorizontalAlignment="Center" />
                  <Button Classes="tglass"
                          Content="清空搜索"
                          HorizontalAlignment="Center"
                          Command="{Binding ClearKeywordCommand}" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
    </controls:GlassPanel>

    <!-- ============ Row3：结果条（导入 / 操作反馈，可关闭） ============ -->
    <Border Grid.Row="3"
            Height="44"
            Classes="feedback"
            IsVisible="{Binding HasInfo}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="14,0">
        <Path Grid.Column="0"
              Data="M20 6 9 17l-5-5"
              Stroke="{DynamicResource Status.Success}"
              StrokeThickness="1.8"
              StrokeLineCap="Round"
              StrokeJoin="Round"
              Stretch="Uniform"
              Width="14" Height="14"
              VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{Binding InfoText}"
                   Classes="secondary"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />

        <Button Grid.Column="2"
                Classes="icon small"
                ToolTip.Tip="关闭"
                Command="{Binding DismissInfoCommand}">
          <Path Data="M6 6l12 12M18 6L6 18"
                Stroke="{DynamicResource Text.Tertiary}"
                StrokeThickness="1.6"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Stretch="Uniform"
                Width="12" Height="12" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
