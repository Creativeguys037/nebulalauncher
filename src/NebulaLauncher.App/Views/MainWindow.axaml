<!-- 默认尺寸 1240×800 只是兜底：运行时由 MainWindow.axaml.cs 的 RestoreWindowState 按
     「截图参数 > settings.json 的 launcherWindow* > 这里的默认值」决定，设计器预览也用它。

     这里故意不写 MinWidth/MinHeight：最小尺寸由 MainWindow.axaml.cs 在首帧后按侧边栏实测的
     自然尺寸算出来（见 Core 的 AdaptiveWindowSize）。写死常量会让「往侧边栏加内容」的改动
     在窄屏上裁掉内容而不是把窗口撑高 —— 票 #51。

     布局取自已定版样张 .oil-ui/nebula-2/explore/home-glass.html：左侧是浮动的玻璃竖栏
     （宽 82 / 1024 下 68），不是整高实心侧栏；导航项图标在上、文字在下，设置贴栏底。 -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NebulaLauncher.ViewModels"
        xmlns:controls="using:NebulaLauncher.Controls"
        xmlns:conv="using:NebulaLauncher.Converters"
        x:Class="NebulaLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Nebula Launcher"
        Width="1240" Height="800"
        Background="{DynamicResource Surface.Base}"
        FontFamily="{DynamicResource Font.UI}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Panel>
    <!--
      背景层（票 #85）：主题渐变 + 三个硬边圆形色块，也是玻璃卡片的同源副本源。
      用户背景图与遮罩作为这一层的子元素，玻璃卡片复制整棵子树后仍然对齐。
      整个控件 IsHitTestVisible=false，不影响内容区点击。
    -->
    <Panel x:Name="BackdropRoot" IsHitTestVisible="False">
      <controls:GlassBackdrop Background="{DynamicResource Gradient.Canvas}"
                              Blob1="{DynamicResource Surface.BackdropBlob1}"
                              Blob2="{DynamicResource Surface.BackdropBlob2}"
                              Blob3="{DynamicResource Surface.BackdropBlob3}"
                              IsAnimated="{Binding BackgroundAnimationsActive}" />

      <Image Source="{Binding BackgroundImage}"
             IsVisible="{Binding HasBackgroundImage}"
             Stretch="UniformToFill"
             IsHitTestVisible="False"
             RenderOptions.BitmapInterpolationMode="HighQuality" />

      <Border IsVisible="{Binding HasBackgroundImage}"
              IsHitTestVisible="False"
              Background="{DynamicResource Surface.Base}"
              Opacity="{Binding BackgroundImageOverlay}" />
    </Panel>

    <!-- ==================== 舞台：左浮动竖栏 + 右主列 ==================== -->
    <Grid x:Name="Stage" ColumnDefinitions="82,*" Margin="18">

      <!-- ==================== 左侧玻璃竖栏 ====================
           样张 .rail：浮动玻璃底板、圆角 22（1024 档）、内容居中、设置贴栏底。 -->
      <Border Grid.Column="0"
              Name="Sidebar"
              Classes="glass"
              CornerRadius="{DynamicResource Radius.X2l}"
              Margin="0"
              AutomationProperties.Name="主导航"
              AutomationProperties.AutomationId="Navigation">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,16">

          <!-- 品牌块：样张里它是栏顶的实心渐变方块 -->
          <Border Grid.Row="0"
                  Width="40" Height="40"
                  Margin="0,0,0,12"
                  HorizontalAlignment="Center"
                  CornerRadius="{DynamicResource Radius.Md}"
                  Background="{DynamicResource Gradient.Accent}"
                  BoxShadow="{DynamicResource Shadow.Glow}">
            <TextBlock Text="N"
                       FontSize="{DynamicResource FontSize.Subtitle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Text.OnAccent}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>

          <!-- 导航：上组（启动/版本/内容/下载）→ 分隔线 → 账户 / 服务器 -->
          <StackPanel Grid.Row="1" Name="NavigationList" Spacing="2">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItem">
                  <Button Classes="nav"
                          Classes.active="{Binding IsActive}"
                          AutomationProperties.Name="{Binding Title}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                          CommandParameter="{Binding Key}">
                    <StackPanel Spacing="2">
                      <Path Data="{Binding IconKey, Converter={x:Static conv:Converters.IconKeyToGeometry}}" />
                      <TextBlock Text="{Binding Title}" Classes="nav-label" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1"
                    Width="30"
                    Margin="0,4"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Stroke.Subtle}" />

            <ItemsControl ItemsSource="{Binding SecondaryNavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItem">
                  <Button Classes="nav"
                          Classes.active="{Binding IsActive}"
                          AutomationProperties.Name="{Binding Title}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                          CommandParameter="{Binding Key}">
                    <StackPanel Spacing="2">
                      <Path Data="{Binding IconKey, Converter={x:Static conv:Converters.IconKeyToGeometry}}" />
                      <TextBlock Text="{Binding Title}" Classes="nav-label" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 设置贴栏底 -->
          <ItemsControl Grid.Row="2" ItemsSource="{Binding FooterNavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <Button Classes="nav"
                        Classes.active="{Binding IsActive}"
                        AutomationProperties.Name="{Binding Title}"
                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                        CommandParameter="{Binding Key}">
                  <StackPanel Spacing="2">
                    <Path Data="{Binding IconKey, Converter={x:Static conv:Converters.IconKeyToGeometry}}" />
                    <TextBlock Text="{Binding Title}" Classes="nav-label" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- ==================== 右侧主列 ==================== -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="18,0,0,0">

        <!-- 标题栏：窗口三键与页面抬头同在这一条上，拖动区随整条走 -->
        <Grid Grid.Row="0"
              Name="TitleBar"
              Height="46"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">
          <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      VerticalAlignment="Center"
                      Margin="4,0,140,0">
            <TextBlock Text="{Binding CurrentPage.Title}"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentPage.Subtitle}"
                       Classes="page-subtitle muted"
                       VerticalAlignment="Center"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!--
            窗口三键。图标尺寸 10px、键 33×29（1024 下 29×25），关闭键 hover 转危险色 + 白图标。
            Path 上不写内联 Stroke：本地值会压过 :pointerover 的样式 setter（PITFALLS 4.2）。
          -->
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="4">
            <Button Classes="window-btn"
                    Click="OnMinimizeClick"
                    ToolTip.Tip="最小化"
                    AutomationProperties.Name="最小化">
              <Path Data="{StaticResource Icon.WindowMinimize}"
                    StrokeThickness="1.1"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="Uniform"
                    Width="10" Height="10" />
            </Button>
            <Button Classes="window-btn"
                    Click="OnMaximizeClick"
                    ToolTip.Tip="最大化"
                    AutomationProperties.Name="最大化">
              <Path Data="{StaticResource Icon.WindowMaximize}"
                    StrokeThickness="1.1"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="Uniform"
                    Width="10" Height="10" />
            </Button>
            <Button Classes="window-btn close"
                    Click="OnCloseClick"
                    ToolTip.Tip="关闭"
                    AutomationProperties.Name="关闭">
              <Path Data="{StaticResource Icon.WindowClose}"
                    StrokeThickness="1.1"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Stretch="Uniform"
                    Width="10" Height="10" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 内容区：Main 地标 -->
        <Grid Grid.Row="1"
              RowDefinitions="*,Auto"
              AutomationProperties.Name="主内容"
              AutomationProperties.AutomationId="Main">

          <controls:PageHost Grid.Row="0"
                             Content="{Binding CurrentPage}"
                             Margin="4,0,0,0" />

          <Border Grid.Row="1"
                  Margin="4,0,0,12"
                  Padding="0,8,0,0"
                  BorderBrush="{DynamicResource Stroke.Subtle}"
                  BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusText}"
                         Classes="muted"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="Nebula Launcher"
                         Classes="muted"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ==================== 退出下载确认 ====================
         PCL2 的 FormMain.EndProgram 在还有下载任务时弹「还有下载任务尚未完成，是否确定退出？」。
         放在窗口级：它不属于任何页面，下载可能来自安装、模组更新或整合包导入。 -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsExitDownloadConfirmOpen}">
      <Border Classes="card"
              Width="420"
              Padding="20,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M12 3v12m0 4v.5M12 3l9 16H3z"
                  Stroke="{DynamicResource Status.Warning}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="17" Height="17"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Text="还有下载任务尚未完成" Classes="h3" />
          </StackPanel>

          <TextBlock Text="{Binding ExitDownloadConfirmText}"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="继续下载" Command="{Binding CancelExitWithDownloadsCommand}" />
            <Button Classes="danger" Content="仍然退出" Command="{Binding ConfirmExitWithDownloadsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
