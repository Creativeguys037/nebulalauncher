<!-- 默认尺寸 1240×800 只是兜底：运行时由 MainWindow.axaml.cs 的 RestoreWindowState 按
     「截图参数 > settings.json 的 launcherWindow* > 这里的默认值」决定，设计器预览也用它。

     这里故意不写 MinWidth/MinHeight：最小尺寸由 MainWindow.axaml.cs 在首帧后按侧边栏实测的
     自然尺寸算出来（见 Core 的 AdaptiveWindowSize）。写死常量会让「往侧边栏加内容」的改动
     在窄屏上裁掉内容而不是把窗口撑高 —— 票 #51。 -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NebulaLauncher.ViewModels"
        xmlns:controls="using:NebulaLauncher.Controls"
        xmlns:conv="using:NebulaLauncher.Converters"
        xmlns:services="using:NebulaLauncher.Services"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="NebulaLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Nebula Launcher"
        Width="1240" Height="800"
        Background="{DynamicResource Surface.Base}"
        FontFamily="{DynamicResource Font.UI}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <!--
      一级导航项（票 #85）：44 高 / 胶囊选中；1024 下 40 高、图标 18。
      这里不写颜色或时长字面量：全部取令牌，动效时长取 Motion 静态词表。
    -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="12,2" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border primitives:AdornerLayer.IsClipEnabled="False"
                  Margin="-3"
                  BorderBrush="{DynamicResource Stroke.Focus}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource Radius.Pill}"
                  IsHitTestVisible="False" />
        </FocusAdornerTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
          <BrushTransition Property="Foreground" Duration="{x:Static services:Motion.Fast}" />
          <DoubleTransition Property="Opacity" Duration="{x:Static services:Motion.Instant}" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.nav Path">
      <Setter Property="Stroke" Value="{DynamicResource Text.Tertiary}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.NavHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style Selector="Button.nav:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.nav.active Path">
      <Setter Property="Stroke" Value="{DynamicResource Text.OnAccent}" />
    </Style>

    <Style Selector="Button.nav.active:pointerover">
      <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>

    <!-- 选中态辉光落在模板内的底板上；导航胶囊是唯一需要 glow 的导航元素。 -->
    <Style Selector="Button.nav.active /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glow}" />
    </Style>

    <!-- 页面抬头：字号在样式里给，1024 下由 compact 覆盖；不要写成内联值，否则样式优先级压不过。 -->
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <!-- 1024×660：侧栏 176、项高 40、图标 18、窗口三键 29×25、标题 26。 -->
    <Style Selector="Window.compact Button.nav">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="12,1" />
    </Style>

    <Style Selector="Window.compact Button.nav Path">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="Window.compact Button.window-btn">
      <Setter Property="Width" Value="29" />
      <Setter Property="Height" Value="25" />
      <Setter Property="MinHeight" Value="25" />
    </Style>

    <Style Selector="Window.compact TextBlock.page-title">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Headline}" />
    </Style>
  </Window.Styles>

  <Panel>
    <!--
      背景层（票 #85）：主题渐变 + 三个硬边圆形色块，也是玻璃卡片的同源副本源。
      用户背景图与遮罩作为这一层的子元素，玻璃卡片复制整棵子树后仍然对齐。
      整个控件 IsHitTestVisible=false，不影响内容区点击。
    -->
    <Panel x:Name="BackdropRoot">
      <controls:GlassBackdrop Background="{DynamicResource Gradient.Canvas}"
                              Blob1="{DynamicResource Surface.BackdropBlob1}"
                              Blob2="{DynamicResource Surface.BackdropBlob2}"
                              Blob3="{DynamicResource Surface.BackdropBlob3}"
                              IsAnimated="{Binding BackgroundAnimationsActive}" />

      <Image Source="{Binding BackgroundImage}"
             IsVisible="{Binding HasBackgroundImage}"
             Stretch="UniformToFill"
             IsHitTestVisible="False"
             RenderOptions.BitmapInterpolationMode="HighQuality" />

      <Border IsVisible="{Binding HasBackgroundImage}"
              IsHitTestVisible="False"
              Background="{DynamicResource Surface.Base}"
              Opacity="{Binding BackgroundImageOverlay}" />
    </Panel>

    <Grid RowDefinitions="46,*">

      <!-- ==================== 标题栏 ==================== -->
      <Grid Grid.Row="0"
            Name="TitleBar"
            Background="Transparent"
            PointerPressed="OnTitleBarPointerPressed">
        <StackPanel Orientation="Horizontal"
                    Margin="18,0,0,0"
                    Spacing="9"
                    VerticalAlignment="Center">
          <Border Width="20" Height="20"
                  CornerRadius="{DynamicResource Radius.Sm}"
                  Background="{DynamicResource Gradient.Accent}">
            <TextBlock Text="N"
                       FontSize="{DynamicResource FontSize.Caption}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Text.OnAccent}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Nebula Launcher"
                     FontSize="{DynamicResource FontSize.Small}"
                     Foreground="{DynamicResource Text.Tertiary}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Spacing="2">
          <Button Classes="window-btn"
                  Click="OnMinimizeClick"
                  ToolTip.Tip="最小化"
                  AutomationProperties.Name="最小化">
            <Path Data="{StaticResource Icon.WindowMinimize}"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.1"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="10" Height="10" />
          </Button>
          <Button Classes="window-btn"
                  Click="OnMaximizeClick"
                  ToolTip.Tip="最大化"
                  AutomationProperties.Name="最大化">
            <Path Data="{StaticResource Icon.WindowMaximize}"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.1"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="10" Height="10" />
          </Button>
          <Button Classes="window-btn close"
                  Click="OnCloseClick"
                  ToolTip.Tip="关闭"
                  AutomationProperties.Name="关闭">
            <Path Data="{StaticResource Icon.WindowClose}"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.1"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- ==================== 主体 ==================== -->
      <Grid Grid.Row="1" Name="BodyGrid" ColumnDefinitions="200,*">

        <!-- 侧边栏：7 个一级入口；不放皮肤卡、统计块或滚动区。 -->
        <Border Grid.Column="0"
                Name="Sidebar"
                AutomationProperties.Name="主导航"
                AutomationProperties.AutomationId="Navigation"
                Background="{DynamicResource Surface.Sidebar}"
                BorderBrush="{DynamicResource Stroke.Subtle}"
                BorderThickness="0,1,1,0">
          <ItemsControl Name="NavigationList"
                        ItemsSource="{Binding NavigationItems}"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <Button Classes="nav"
                        Classes.active="{Binding IsActive}"
                        AutomationProperties.Name="{Binding Title}"
                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                        CommandParameter="{Binding Key}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Path Data="{Binding IconKey, Converter={x:Static conv:Converters.IconKeyToGeometry}}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto"
              AutomationProperties.Name="主内容"
              AutomationProperties.AutomationId="Main">

          <!-- 页面抬头：标题与副标题由外壳统一渲染，页面内不重复画。 -->
          <Grid Grid.Row="0" Margin="30,20,30,4" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0"
                       Text="{Binding CurrentPage.Title}"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentPage.Subtitle}"
                       Classes="page-subtitle muted"
                       VerticalAlignment="Center"
                       Margin="12,4,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>

          <!-- 页面宿主：切换内容时只做 220ms 淡入，不做整页位移。 -->
          <controls:PageHost Grid.Row="1"
                             Content="{Binding CurrentPage}"
                             Margin="30,10,30,0" />

          <!-- 状态栏 -->
          <Border Grid.Row="2"
                  Margin="30,0,30,14"
                  Padding="0,8,0,0"
                  BorderBrush="{DynamicResource Stroke.Subtle}"
                  BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusText}"
                         Classes="muted"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="Nebula Launcher"
                         Classes="muted"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ==================== 退出下载确认 ====================
         PCL2 的 FormMain.EndProgram 在还有下载任务时弹「还有下载任务尚未完成，是否确定退出？」。
         放在窗口级：它不属于任何页面，下载可能来自安装、模组更新或整合包导入。 -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsExitDownloadConfirmOpen}">
      <Border Classes="card"
              Width="420"
              Padding="20,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M12 3v12m0 4v.5M12 3l9 16H3z"
                  Stroke="{DynamicResource Status.Warning}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="17" Height="17"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Text="还有下载任务尚未完成" Classes="h3" />
          </StackPanel>

          <TextBlock Text="{Binding ExitDownloadConfirmText}"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="继续下载" Command="{Binding CancelExitWithDownloadsCommand}" />
            <Button Classes="danger" Content="仍然退出" Command="{Binding ConfirmExitWithDownloadsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
