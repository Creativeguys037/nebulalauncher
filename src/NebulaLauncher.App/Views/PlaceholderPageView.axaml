<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             x:Class="NebulaLauncher.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
  <Border Classes="card" VerticalAlignment="Top">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding Title}" Classes="h3" />
      <TextBlock Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
