<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:conv="using:NebulaLauncher.Converters"
             xmlns:models="using:NebulaLauncher.Core.Models"
             xmlns:controls="using:NebulaLauncher.Controls"
             xmlns:services="using:NebulaLauncher.Services"
             x:Class="NebulaLauncher.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

  <!--
    账户页（票 #94）：四行栅格。Row0 身份卡 / Row1 提示与设备码（可隐藏）/ Row2 账户列表 /
    Row3 离线账户。根是 Grid，滚动只在 Row2 的玻璃框内。
  -->

  <UserControl.Styles>
    <!-- 头像首字母：渐变底之上、皮肤图片之下的兜底层 -->
    <Style Selector="TextBlock.avatarLetter">
      <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 账户行：72 高，圆角 12，左侧 3px 主色条表示当前 -->
    <Style Selector="Border.acctrow">
      <Setter Property="Height" Value="72" />
      <Setter Property="Padding" Value="0,0,12,0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
          <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.acctrow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>

    <!--
      当前账户靠左侧 3px 主色条 + 1px 主色边 + 略亮的底来区分，不铺整片主色软底：
      深色下 Accent.Soft 是 12% 红，铺满 1100×72 就是一大块红，违反 §7.1「红色不当大面积背景」。
    -->
    <Style Selector="Border.acctrow.active">
      <Setter Property="Background" Value="{DynamicResource Surface.NavHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    </Style>

    <!-- 行内图标按钮：不抢账户名，hover 才提亮 -->
    <Style Selector="Button.rowicon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

    <!--
      Row0 是一个 StackPanel：账户卡固定 120，提示条与设备码卡挂在它下面。
      合并而不是各占一行，是因为 RowSpacing 固定 12，隐藏的行仍占间隔——
      设备码收起时四行会给列表白留 12px 空洞，而 §3.1 要求收起态 Row2 = 437 / 297。
    -->
    <StackPanel Grid.Row="0" Spacing="12">

    <!-- == Row0：当前账户身份卡（120 高，固定不滚）== -->
    <controls:GlassPanel Height="120" Padding="0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="20,0">

        <Border Grid.Column="0" Width="56" Height="56"
                CornerRadius="{DynamicResource Radius.Md}"
                ClipToBounds="True"
                VerticalAlignment="Center"
                ToolTip.Tip="右键刷新头像">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="刷新头像" Command="{Binding RefreshActiveAvatarCommand}" />
            </ContextMenu>
          </Border.ContextMenu>
          <Panel>
            <Border CornerRadius="{DynamicResource Radius.Md}"
                    Background="{DynamicResource Gradient.Accent}"
                    IsVisible="{Binding !ActiveUseAurora}" />
            <Border CornerRadius="{DynamicResource Radius.Md}"
                    Background="{DynamicResource Gradient.Aurora}"
                    IsVisible="{Binding ActiveUseAurora}" />
            <!-- 皮肤没取到时首字母兜底；皮肤头部不透明，取到即盖住 -->
            <TextBlock Text="{Binding ActiveInitial}"
                       Classes="avatarLetter"
                       FontSize="{DynamicResource FontSize.Title}" />
            <controls:SkinAvatar Source="{Binding ActiveAvatar}" />
          </Panel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding ActiveName}" Classes="h3" />
            <Border Classes="badge" IsVisible="{Binding HasActiveAccount}" VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveTypeLabel}" />
            </Border>
            <Border Classes="badge warning" IsVisible="{Binding ActiveExpired}" VerticalAlignment="Center">
              <TextBlock Text="令牌过期" />
            </Border>
          </StackPanel>

          <TextBlock Text="{Binding ActiveExpiryText}"
                     Classes="muted"
                     TextWrapping="Wrap"
                     MaxWidth="560" />

          <TextBlock Text="{Binding ActiveDetail}"
                     Classes="mono"
                     Foreground="{DynamicResource Text.Tertiary}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost"
                  Content="刷新令牌"
                  IsVisible="{Binding CanRefreshToken}"
                  Command="{Binding RefreshTokenCommand}" />
          <Button Classes="ghost"
                  Content="刷新列表"
                  Command="{Binding RefreshCommand}" />
          <!-- 一屏一个主行动：未登录时才出实心主色；已登录用 ghost，令牌过期也是登录这个动作 -->
          <Button Classes="accent"
                  Content="使用微软账户登录"
                  IsVisible="{Binding !HasActiveAccount}"
                  Command="{Binding SignInMicrosoftCommand}" />
          <Button Classes="tglass"
                  Content="切换账户"
                  IsVisible="{Binding HasActiveAccount}"
                  Command="{Binding SignInMicrosoftCommand}" />
        </StackPanel>
      </Grid>
    </controls:GlassPanel>

    <!-- == 提示条与设备码登录（都隐藏时不占高）== -->
    <StackPanel Spacing="8">

      <Border IsVisible="{Binding IsDemoMode}"
              Background="{DynamicResource Status.Warning.Soft}"
              BorderBrush="{DynamicResource Status.Warning}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Md}"
              Padding="14,10">
        <TextBlock Text="示例数据 · Core 服务尚未接线，以下账户不会真正登录，设备码流程也不可用"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Warning}" />
      </Border>

      <Border IsVisible="{Binding HasError}"
              Background="{DynamicResource Status.Danger.Soft}"
              BorderBrush="{DynamicResource Status.Danger}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Md}"
              Padding="14,10">
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Danger}" />
      </Border>

      <Border IsVisible="{Binding HasInfo}"
              Background="{DynamicResource Accent.Soft}"
              BorderBrush="{DynamicResource Stroke.Default}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Md}"
              Padding="14,10">
        <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" Classes="secondary" />
      </Border>

      <!-- 移除确认：危险动作就地确认，不弹窗 -->
      <Border IsVisible="{Binding HasPendingRemoval}"
              Background="{DynamicResource Status.Danger.Soft}"
              BorderBrush="{DynamicResource Status.Danger}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Md}"
              Padding="14,10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="确定移除这个账户吗？" FontWeight="SemiBold"
                       Foreground="{DynamicResource Status.Danger}" />
            <TextBlock Text="{Binding PendingRemoval.Username}" Classes="muted" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="danger" Content="移除" Command="{Binding ConfirmRemoveCommand}" />
            <Button Classes="ghost" Content="取消" Command="{Binding CancelRemoveCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 设备码登录：只在登录流程进行中展开，已登录态整块隐藏 -->
      <controls:GlassPanel IsVisible="{Binding IsSigningIn}" Padding="20">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="6">
            <TextBlock Text="在浏览器里输入下面的代码完成登录" Classes="muted" />
            <TextBlock Text="{Binding DeviceCode}"
                       FontSize="{DynamicResource FontSize.Display}"
                       FontWeight="SemiBold"
                       FontFamily="{DynamicResource Font.Mono}" />
            <TextBlock Text="{Binding VerificationUri}"
                       Classes="mono"
                       Foreground="{DynamicResource Text.Tertiary}"
                       IsVisible="{Binding HasDeviceCode}" />
            <TextBlock Text="{Binding AuthStage}" Classes="muted" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <Button Classes="pill"
                    Content="复制验证码"
                    IsVisible="{Binding HasDeviceCode}"
                    Command="{Binding CopyDeviceCodeCommand}" />
            <Button Classes="pill"
                    Content="打开浏览器"
                    IsVisible="{Binding HasDeviceCode}"
                    Command="{Binding OpenVerificationUriCommand}" />
            <Button Classes="ghost"
                    Content="取消登录"
                    Command="{Binding CancelSignInCommand}" />
          </StackPanel>
        </Grid>
      </controls:GlassPanel>
    </StackPanel>
    </StackPanel>

    <!-- == Row1：所有账户列表（框内唯一滚动）== -->
    <controls:GlassPanel Grid.Row="1" Padding="0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasAccounts}">
          <ItemsControl ItemsSource="{Binding Accounts}" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountRowViewModel">
                <Border Classes="acctrow" Classes.active="{Binding IsActive}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12">

                    <!-- 当前账户：左侧 3px 主色条，比整行变色更耐看 -->
                    <Border Grid.Column="0"
                            Width="3" Height="40"
                            CornerRadius="{DynamicResource Radius.Pill}"
                            Background="{DynamicResource Accent.Primary}"
                            IsVisible="{Binding IsActive}"
                            VerticalAlignment="Center" />

                    <Border Grid.Column="1" Width="40" Height="40"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                      <Panel>
                        <Border CornerRadius="{DynamicResource Radius.Sm}"
                                Background="{DynamicResource Gradient.Accent}"
                                IsVisible="{Binding !UseAurora}" />
                        <Border CornerRadius="{DynamicResource Radius.Sm}"
                                Background="{DynamicResource Gradient.Aurora}"
                                IsVisible="{Binding UseAurora}" />
                        <TextBlock Text="{Binding Initial}"
                                   Classes="avatarLetter"
                                   FontSize="{DynamicResource FontSize.Subtitle}" />
                        <controls:SkinAvatar Source="{Binding Avatar}" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Username}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding TypeLabel}"
                                 Classes="muted"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="{Binding LastLoginText}"
                               Classes="mono"
                               Foreground="{DynamicResource Text.Tertiary}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Border Classes="badge" IsVisible="{Binding IsActive}">
                        <TextBlock Text="当前" />
                      </Border>
                      <Border Classes="badge warning" IsVisible="{Binding IsExpired}">
                        <TextBlock Text="令牌过期" />
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                      <Button Classes="rowicon"
                              IsVisible="{Binding !IsActive}"
                              ToolTip.Tip="设为当前"
                              Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).SwitchAccountCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="{StaticResource Icon.Check}"
                              Stroke="{DynamicResource Text.Tertiary}"
                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                              Stretch="Uniform" Width="14" Height="14" />
                      </Button>
                      <Button Classes="rowicon"
                              ToolTip.Tip="移除"
                              Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).RequestRemoveCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="{StaticResource Icon.Trash}"
                              Stroke="{DynamicResource Text.Tertiary}"
                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                              Stretch="Uniform" Width="14" Height="14" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 加载态：契约 §8 骨架 4 行，行高=真实行高（acctrow 72 + 行间距 4） -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    Margin="8"
                    Spacing="4">
          <Border Classes="listrow" Height="72" Background="{DynamicResource Surface.Hover}" />
          <Border Classes="listrow" Height="72" Background="{DynamicResource Surface.Hover}" />
          <Border Classes="listrow" Height="72" Background="{DynamicResource Surface.Hover}" />
          <Border Classes="listrow" Height="72" Background="{DynamicResource Surface.Hover}" />
        </StackPanel>

        <!-- 空态：给下一步动作，不留白屏 -->
        <StackPanel IsVisible="{Binding ShowAccountsEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <Border Width="56" Height="56"
                  CornerRadius="{DynamicResource Radius.Pill}"
                  Background="{DynamicResource Surface.Sunken}"
                  HorizontalAlignment="Center">
            <Path Data="{StaticResource Icon.Account}"
                  Stroke="{DynamicResource Text.Tertiary}"
                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Stretch="Uniform" Width="24" Height="24"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="还没有账户" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="用微软账户登录，或在下面添加一个离线账户"
                     Classes="muted"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </controls:GlassPanel>

    <!-- == Row3：离线账户（96 高，固定不滚）== -->
    <!-- == Row2：离线账户（固定 96）== -->
    <controls:GlassPanel Grid.Row="2" Height="96" Padding="0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="20,0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="离线账户" Classes="h3" />
          <TextBlock Text="仅保存在本机，无网络时也能启动游戏；不可用于正版服务器"
                     Classes="muted" />
          <TextBlock Text="{Binding OfflineNameError}"
                     FontSize="{DynamicResource FontSize.Small}"
                     Foreground="{DynamicResource Status.Danger}"
                     IsVisible="{Binding OfflineNameError, Converter={x:Static conv:Converters.HasValue}}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox Text="{Binding OfflineName}"
                   Watermark="账户名"
                   Width="180" />
          <Button Classes="tglass"
                  Content="添加离线账户"
                  Command="{Binding AddOfflineCommand}" />
        </StackPanel>
      </Grid>
    </controls:GlassPanel>

    <!-- ============ 第三方验证表单（浮层） ============ -->
    <Panel IsVisible="{Binding IsAuthlibFormOpen}">
      <!-- 遮罩单独一层：Opacity 放在 Panel 上会把表单卡片一起变透明 -->
      <Border Background="{DynamicResource Surface.Base}" Opacity="0.78" />

      <Border Classes="card"
              MaxWidth="560"
              MaxHeight="640"
              Margin="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">

            <StackPanel Spacing="4">
              <TextBlock Text="第三方验证登录" Classes="h3" />
              <TextBlock Text="地址取自皮肤站文档，通常以 /api/yggdrasil 结尾。登录成功后启动游戏会自动注入 authlib-injector。"
                         Classes="muted"
                         TextWrapping="Wrap"
                         LineHeight="18" />
            </StackPanel>

            <StackPanel Spacing="14" IsVisible="{Binding !IsChoosingAuthlibProfile}" IsEnabled="{Binding !IsAuthlibBusy}">
            <StackPanel Spacing="6">
              <TextBlock Text="常用服务商" Classes="fieldLabel" />
              <ItemsControl ItemsSource="{Binding AuthlibPresets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AuthlibPreset">
                    <Button Classes="pill"
                            Content="{Binding Name}"
                            ToolTip.Tip="{Binding ApiRoot}"
                            Margin="0,0,8,8"
                            Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).UseAuthlibPresetCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="API 根" Classes="fieldLabel" />
              <TextBox Text="{Binding AuthlibApiRoot}"
                       Watermark="例如 https://littleskin.cn/api/yggdrasil" />
              <TextBlock Text="要带上皮肤站文档里的完整路径，不要只填域名。"
                         Classes="caption"
                         TextWrapping="Wrap"
                         IsVisible="{Binding !HasAuthlibApiRootError}" />
              <TextBlock Text="{Binding AuthlibApiRootError}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Status.Danger}"
                         IsVisible="{Binding HasAuthlibApiRootError}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="用户名" Classes="fieldLabel" />
              <TextBox Text="{Binding AuthlibUsername}"
                       Watermark="皮肤站邮箱或角色名" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="密码" Classes="fieldLabel" />
              <TextBox Text="{Binding AuthlibPassword}"
                       PasswordChar="●"
                       Watermark="只用于本次登录，不写入日志" />
            </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding IsChoosingAuthlibProfile}">
              <TextBlock Text="选择游戏角色" Classes="fieldLabel" />
              <TextBlock Text="此账号拥有多个角色。选定角色后完成登录；取消不会添加账户。"
                         Classes="muted" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding AuthlibProfiles}"
                       SelectedItem="{Binding SelectedAuthlibProfile}"
                       MaxHeight="260"
                       IsEnabled="{Binding !IsAuthlibBusy}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:AuthlibProfileOption">
                    <StackPanel Spacing="4" Margin="4,6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Id}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <Border IsVisible="{Binding HasAuthlibError}"
                    Background="{DynamicResource Status.Danger.Soft}"
                    BorderBrush="{DynamicResource Status.Danger}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Sm}"
                    Padding="12,8">
              <TextBlock Text="{Binding AuthlibError}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Status.Danger}"
                         FontSize="{DynamicResource FontSize.Small}" />
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         IsVisible="{Binding IsAuthlibBusy}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="ghost"
                      Content="取消"
                      Command="{Binding CancelAuthlibFormCommand}" />
              <Button Classes="accent"
                      Content="登录并添加"
                      IsVisible="{Binding !IsChoosingAuthlibProfile}"
                      Command="{Binding SubmitAuthlibCommand}" />
              <Button Classes="accent"
                      Content="使用此角色"
                      IsVisible="{Binding IsChoosingAuthlibProfile}"
                      Command="{Binding ConfirmAuthlibProfileCommand}" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Panel>

  </Grid>
</UserControl>


