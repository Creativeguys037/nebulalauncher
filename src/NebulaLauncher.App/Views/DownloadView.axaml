<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:dl="using:NebulaLauncher.Core.Downloads"
             xmlns:controls="using:NebulaLauncher.Controls"
             xmlns:conv="using:NebulaLauncher.Converters"
             x:Class="NebulaLauncher.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">

  <!-- 下载页（票 #93）：任务队列，不是安装器。
       安装入口在版本页（可下载视图），这里只回答「现在有什么在跑、进度多少、能不能管」。

       布局照 downloads-glass.html：
       Row0 概览条 40 / Row1 参数栏 48（可折叠）/ Row2 任务框 * / Row3 结果条 44。
       RowSpacing 固定 12：行隐藏后间隔仍占位，Row2 高度按「画布 − 40 − 48 − 44 − 36」算，
       参数栏折叠时它多出 48（票面勘误：折叠 557 / 展开 509，不是 565）。 -->

  <UserControl.Styles>
    <!-- 任务行：64 高 / 间距 4。行内不能 accent 实心（UI-STRUCTURE §6 规则 3）。 -->
    <Style Selector="Border.taskrow">
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="Border.taskrow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>

    <!-- 等宽数字列：48 / 96 / 72 三档不缩窄（票面结构约束 1）。 -->
    <Style Selector="TextBlock.num">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style Selector="ListBoxItem.taskitem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="ListBoxItem.taskitem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

    <!-- Row0：概览条。左三组数字右对齐，右端一个主操作（全部暂停 / 全部继续）。 -->
    <controls:GlassPanel Grid.Row="0"
                         Height="40"
                         Padding="16,0">
      <!-- 六个格子：标签 + 值成对，值用固定宽（48/96/72）保证换值时不跳动。 -->
      <Grid ColumnDefinitions="Auto,8,Auto,24,Auto,8,Auto,16,Auto,8,Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Text="活跃"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Tertiary}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="2"
                   Text="{Binding ActiveTasksText}"
                   Classes="num"
                   Width="48"
                   HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Primary}" />

        <TextBlock Grid.Column="4"
                   Text="总速度"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Tertiary}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="6"
                   Text="{Binding TotalSpeedText}"
                   Classes="num"
                   Width="96"
                   HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Primary}" />

        <TextBlock Grid.Column="8"
                   Text="剩余"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Tertiary}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="10"
                   Text="{Binding RemainingText}"
                   Classes="num"
                   Width="72"
                   HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Primary}" />

        <Button Grid.Column="12"
                Content="{Binding PauseAllText}"
                Command="{Binding TogglePauseCommand}"
                Classes="ghost pill"
                Height="28" />
      </Grid>
    </controls:GlassPanel>

    <!-- 错误条：Row1 右侧，高 32/圆角 8/宽度 ≤ Row1 一半（契约 §8） -->
    <Border Grid.Row="1"
            IsVisible="{Binding ErrorText, Converter={x:Static conv:Converters.HasValue}}"
            Height="32"
            CornerRadius="{DynamicResource Radius.Sm}"
            Background="{DynamicResource Status.Danger.Soft}"
            BorderBrush="{DynamicResource Status.Danger}"
            BorderThickness="1"
            Padding="12,0"
            VerticalAlignment="Top"
            MaxWidth="400"
            HorizontalAlignment="Right">
      <TextBlock Text="{Binding ErrorText}"
                 FontSize="{DynamicResource FontSize.Caption}"
                 Foreground="{DynamicResource Status.Danger}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Row1：参数栏。默认收起为 0 高（票面结构树：折叠态 Row2 多 48）。
         展开时一行：下载源 + 并发 + 限速。三个值都是只读展示，改设置去设置页——
         下载页里的可编辑参数是这次重制前的旧形态，常驻 300 宽在 1024 档下是纯损失。
         只出错误条时也借用这一行（契约 §8：错误条在 Row1 右侧，不新增行、行高不变）。 -->
    <Border Grid.Row="1"
            IsVisible="{Binding ShowParamsRow}"
            Height="48"
            Classes="sunken"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center" ColumnSpacing="16">
        <TextBlock Grid.Column="0"
                   Text="{Binding SourceStatusText}"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Secondary}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Column="1"
                   Text="{Binding ConcurrencyText}"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Secondary}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="2"
                   Text="{Binding SpeedLimitText}"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Secondary}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!-- 页面级错误条（契约 §8：Row1 右侧，高 32 / 圆角 8 / 宽 ≤ Row1 一半） -->
        <Border Grid.Column="3"
                Height="32"
                MaxWidth="380"
                CornerRadius="{DynamicResource Radius.Sm}"
                Background="{DynamicResource Surface.Sunken}"
                BorderBrush="{DynamicResource Status.Danger}"
                BorderThickness="1"
                Padding="10,0"
                VerticalAlignment="Center"
                IsVisible="{Binding ErrorText, Converter={x:Static conv:Converters.HasValue}}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" Classes="badge danger" VerticalAlignment="Center">
              <TextBlock Text="错误" />
            </Border>
            <TextBlock Grid.Column="1"
                       Classes="caption"
                       Text="{Binding ErrorText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ErrorText}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="ghost"
                      Height="24"
                      Padding="10,0"
                      Content="重试"
                      Command="{Binding RefreshRemoteCommand}"
                      CommandParameter="{x:True}" />
              <Button Classes="icon"
                      Width="22" Height="22"
                      ToolTip.Tip="关闭"
                      Command="{Binding DismissErrorCommand}">
                <Path Data="{StaticResource Icon.Close}"
                      Stroke="{DynamicResource Text.Tertiary}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      Stretch="Uniform"
                      Width="11" Height="11" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Button Grid.Column="4"
                Content="收起参数"
                Command="{Binding ToggleParamsCommand}"
                Classes="ghost"
                Height="28"
                IsVisible="{Binding IsParamsExpanded}" />
      </Grid>
    </Border>

    <!-- Row2：任务框。玻璃框内唯一滚动（UI-STRUCTURE §7）。 -->
    <controls:GlassPanel Grid.Row="2" Padding="0">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- 加载态：契约 §8 骨架 4 行，行高=真实行高（taskrow 64 + 行间距 4）。 -->
        <StackPanel Grid.Row="0"
                    Spacing="0"
                    Margin="8"
                    IsVisible="{Binding IsLoading}">
          <Border Classes="taskrow" Height="64" Background="{DynamicResource Surface.Hover}" />
          <Border Classes="taskrow" Height="64" Background="{DynamicResource Surface.Hover}" />
          <Border Classes="taskrow" Height="64" Background="{DynamicResource Surface.Hover}" />
          <Border Classes="taskrow" Height="64" Background="{DynamicResource Surface.Hover}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasLauncherTasks}">
          <ItemsControl ItemsSource="{Binding LauncherTasks}" Margin="8,8,8,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dl:LauncherTaskInfo">
                <Border Classes="taskrow">
                  <Grid ColumnDefinitions="Auto,*,190,48,96,72,Auto" ColumnSpacing="12">

                    <!-- 图标：按任务类型区分语义。 -->
                    <Border Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Surface.Sunken}"
                            VerticalAlignment="Center">
                      <Path Data="{StaticResource Icon.Download}"
                            Stroke="{DynamicResource Text.Tertiary}"
                            StrokeThickness="1.8"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            Stretch="Uniform"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}"
                                 Classes="secondary"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}"
                                 Classes="caption"
                                 Foreground="{DynamicResource Text.Tertiary}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ProgressBar Grid.Column="2"
                                 Value="{Binding ProgressRatio}"
                                 Minimum="0"
                                 Maximum="1"
                                 Height="6"
                                 VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Classes="num" />
                    <TextBlock Grid.Column="4" Text="{Binding SpeedText}" Classes="num" />
                    <TextBlock Grid.Column="5" Text="{Binding EtaText}" Classes="num" />

                    <!-- 行内动作 ≤3 个、禁止 accent 实心（UI-STRUCTURE §6 规则 3）；取消比状态字更需要露出。 -->
                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateText}"
                                 Classes="caption"
                                 Foreground="{DynamicResource Text.Muted}"
                                 VerticalAlignment="Center"
                                 MinWidth="40" />
                      <Button Classes="icon"
                              Width="24"
                              Height="24"
                              IsVisible="{Binding HasTargetPath}"
                              ToolTip.Tip="打开所在目录"
                              Command="{Binding $parent[ItemsControl].((vm:DownloadViewModel)DataContext).OpenTaskTargetCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="{StaticResource Icon.Folder}"
                              Stroke="{DynamicResource Text.Tertiary}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="Uniform"
                              Width="12"
                              Height="12" />
                      </Button>
                      <Button Classes="icon"
                              Width="24"
                              Height="24"
                              IsVisible="{Binding IsActive}"
                              ToolTip.Tip="取消任务"
                              Command="{Binding $parent[ItemsControl].((vm:DownloadViewModel)DataContext).CancelTaskCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="{StaticResource Icon.Close}"
                              Stroke="{DynamicResource Text.Tertiary}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="Uniform"
                              Width="12"
                              Height="12" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 空态：必须给下一步动作，不留白屏（UI-STRUCTURE §6 规则 9）。 -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding ShowTasksEmpty}">
          <Border Width="56"
                  Height="56"
                  CornerRadius="{DynamicResource Radius.Pill}"
                  Background="{DynamicResource Surface.Sunken}"
                  HorizontalAlignment="Center">
            <Path Data="{StaticResource Icon.Download}"
                  Stroke="{DynamicResource Text.Muted}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="24"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="当前没有下载任务"
                     Classes="secondary"
                     Foreground="{DynamicResource Text.Secondary}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="在版本页安装游戏、在内容页下载资源，进度会出现在这里"
                     Classes="caption"
                     Foreground="{DynamicResource Text.Tertiary}"
                     HorizontalAlignment="Center" />
          <Button Content="去版本页安装"
                  Command="{Binding GoToVersionsCommand}"
                  Classes="ghost"
                  HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 参数栏收起时，框内右下角给一个展开入口。空态时不显示，避免孤悬。 -->
        <Button Grid.Row="1"
                Content="下载参数"
                Command="{Binding ToggleParamsCommand}"
                Classes="ghost"
                Height="28"
                Margin="0,4,12,12"
                HorizontalAlignment="Right"
                IsVisible="{Binding HasLauncherTasks}" />
      </Grid>
    </controls:GlassPanel>

    <!-- Row3：结果条。失败汇总 + 重试入口；无失败时 0 高。 -->
    <Border Grid.Row="3"
            Height="44"
            Classes="feedback"
            Padding="16,0"
            IsVisible="{Binding HasFailures}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Text="{Binding FailedBadgeText}"
                   Classes="caption"
                   Foreground="{DynamicResource Status.Danger}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{Binding RetryNote}"
                   Classes="caption"
                   Foreground="{DynamicResource Text.Secondary}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="2"
                Content="全部重试"
                Command="{Binding RetryFailedCommand}"
                Classes="accent"
                Height="28" />

        <Button Grid.Column="3"
                Content="✕"
                Classes="icon"
                Width="28"
                Height="28"
                Command="{Binding ClearFailuresCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>