<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:conv="using:NebulaLauncher.Converters"
             xmlns:controls="using:NebulaLauncher.Controls"
             xmlns:models="using:NebulaLauncher.Core.Models"
             xmlns:views="using:NebulaLauncher.Views"
             xmlns:sys="using:System"
             x:Class="NebulaLauncher.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">

  <UserControl.Styles>
    <!-- 列表项本身当容器，外观全部交给里面的 Border.card。 -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.pill.active">
      <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- 实例条是横向 ListBox：默认 ListBoxItem 的纵向间距与选中底色会撑坏单行布局。 -->
    <Style Selector="ListBox.instances ListBoxItem">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    </Style>

    <Style Selector="ListBox.instances ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.instances ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 回收站条目是一行紧凑标签：ListBoxItem 默认的 10px 间距会把面板撑高一倍。 -->
    <Style Selector="ListBox.trash ListBoxItem">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    </Style>

    <!-- 隐藏的版本仍然可见时（「显示已隐藏」打开）压低存在感，避免和正常版本混淆。 -->
    <Style Selector="Border.card.hidden">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--
      详情栏的字段名。
      这个类原先在本文件里被引用却从未定义（label 只在 SettingsView 里是局部样式）：
      依赖全局默认样式意味着文字色与字号都跟着控件默认值走，
      换主题时看不出来，截图里也只能凭感觉判断。
    -->
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!--
      两栏：左列表（自适应）+ 右详情（固定 380，1024 下 320）。
      详情宽度靠 MainWindow 的 Window.compact 类切换，与外壳同一档阈值（1120）——
      两处各写一个阈值时，窗口停在两者之间就会出现「侧栏已经是紧凑档、详情还是宽档」。
    -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,14">

      <!-- ==================== 左栏 ==================== -->
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

        <!-- 工具条第一行：页签（已安装 / 可下载 / 整合包）+ 搜索。高 36，间距 12。 -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Height="36">

          <!--
            页签只切视图、不承载内容（strip 变体）：三份列表同时留在下面第 4 行里、
            靠 IsVisible 切换，这样切走再切回时滚动位置与虚拟化状态都还在。
          -->
          <TabControl Classes="strip"
                      SelectedIndex="{Binding CurrentViewIndex, Mode=TwoWay}">
            <TabItem Header="已安装" Tag="installed" />
            <TabItem Header="可下载" Tag="available" />
            <TabItem Header="整合包" Tag="modpacks" />
          </TabControl>

          <!--
            搜索框：绑定的是当前视图自己的搜索词（切换视图时跟着换）。
            独占 * 列而不是与筛选 chip 争同一行：5 个 chip 的实测宽度约 460，
            再挤一个输入框在 1024 档会把输入框压到只剩几十像素（截图里就是这个形态）。
          -->
          <TextBox Grid.Column="1"
                   MinWidth="160"
                   Height="36"
                   HorizontalAlignment="Stretch"
                   VerticalContentAlignment="Center"
                   Watermark="{Binding SearchWatermark}"
                   Text="{Binding CurrentSearchText, Mode=TwoWay}" />
        </Grid>

        <!-- 工具条第二行：筛选 chip。只在「已安装」视图有意义（远程清单里没有加载器概念）。 -->
        <!-- 三列 Auto：chip 组按自然宽度、计数占剩余、右侧动作贴边。
             第一列若写 * 会把 StackPanel 撑满整行，chip 在其中的可用宽度被算成 0，出现文字重叠。 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Height="36">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsInstalledView}">
            <Button Classes="pill"
                    Classes.active="{Binding IsFilterAll}"
                    Content="全部"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="all" />
            <Button Classes="pill"
                    Classes.active="{Binding IsFilterVanilla}"
                    Content="原版"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="vanilla" />
            <Button Classes="pill"
                    Classes.active="{Binding IsFilterLoader}"
                    Content="加载器"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="loader" />
            <Button Classes="pill"
                    Classes.active="{Binding IsFilterFavorite}"
                    Content="收藏"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="favorite" />
            <!-- 隐藏是「显示开关」而不是筛选键，所以单独一个命令。 -->
            <Button Classes="pill"
                    Classes.active="{Binding ShowHidden}"
                    Content="显示已隐藏"
                    Command="{Binding ToggleShowHiddenCommand}" />
          </StackPanel>

          <!-- 计数放在可伸缩列并允许省略：窄窗口下它先让位，不会压到右侧按钮上。 -->
          <!-- 左对齐到 chip 右侧而不是居中：居中时它会与 chip 的最后一项重叠。 -->
          <TextBlock Grid.Column="1"
                     Text="{Binding VersionCountText}"
                     Classes="muted"
                     Margin="12,0,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsInstalledView}"
                     TextTrimming="CharacterEllipsis" />

          <!-- 「可下载」「整合包」两视图各有一个工具动作，放在同一个贴右的位置上。
               两者的可见性互斥，所以共用第 2 列即可，不必占两列。 -->
          <Panel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAvailableView}">
              <Button Classes="pill"
                      Classes.active="{Binding Available.ReleaseOnly}"
                      Content="只看正式版"
                      Command="{Binding ToggleReleaseOnlyCommand}" />
              <Button Classes="ghost"
                      Height="36"
                      Content="刷新清单"
                      Command="{Binding ReloadAvailableCommand}" />
            </StackPanel>
            <Button Classes="ghost"
                    Height="36"
                    Content="加载更多"
                    IsVisible="{Binding IsModpacksView}"
                    IsEnabled="{Binding !Modpacks.IsLoading}"
                    Command="{Binding LoadMoreModpacksCommand}" />
          </Panel>
        </Grid>

        <!-- 状态条：与视图无关的页面级提示（服务缺失、错误、进度、缺 Java）。 -->
        <StackPanel Grid.Row="2" Spacing="8">
          <Border Classes="card"
                  Padding="14,10"
                  Background="{DynamicResource Status.Warning.Soft}"
                  BorderBrush="{DynamicResource Status.Warning}"
                  IsVisible="{Binding ServiceWarning, Converter={x:Static conv:Converters.HasValue}}">
            <TextBlock Text="{Binding ServiceWarning}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource Status.Warning}" />
          </Border>

          <Border Classes="card"
                  Padding="14,10"
                  Background="{DynamicResource Status.Danger.Soft}"
                  BorderBrush="{DynamicResource Status.Danger}"
                  IsVisible="{Binding ErrorText, Converter={x:Static conv:Converters.HasValue}}">
            <TextBlock Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource Status.Danger}" />
          </Border>

          <Border Classes="card"
                  Padding="14,10"
                  Background="{DynamicResource Accent.Soft}"
                  BorderBrush="{DynamicResource Accent.Primary}"
                  IsVisible="{Binding StatusText, Converter={x:Static conv:Converters.HasValue}}">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Small}" />
          </Border>

          <!-- 缺 Java：就地安装，不再把用户丢去设置页 -->
          <Border Classes="card"
                  Padding="14,10"
                  Background="{DynamicResource Accent.Soft}"
                  BorderBrush="{DynamicResource Accent.Primary}"
                  IsVisible="{Binding HasMissingJava}">
            <StackPanel Spacing="8">
              <TextBlock Text="缺少可用的 Java"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource FontSize.Small}" />
              <TextBlock Text="{Binding JavaInstall.Summary}"
                         TextWrapping="Wrap"
                         Classes="muted"
                         FontSize="{DynamicResource FontSize.Small}" />
              <!-- 比例一律 0..1 直接绑，不套字符串转换器 -->
              <ProgressBar Height="4"
                           Minimum="0"
                           Maximum="1"
                           Value="{Binding JavaInstall.Ratio}"
                           IsVisible="{Binding JavaInstall.IsInstalling}" />
              <TextBlock Text="{Binding JavaInstall.StatusText}"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSize.Small}"
                         IsVisible="{Binding JavaInstall.StatusText, Converter={x:Static conv:Converters.HasValue}}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent"
                        Content="{Binding JavaInstallButtonText}"
                        Command="{Binding InstallMissingJavaCommand}"
                        FontSize="{DynamicResource FontSize.Small}" />
                <Button Classes="pill"
                        Content="打开 Java 设置"
                        Command="{Binding OpenJavaSettingsCommand}"
                        FontSize="{DynamicResource FontSize.Small}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ==================== 三视图列表 ==================== -->
        <!--
          三份列表同时挂在可视树里，只靠 IsVisible 切换：这正是「切走再切回原样恢复」的实现。
          任何一份被 IsVisible 隐藏时都保留自己的 ScrollViewer 与虚拟化状态。
        -->
        <controls:GlassPanel Grid.Row="3" Padding="0">
        <Grid>

          <!-- 已安装视图 -->
          <Grid IsVisible="{Binding IsInstalledView}">
            <ListBox x:Name="InstalledList"
                     ItemsSource="{Binding VisibleVersions}"
                     SelectedItem="{Binding SelectedRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     DoubleTapped="OnVersionsDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VersionRow">
                  <Border Classes="card hoverable"
                          Classes.accentEdge="{Binding $parent[ListBoxItem].IsSelected}"
                          Classes.hidden="{Binding IsHidden}"
                          Padding="14,8" Height="52">
                    <!--
                      行结构固定为「图标 / 名称 / 版本与加载器 / 右侧唯一主行动」。
                      行内只留一个主行动（启动），其余（修复、组件、打开目录、隐藏、删除）
                      全部收进「…」菜单——票 #87 与 ui-audit 的「每行一个 accent 主按钮」同一结论。
                    -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                      <!-- 版本图标：立方体线稿。加载器版本用强调色，原版用三级文字色。 -->
                      <Border Width="36"
                              Height="36"
                              CornerRadius="{DynamicResource Radius.Md}"
                              Background="{DynamicResource Accent.Soft}"
                              BorderBrush="{DynamicResource Stroke.Subtle}"
                              BorderThickness="1"
                              VerticalAlignment="Center">
                        <Panel Width="19" Height="19">
                          <Path Data="{StaticResource Icon.Versions}"
                                Stroke="{DynamicResource Accent.Primary}"
                                StrokeThickness="1.4"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Stretch="Uniform"
                                IsVisible="{Binding IsModded}" />
                          <Path Data="{StaticResource Icon.Versions}"
                                Stroke="{DynamicResource Text.Tertiary}"
                                StrokeThickness="1.4"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Stretch="Uniform"
                                IsVisible="{Binding !IsModded}" />
                        </Panel>
                      </Border>

                      <!-- 信息区：名称 + 版本与加载器，两行。 -->
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                          <!-- 星标：描边 / 实心两态，只用 IsVisible 切换，不引入转换器。 -->
                          <Button Classes="ghost icon"
                                  Width="20"
                                  Height="20"
                                  MinHeight="20"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="收藏：收藏的版本置顶显示"
                                  Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).ToggleFavoriteCommand}"
                                  CommandParameter="{Binding}">
                            <Panel Width="14" Height="14">
                              <Path Data="M12 3.2 14.7 8.7 20.8 9.6 16.4 13.9 17.4 20 12 17.1 6.6 20 7.6 13.9 3.2 9.6 9.3 8.7z"
                                    Stroke="{DynamicResource Text.Tertiary}"
                                    StrokeThickness="1.3"
                                    StrokeLineCap="Round"
                                    StrokeJoin="Round"
                                    Stretch="Uniform" />
                              <Path Data="M12 3.2 14.7 8.7 20.8 9.6 16.4 13.9 17.4 20 12 17.1 6.6 20 7.6 13.9 3.2 9.6 9.3 8.7z"
                                    Fill="{DynamicResource Status.Warning}"
                                    Stretch="Uniform"
                                    IsVisible="{Binding IsFavorite}" />
                            </Panel>
                          </Button>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding Name}"
                                     FontSize="{DynamicResource FontSize.BodyLg}"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Name}" />

                          <Border Grid.Column="2"
                                  Classes="badge"
                                  Classes.success="{Binding IsRelease}"
                                  Classes.warning="{Binding IsSnapshot}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChannelText}" />
                          </Border>
                          <Border Grid.Column="3"
                                  Classes="badge warning"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsHidden}">
                            <TextBlock Text="已隐藏" />
                          </Border>
                        </Grid>

                        <!-- 元信息：版本与加载器 / 最后游玩 / 大小。用 Grid 而不是横向 StackPanel，
                             否则窗口压窄时它不会被截断，会把文字顶出卡片。 -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding LoaderText}"
                                     Classes="muted"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding LastPlayedText}"
                                     Classes="muted"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding SizeText}"
                                     Classes="muted mono"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding BusyText}"
                                     Classes="muted"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsBusy}" />
                        </Grid>

                        <TextBlock Text="{Binding BrokenReason}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource Status.Danger}"
                                   IsVisible="{Binding IsBroken}" />
                      </StackPanel>

                      <!-- 右侧：唯一主行动「启动」+ 溢出菜单。 -->
                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="6"
                                  VerticalAlignment="Center">
                        <Button Classes="accent"
                                Content="启动"
                                Padding="18,6"
                                MinHeight="32"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).LaunchVersionCommand}"
                                CommandParameter="{Binding}" />
                        <!--
                          溢出入口：修复、组件、打开目录、隐藏、删除全收进菜单。
                          菜单项的 DataContext 是它挂着的那个 VersionRow；修复档位与保存 jar
                          需要视图层的 TopLevel / 文件夹选择器，走 code-behind（见 OnRepairQuickClick 等）。
                        -->
                        <Button Classes="ghost icon"
                                Width="32"
                                Height="32"
                                MinHeight="32"
                                FontSize="{DynamicResource FontSize.Subtitle}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="更多操作：修复、组件、打开目录、隐藏、删除">
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="快速修复（只补缺失文件）"
                                        IsEnabled="{Binding CanRepair}"
                                        Click="OnRepairQuickClick" />
                              <MenuItem Header="深度修复（校验 libraries 与 assets）"
                                        IsEnabled="{Binding CanRepair}"
                                        Click="OnRepairDeepClick" />
                              <MenuItem Header="查看组件…"
                                        IsEnabled="{Binding !IsRunning}"
                                        Command="{Binding $parent[UserControl].((vm:VersionsViewModel)DataContext).OpenComponentsCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="打开版本目录"
                                        Command="{Binding $parent[UserControl].((vm:VersionsViewModel)DataContext).OpenVersionFolderCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="保存客户端 jar…" Click="OnSaveClientJarClick" />
                              <MenuItem Header="{Binding HideActionText}"
                                        Command="{Binding $parent[UserControl].((vm:VersionsViewModel)DataContext).ToggleHiddenCommand}"
                                        CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="删除版本…"
                                        IsEnabled="{Binding !IsRunning}"
                                        Command="{Binding $parent[UserControl].((vm:VersionsViewModel)DataContext).RequestDeleteCommand}"
                                        CommandParameter="{Binding}" />
                            </MenuFlyout>
                          </Button.Flyout>
                          <TextBlock Text="…" VerticalAlignment="Center" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态一：一个版本都没有 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding IsEmpty}">
              <Border Width="56" Height="56"
                      CornerRadius="{DynamicResource Radius.X3l}"
                      Background="{DynamicResource Accent.Soft}"
                      HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Versions}"
                      Stroke="{DynamicResource Accent.Primary}"
                      StrokeThickness="1.6"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      Width="24" Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="还没有安装任何版本" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="切到「可下载」挑一个 Minecraft 版本，装好就会出现在这里。"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="360" />
              <Button Classes="accent"
                      Content="去挑一个版本"
                      HorizontalAlignment="Center"
                      Padding="22,8"
                      Command="{Binding SelectViewCommand}"
                      CommandParameter="{x:Static vm:VersionsViewKind.Available}" />
            </StackPanel>

            <!-- 空态二：筛选无结果 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding IsFilteredEmpty}">
              <TextBlock Text="没有匹配的版本" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="换个关键词，或者把筛选切回「全部」。"
                         Classes="muted"
                         HorizontalAlignment="Center" />
              <Button Classes="pill"
                      Content="清除筛选"
                      HorizontalAlignment="Center"
                      Command="{Binding SelectFilterCommand}"
                      CommandParameter="all" />
            </StackPanel>

            <!-- 空态三：版本全被隐藏（隐藏不删文件，给一键恢复出口） -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding IsAllHidden}">
              <TextBlock Text="版本都被隐藏了" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="隐藏只影响列表显示，没有删除任何文件。打开「显示已隐藏」即可看到它们。"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="380"
                         HorizontalAlignment="Center" />
              <Button Classes="pill"
                      Content="显示已隐藏"
                      HorizontalAlignment="Center"
                      Padding="16,6"
                      Command="{Binding ToggleShowHiddenCommand}" />
            </StackPanel>

            <!-- 加载态：骨架 5 行 -->
            <StackPanel Spacing="8" IsVisible="{Binding IsLoading}">
              <Border Classes="card" Height="52" Opacity="0.55" />
              <Border Classes="card" Height="52" Opacity="0.45" />
              <Border Classes="card" Height="52" Opacity="0.35" />
              <Border Classes="card" Height="52" Opacity="0.25" />
              <Border Classes="card" Height="52" Opacity="0.15" />
            </StackPanel>
          </Grid>

          <!-- 可下载视图 -->
          <Grid IsVisible="{Binding IsAvailableView}">
            <ListBox x:Name="AvailableList"
                     ItemsSource="{Binding Available.VisibleRows}"
                     SelectedItem="{Binding Available.SelectedRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RemoteVersionRow">
                  <Border Classes="card hoverable"
                          Classes.accentEdge="{Binding $parent[ListBoxItem].IsSelected}"
                          Padding="14,6" Height="52">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Id}"
                                   FontSize="{DynamicResource FontSize.BodyLg}"
                                   FontWeight="Medium"
                                   Classes="mono"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                          <Border Grid.Column="0" Classes="badge" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChannelText}" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding ReleaseTimeText}"
                                     Classes="muted mono"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2"
                                     Text="原版"
                                     Classes="muted"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>

                      <Border Grid.Column="1"
                              Classes="badge success"
                              IsVisible="{Binding IsInstalled}"
                              VerticalAlignment="Center">
                        <TextBlock Text="已安装" />
                      </Border>

                      <!-- 唯一主行动：安装。已装过的禁用并改文案，不给两个主行动。 -->
                      <Button Grid.Column="2"
                              Classes="accent"
                              Content="安装"
                              Padding="18,6"
                              MinHeight="32"
                              IsVisible="{Binding !IsInstalled}"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).InstallRemoteVersionCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2"
                              Classes="ghost"
                              Content="去启动"
                              Padding="18,6"
                              MinHeight="32"
                              IsVisible="{Binding IsInstalled}"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).GoToInstalledCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态：清单还没拉到 / 拉到了但空 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding Available.IsEmpty}">
              <TextBlock Text="没有可下载的版本" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="版本清单可能还没拉到，或者网络不通。点「刷新清单」再试一次。"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="360" />
              <Button Classes="accent"
                      Content="刷新清单"
                      HorizontalAlignment="Center"
                      Padding="22,8"
                      Command="{Binding ReloadAvailableCommand}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding Available.IsFilteredEmpty}">
              <TextBlock Text="没有匹配的版本" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="换一个关键词再搜。" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding Available.IsLoading}">
              <Border Classes="card" Height="52" Opacity="0.55" />
              <Border Classes="card" Height="52" Opacity="0.45" />
              <Border Classes="card" Height="52" Opacity="0.35" />
              <Border Classes="card" Height="52" Opacity="0.25" />
              <Border Classes="card" Height="52" Opacity="0.15" />
            </StackPanel>

            <TextBlock Text="{Binding Available.ErrorText}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       IsVisible="{Binding Available.ErrorText, Converter={x:Static conv:Converters.HasValue}}" />
          </Grid>

          <!-- 整合包视图 -->
          <Grid IsVisible="{Binding IsModpacksView}">
            <ListBox x:Name="ModpacksList"
                     ItemsSource="{Binding Modpacks.Rows}"
                     SelectedItem="{Binding Modpacks.SelectedRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModpackRow">
                  <Border Classes="card hoverable"
                          Classes.accentEdge="{Binding $parent[ListBoxItem].IsSelected}"
                          Padding="14,6" Height="52">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <!-- 两行：标题 + 一行元信息。描述挪进右侧详情——
                             三行文本在固定 52 的行高里会被裁掉半行（设计稿的行结构是「图标 / 名称 / 版本与加载器 / 右侧状态」）。 -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{DynamicResource FontSize.BodyLg}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Title}" />
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding AuthorText}"
                                     Classes="muted"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="120" />
                          <!-- 版本号与大小用等宽右对齐，纵向扫读时不出错 -->
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DownloadsText}"
                                     Classes="muted mono"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding GameVersionsText}"
                                     Classes="muted"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </StackPanel>

                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusText}"
                                 Classes="muted mono"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding !IsImporting}" />
                      <ProgressBar Grid.Column="1"
                                   Width="70"
                                   Height="4"
                                   Minimum="0"
                                   Maximum="1"
                                   Value="{Binding ImportProgress}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsImporting}" />

                      <!-- 唯一主行动：导入。导入中禁用，避免双击起两条链路。 -->
                      <Button Grid.Column="2"
                              Classes="accent"
                              Content="导入"
                              Padding="18,6"
                              MinHeight="32"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding !IsImporting}"
                              Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).ImportModpackCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态：还没搜过 / 搜完没有结果 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding Modpacks.IsEmpty}">
              <TextBlock Text="没有找到整合包" Classes="h3" HorizontalAlignment="Center" />
              <TextBlock Text="换个关键词，或者直接回车看热门包；导入后它会成为一个独立实例。"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="380" />
              <Button Classes="accent"
                      Content="看热门整合包"
                      HorizontalAlignment="Center"
                      Padding="22,8"
                      Command="{Binding ReloadModpacksCommand}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding Modpacks.IsLoading}">
              <Border Classes="card" Height="52" Opacity="0.55" />
              <Border Classes="card" Height="52" Opacity="0.45" />
              <Border Classes="card" Height="52" Opacity="0.35" />
              <Border Classes="card" Height="52" Opacity="0.25" />
              <Border Classes="card" Height="52" Opacity="0.15" />
            </StackPanel>

            <TextBlock Text="{Binding Modpacks.ErrorText}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       IsVisible="{Binding Modpacks.ErrorText, Converter={x:Static conv:Converters.HasValue}}" />
          </Grid>
        </Grid>
      </controls:GlassPanel>
      </Grid>

      <!-- ==================== 右栏：详情（固定宽，1024 下 320） ==================== -->
      <!--
        详情面板的骨架由票 #87 建立，内容由 #88（概览 / Java / 内存）与 #89（世界 / 整合包）填充。
        这里先把它做成「选中什么就显示什么」的稳定容器：切视图时内容跟着换，宽度不跟着变。
      -->
      <Border Grid.Column="1" Classes="card detail-pane" Padding="20,18">
        <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding CurrentViewTitle}" Classes="label" />

            <!--
              已安装：实例详情（票 #88）。
              概览的头部 / 信息 / 内存与 Java 全部收进独立控件 InstanceDetailPane：
              它自己就是一个 UserControl，右栏只负责给它位置。
              下面「独立实例」那一段仍留在页面里——它是列表，不是详情。

              直接放控件、不套 ContentControl：套一层会让 DataContext 在内容边界上
              走一次继承，内层控件的 x:DataType 与实际上下文错位，
              表现为「绑定静默为空」——头部整块不渲染，且编译器不报错。
            -->
            <views:InstanceDetailPane IsVisible="{Binding IsInstalledView}" />

            <!-- 已安装：实例列表（固定高度框住，内部滚动）+ 新建实例 -->
            <StackPanel Spacing="8" IsVisible="{Binding IsInstalledView}">
              <Border Classes="divider" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="实例" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Classes="ghost icon"
                          Width="24" Height="24" MinHeight="24"
                          Padding="0"
                          ToolTip.Tip="{Binding TrashButtonText}"
                          Command="{Binding ToggleTrashCommand}">
                    <TextBlock Text="⌫" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Button>
                </Grid>

                <!--
                  列表被一个固定高度的框子框住，滚动只发生在框内。
                  为什么不让它自然撑高：实例数量是用户数据，10 个实例就会把右栏顶出屏幕，
                  于是整个右栏出现滚动条、把上面的「实例身份」挤走。
                  框住之后右栏总高度只取决于「概览 + 框子」，与实例数量无关。
                -->
                <Border Classes="sunken"
                        Height="132"
                        Padding="4"
                        IsVisible="{Binding HasInstances}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ListBox Classes="instances"
                             ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding SelectedInstance}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstanceRow">
                          <!--
                            卡片只保留「选得出来」所需的最少信息：图标 / 名称 / 运行中徽标 / 最后启动。
                            第一版在每张卡里塞了「设置 / 打开目录 / 停止 / 更多」四个按钮，
                            两个实例就把右栏撑到需要滚动——动作改由上方概览区那排按钮承担。
                          -->
                          <Border Classes="sunken"
                                  Classes.accentEdge="{Binding $parent[ListBoxItem].IsSelected}"
                                  Padding="6,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                              <Border Width="20" Height="20"
                                      CornerRadius="{DynamicResource Radius.Xs}"
                                      Background="{DynamicResource Accent.Soft}"
                                      VerticalAlignment="Center">
                                <Path Data="{Binding IconGeometry}"
                                      Stroke="{DynamicResource Accent.Primary}"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Medium"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastPlayedText}"
                                           Classes="muted"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="2"
                                      Classes="badge success"
                                      Padding="6,1"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsRunning}">
                                <TextBlock Text="运行中" FontSize="{DynamicResource FontSize.Caption}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                </Border>

                <TextBlock Text="选中一个版本后点下面的「新建实例」，它就会拥有独立的 mods / saves / config。"
                           Classes="muted"
                           FontSize="{DynamicResource FontSize.Caption}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasInstances}" />

                <!--
                  次要样式而不是 accent：每个版本行已经有一个红色「启动」，
                  详情栏再放一个红色主行动会让一屏出现两个同等权重的强调块，
                  而「新建实例」不是这一页的主任务（票 #87 与 ui-audit 的同一结论）。

                  只在「一个实例都没有」时出现：已经有实例时这个按钮点了也不会新建
                  （同一版本目录只能有一个实例，CreateAsync 是幂等的），
                  留着它只会在右栏白占一行高度、把下面的内容顶出视口。
                -->
                <Button Classes="ghost"
                        Content="为选中版本新建实例"
                        MinHeight="34"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding !HasInstances}"
                        IsEnabled="{Binding IsInstanceBusy, Converter={x:Static conv:Converters.InverseBool}}"
                        Command="{Binding CreateInstanceCommand}"
                        CommandParameter="{Binding SelectedRow}" />
            </StackPanel>

            <!-- 可下载：选中版本的详情 -->
            <StackPanel Spacing="10" IsVisible="{Binding IsAvailableView}">
              <TextBlock Text="{Binding Available.SelectedRow.Id, FallbackValue=未选择版本}"
                         FontSize="{DynamicResource FontSize.Title}"
                         FontWeight="SemiBold"
                         Classes="mono"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Available.SelectedRow.ChannelText}"
                         Classes="muted" />
              <Border Classes="divider" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="6">
                <TextBlock Text="发布日期" Classes="muted" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Available.SelectedRow.ReleaseTimeText}"
                           Classes="mono"
                           HorizontalAlignment="Right" />
              </Grid>
              <TextBlock Text="装好后会出现在「已安装」里；同一个版本可以再新建独立实例，用于不同整合包。"
                         Classes="muted"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- 整合包：选中项目的详情 -->
            <StackPanel Spacing="10" IsVisible="{Binding IsModpacksView}">
              <TextBlock Text="{Binding Modpacks.SelectedRow.Title, FallbackValue=未选择整合包}"
                         FontSize="{DynamicResource FontSize.Title}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Modpacks.SelectedRow.AuthorText}"
                         Classes="muted" />
              <Border Classes="divider" />
              <TextBlock Text="{Binding Modpacks.SelectedRow.DescriptionText}"
                         TextWrapping="Wrap"
                         LineHeight="20" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="6">
                <TextBlock Text="下载量" Classes="muted" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Modpacks.SelectedRow.DownloadsText}"
                           Classes="mono"
                           HorizontalAlignment="Right" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="游戏版本" Classes="muted" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Modpacks.SelectedRow.GameVersionsText}"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
              <TextBlock Text="导入会先装游戏与加载器，再解压覆盖层，最后补全文件；得到一个独立实例。"
                         Classes="muted"
                         TextWrapping="Wrap" />
              <!--
                次要样式而不是 accent：整合包行上已经有唯一的红色「导入」，
                详情栏再放一个红色主行动会让同一屏出现两个同等权重的强调块。
                这里的入口只是「不必回头找行」的便利，不抢行内主行动的位置。
              -->
              <Button Classes="ghost"
                      Content="导入这个整合包"
                      MinHeight="36"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding Modpacks.SelectedRow.IsImporting, Converter={x:Static conv:Converters.InverseBool}}"
                      Command="{Binding ImportModpackCommand}"
                      CommandParameter="{Binding Modpacks.SelectedRow}" />
            </StackPanel>

            <!-- 视图级状态：导入 / 下载的进度文案 -->
            <TextBlock Text="{Binding StatusText}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusText, Converter={x:Static conv:Converters.HasValue}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ==================== 删除确认浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsConfirmOpen}">
      <Border Classes="card"
              Width="400"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"
                  Stroke="{DynamicResource Status.Danger}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="17" Height="17"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Text="删除版本" Classes="h3" />
          </StackPanel>

          <TextBlock Text="将永久删除该版本目录及其中的文件，无法恢复。世界存档与模组目录不受影响。"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <Border Classes="sunken" Padding="12,10">
            <TextBlock Text="{Binding PendingDelete.Name}" Classes="mono" TextTrimming="CharacterEllipsis" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="取消" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="danger" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 实例删除确认浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsInstanceConfirmOpen}">
      <Border Classes="card"
              Width="420"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"
                  Stroke="{DynamicResource Status.Danger}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="17" Height="17"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Text="移入回收站" Classes="h3" />
          </StackPanel>

          <TextBlock Text="将把该版本目录整体移入启动器回收站（版本文件与 mods / saves / config 一起搬走），之后可在回收站面板恢复。其他版本的实例不受影响。"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <Border Classes="sunken" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding PendingDeleteInstance.Name}"
                         Classes="mono"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding PendingDeleteInstance.VersionText}"
                         Classes="muted"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="取消" Command="{Binding CancelDeleteInstanceCommand}" />
            <Button Classes="danger" Content="移入回收站" Command="{Binding ConfirmDeleteInstanceCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- ==================== 重命名浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsRenameOpen}">
      <Border Classes="card"
              Width="400"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding RenameTitle}"
                     Classes="h3"
                     TextTrimming="CharacterEllipsis" />

          <TextBox Text="{Binding RenameDraft}" Watermark="实例名称" />

          <TextBlock Text="{Binding RenameError}"
                     IsVisible="{Binding HasRenameError}"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSize.Small}"
                     Foreground="{DynamicResource Status.Danger}" />

          <TextBlock Text="只改显示名。目录名是版本名，不会变，因此启动记录与模组分组都不受影响。"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="取消" Command="{Binding CancelRenameCommand}" />
            <Button Classes="accent"
                    Content="保存名称"
                    IsEnabled="{Binding !IsRenameBusy}"
                    Command="{Binding ConfirmRenameCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 图标选择浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsIconPickerOpen}">
      <Border Classes="card"
              Width="438"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding IconPickerTitle}"
                     Classes="h3"
                     TextTrimming="CharacterEllipsis" />

          <ItemsControl ItemsSource="{Binding IconChoices}" IsEnabled="{Binding !IsIconBusy}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IconChoice">
                <Button Classes="pill"
                        Width="48"
                        Height="48"
                        MinHeight="48"
                        Margin="0,0,8,8"
                        Padding="0"
                        ToolTip.Tip="{Binding Title}"
                        Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).ApplyIconCommand}"
                        CommandParameter="{Binding}">
                  <Path Data="{Binding Geometry}"
                        Stroke="{DynamicResource Accent.Primary}"
                        StrokeThickness="1.4"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Stretch="Uniform"
                        Width="22" Height="22" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="图标只用于列表辨识，不影响启动。12 种内置图标全部是自绘线条徽标。"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <Button Classes="ghost"
                  Content="关闭"
                  HorizontalAlignment="Right"
                  Command="{Binding CancelIconPickerCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 清理浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsCleanupOpen}">
      <Border Classes="card"
              Width="440"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding CleanupTitle}"
                     Classes="h3"
                     TextTrimming="CharacterEllipsis" />

          <TextBlock Text="只清理可再生成的诊断文件。存档、模组、资源包、配置都不在清理范围内。"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding CleanupLogs}" Content="logs/：游戏日志" />
            <CheckBox IsChecked="{Binding CleanupCrashReports}" Content="crash-reports/：崩溃报告" />
            <CheckBox IsChecked="{Binding CleanupDebugProfile}" Content="debug/：性能采样输出" />
            <CheckBox IsChecked="{Binding CleanupScreenshots}" Content="screenshots/：游戏截图（你的资产，默认不动）" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="时间范围" Classes="muted" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding CleanupRanges}"
                      SelectedItem="{Binding CleanupRange}"
                      MinWidth="160">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupRangeOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <TextBlock Text="{Binding CleanupStatus}"
                     IsVisible="{Binding HasCleanupStatus}"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="关闭" Command="{Binding CancelCleanupCommand}" />
            <Button Classes="accent"
                    Content="开始清理"
                    IsEnabled="{Binding !IsCleanupBusy}"
                    Command="{Binding ConfirmCleanupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 彻底删除确认浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsPurgeConfirmOpen}">
      <Border Classes="card"
              Width="420"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"
                  Stroke="{DynamicResource Status.Danger}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="17" Height="17"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Text="彻底删除" Classes="h3" />
          </StackPanel>

          <TextBlock Text="将从磁盘删除该版本目录的全部文件（版本文件、mods / saves / config），不可恢复。"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <Border Classes="sunken" Padding="12,10">
            <TextBlock Text="{Binding PendingPurge.Name}"
                       Classes="mono"
                       TextTrimming="CharacterEllipsis" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="取消" Command="{Binding CancelPurgeCommand}" />
            <Button Classes="danger" Content="彻底删除" Command="{Binding ConfirmPurgeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 深度修复确认浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsRepairConfirmOpen}">
      <Border Classes="card"
              Width="430"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <TextBlock Text="深度修复" Classes="h3" />

          <TextBlock Text="将逐个校验 libraries 与 assets，可能耗时数分钟。期间请勿启动游戏，以免文件被占用。"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <Border Classes="sunken" Padding="12,10">
            <TextBlock Text="{Binding PendingRepairRow.Name}"
                       Classes="mono"
                       TextTrimming="CharacterEllipsis" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="取消" Command="{Binding CancelRepairConfirmCommand}" />
            <Button Classes="accent" Content="开始深度修复" Command="{Binding ConfirmDeepRepairCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 完整备注浮层 ==================== -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsNotesOpen}">
      <Border Classes="card"
              Width="440"
              MaxHeight="420"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding NotesTitle}"
                     Classes="h3"
                     TextTrimming="CharacterEllipsis" />

          <!-- 备注长度不可控：放 ScrollViewer 里 Wrap，否则长备注会把浮层撑出窗口。 -->
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding NotesBody}"
                       Classes="secondary"
                       TextWrapping="Wrap"
                       LineHeight="20" />
          </ScrollViewer>

          <TextBlock Text="备注只存在 instance.json 里，不影响启动与文件内容。"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <Button Classes="ghost"
                  Content="关闭"
                  HorizontalAlignment="Right"
                  Command="{Binding CloseNotesCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 版本组件浮层 ==================== -->
    <!-- 只读安装清单做 mtime 比对：不联网、不改文件。修复入口复用版本页已有的快速修复。 -->
    <Border Background="{DynamicResource Surface.Sunken}"
            IsVisible="{Binding IsComponentsOpen}">
      <Border Classes="card"
              Width="620"
              MaxHeight="580"
              Padding="22,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="{DynamicResource Shadow.Overlay}">
        <StackPanel Spacing="12">

          <!-- 标题 + 健康状态徽标 -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ComponentsTitle}"
                         Classes="h3"
                         TextTrimming="CharacterEllipsis" />
              <Border Classes="badge"
                      Classes.success="{Binding ComponentsHealthy}"
                      IsVisible="{Binding ComponentsHealthy}"
                      VerticalAlignment="Center">
                <TextBlock Text="完好" />
              </Border>
              <Border Classes="badge warning"
                      IsVisible="{Binding ComponentsHasFindings}"
                      VerticalAlignment="Center">
                <TextBlock Text="有问题" />
              </Border>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="ghost"
                    Content="关闭"
                    Command="{Binding CloseComponentsCommand}" />
          </Grid>

          <TextBlock Text="{Binding ComponentsSummary}"
                     Classes="secondary"
                     TextWrapping="Wrap"
                     LineHeight="20" />

          <!-- 组件行：种类徽标 + 名称 + 文件数 + 缺失 / 改动徽标 -->
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Components}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ComponentRow">
                  <Border Classes="sunken" Padding="10,8" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <Border Classes="badge" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" />
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Classes="mono"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DetailText}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <Border Grid.Column="2"
                              Classes="badge danger"
                              IsVisible="{Binding HasMissing}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding MissingText}" />
                      </Border>
                      <Border Grid.Column="3"
                              Classes="badge warning"
                              IsVisible="{Binding HasModified}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModifiedText}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 缺失文件 -->
          <StackPanel Spacing="4" IsVisible="{Binding HasMissingFiles}">
            <TextBlock Text="缺失文件" Classes="muted" FontWeight="SemiBold" />
            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ComponentsMissingFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}"
                               Classes="mono"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <!-- 被改动的文件 -->
          <StackPanel Spacing="4" IsVisible="{Binding HasModifiedFiles}">
            <TextBlock Text="被改动的文件" Classes="muted" FontWeight="SemiBold" />
            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ComponentsModifiedFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}"
                               Classes="mono"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <TextBlock Text="{Binding ComponentsTruncationNote}"
                     IsVisible="{Binding HasTruncationNote}"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <!-- 没有清单 / 服务缺失时的说明 -->
          <Border Classes="sunken" Padding="12,10" IsVisible="{Binding HasComponentsMessage}">
            <TextBlock Text="{Binding ComponentsMessage}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       LineHeight="20" />
          </Border>

          <TextBlock Text="检查只读安装清单与文件修改时间，不下载任何东西。修复粒度仍是整个版本：修完请重新检查。"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="pill"
                    Content="重新检查"
                    IsEnabled="{Binding CanInspectComponents}"
                    Command="{Binding RefreshComponentsCommand}" />
            <Button Classes="accent"
                    Content="只修复缺失文件"
                    IsEnabled="{Binding CanRepairMissingFiles}"
                    Command="{Binding RepairMissingComponentsCommand}" />
            <Button Classes="ghost"
                    Content="关闭"
                    Command="{Binding CloseComponentsCommand}" />
            <TextBlock Text="检查中…"
                       Classes="muted"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsComponentsBusy}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ==================== 实例设置 / 换加载器 / 回收站 ==================== -->
    <!-- 三块原来是列表上方的内联区域，收成浮层：左列表要让出高度给「1024×660 ≥4 行」的验收。 -->
          <!-- 实例设置面板：PCL2 的 VersionAdvance* / VersionArgument* 实例级设置移植 -->
          <Border Grid.Row="2"
                  IsVisible="{Binding IsInstanceEditorOpen}"
                  Background="{DynamicResource Surface.Sunken}"
                  BorderBrush="{DynamicResource Stroke.Default}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Sm}"
                  Padding="14,12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding InstanceEditorTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost"
                          Content="导出启动脚本"
                          IsEnabled="{Binding !IsInstanceEditorBusy}"
                          Command="{Binding ExportInstanceScriptCommand}" />
                  <Button Classes="ghost"
                          Content="关闭"
                          Command="{Binding CloseInstanceEditorCommand}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="150,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <!--
                  内存与 Java（票 #88）住在二级页面而不是右栏概览里：
                  右栏只回答「我在看哪个实例」，编辑动作放在这里才不会把概览撑成表单。
                  两者都可「跟随全局」：勾上即不覆盖（落盘 null），取消勾选才用本实例的值。
                -->
                <TextBlock Text="内存" Classes="label" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <!-- 运行中：内存与 Java 只读并说明原因（票面「运行中字段只读且有说明」）。 -->
                  <Border Classes="badge warning"
                          Padding="8,4"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding Detail.IsReadOnly}">
                    <TextBlock Text="{Binding Detail.ReadOnlyHint}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               TextWrapping="Wrap" />
                  </Border>

                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Content="跟随全局"
                              IsChecked="{Binding Detail.FollowGlobalMemory, Mode=TwoWay}"
                              IsEnabled="{Binding Detail.FieldEnabled}"
                              MinHeight="28"
                              VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Detail.MemoryText, Mode=TwoWay}"
                             IsEnabled="{Binding Detail.IsMemoryEditable}"
                             Classes="mono"
                             TextAlignment="Right"
                             MaxLength="{Binding Detail.MemoryMaxLength}"
                             MinHeight="32"
                             IsVisible="{Binding Detail.FollowGlobalMemory, Converter={x:Static conv:Converters.InverseBool}}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Detail.MemoryText}"
                               Classes="mono"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               IsVisible="{Binding Detail.FollowGlobalMemory}" />
                    <TextBlock Grid.Column="2" Text="MB" Classes="label" />
                  </Grid>
                  <TextBlock Text="{Binding Detail.MemoryError}"
                             Foreground="{DynamicResource Status.Danger}"
                             FontSize="{DynamicResource FontSize.Caption}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Detail.HasMemoryError}" />
                  <TextBlock Text="{Binding Detail.MemoryHint}"
                             Classes="muted"
                             FontSize="{DynamicResource FontSize.Caption}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Detail.HasMemoryError, Converter={x:Static conv:Converters.InverseBool}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Java" Classes="label" Margin="0,8,0,0" VerticalAlignment="Top" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding Detail.JavaPathText, Mode=TwoWay}"
                             IsEnabled="{Binding Detail.FieldEnabled}"
                             Watermark="留空则自动选择"
                             MinHeight="32"
                             ToolTip.Tip="{Binding Detail.JavaHint}" />
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Content="选择…"
                            MinHeight="32"
                            Padding="10,0"
                            Click="OnPickJavaClick" />
                  </Grid>
                  <TextBlock Text="{Binding Detail.JavaError}"
                             Foreground="{DynamicResource Status.Danger}"
                             FontSize="{DynamicResource FontSize.Caption}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Detail.HasJavaError}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="JVM 参数" Classes="label" Margin="0,8,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                         Text="{Binding EditorJvmArguments}"
                         Classes="mono"
                         Watermark="留空 = 跟随全局；例如 -XX:+UseG1GC" />

                <TextBlock Grid.Row="3" Text="游戏参数" Classes="label" Margin="0,8,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                         Text="{Binding EditorGameArguments}"
                         Classes="mono"
                         Watermark="例如 --demo" />

                <TextBlock Grid.Row="4" Text="窗口标题" Classes="label" Margin="0,8,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                         Text="{Binding EditorWindowTitle}"
                         Watermark="支持 {version} {user} {date} {time}" />

                <!--
                  版本信息是三态：勾「跟随全局」= 不覆盖；取消勾选后留空 = 明确不显示。
                  没有这个勾选框，用户就无法在全局填了整合包名的前提下把本实例单独关掉。
                -->
                <TextBlock Grid.Row="5" Text="版本信息" Classes="label" Margin="0,8,0,0" VerticalAlignment="Top" />
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Spacing="4">
                  <TextBox Text="{Binding EditorVersionType}"
                           MaxLength="32"
                           IsEnabled="{Binding !FollowGlobalVersionType}"
                           Watermark="留空 = 不显示版本名" />
                  <CheckBox IsChecked="{Binding FollowGlobalVersionType}"
                            Content="跟随全局设置（不覆盖本实例）" />
                  <TextBlock Text="{Binding EditorVersionTypeHint}"
                             Classes="muted"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="6" Text="服务器地址" Classes="label" Margin="0,8,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"
                         Text="{Binding EditorServerAddress}"
                         Watermark="例如 play.example.com:25565；留空进主菜单" />

                <!-- 备注是多行自由文本：AcceptReturn + Wrap，否则用户写的换行会被吞掉且看不到全文。 -->
                <TextBlock Grid.Row="7" Text="备注" Classes="label" Margin="0,8,0,0" VerticalAlignment="Top" />
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"
                         Text="{Binding EditorNotes}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="56"
                         VerticalContentAlignment="Top"
                         Watermark="给自己看的说明，例如「整合包 1.20.1 专用，别在这装光影」" />
              </Grid>

              <!--
                登录服务器（PCL2 的 VersionServerAuth* 三项）：决定客户端认哪一套验证服。
                与上面那行「服务器地址」不是一回事 —— 那个是进游戏后直连的服，
                这个给 authlib-injector 用，换个验证服就得换它。

                认证服务器是第二处三态：勾「跟随账户」= 不覆盖；取消勾选后留空 = 明确不注入
                authlib-injector（裸连），填了值 = 覆盖账户里的地址。少了这一层，
                用户在这个实例上清空输入框只会把账户地址又拿回来。
              -->
              <Border Background="{DynamicResource Surface.Card}"
                      BorderBrush="{DynamicResource Stroke.Subtle}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Sm}"
                      Padding="12,10">
                <StackPanel Spacing="6">
                  <TextBlock Text="登录服务器" Classes="label" />

                  <Grid ColumnDefinitions="150,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="认证服务器" Classes="label" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBox Text="{Binding EditorAuthServerUrl}"
                               IsEnabled="{Binding !FollowAccountAuthServer}"
                               Watermark="例如 https://littleskin.cn/api/yggdrasil" />
                      <CheckBox IsChecked="{Binding FollowAccountAuthServer}"
                                Content="跟随账户设置（不覆盖本实例）" />
                      <TextBlock Text="{Binding EditorAuthServerHint}"
                                 Classes="muted"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="服务器名称" Classes="label" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding EditorAuthServerName}"
                             Watermark="纯展示，例如「小皮裙验证服」；不影响启动" />

                    <!--
                      注册链接只做展示：按钮仅在地址通过 HTTP 校验（http:// 或 https://）时出现，
                      其余情况由下面的灰字说明该补什么。地址不参与启动参数。
                    -->
                    <TextBlock Grid.Row="2" Text="注册链接" Classes="label" Margin="0,8,0,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Spacing="4">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding EditorAuthRegisterUrl}"
                                 Watermark="例如 https://littleskin.cn/auth/register" />
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="注册"
                                IsVisible="{Binding HasEditorAuthRegisterLink}"
                                Command="{Binding OpenAuthRegisterCommand}" />
                      </Grid>
                      <TextBlock Text="{Binding EditorAuthRegisterHint}"
                                 Classes="muted"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="150,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                <TextBlock Text="启动前执行" Classes="label" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding EditorBeforeCommand}"
                         Classes="mono"
                         Watermark="支持 {gameDir} {version} {java}" />

                <TextBlock Grid.Row="1" Text="退出后执行" Classes="label" Margin="0,8,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                         Text="{Binding EditorAfterCommand}"
                         Classes="mono"
                         Watermark="支持 {gameDir} {version} {exitCode}" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox IsChecked="{Binding EditorWaitCommands}" Content="等待命令执行完成再继续" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="垃圾回收" Classes="muted" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding GcOptions}"
                            SelectedItem="{Binding EditorGcOption}"
                            MinWidth="130">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GcOption">
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </StackPanel>

              <TextBlock Text="参数留空表示跟随全局设置，填写后覆盖全局。导出脚本会带上该实例的全部参数，accessToken 自动打码。"
                         Classes="muted"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding InstanceEditorStatus}"
                         IsVisible="{Binding HasInstanceEditorStatus}"
                         Classes="muted"
                         TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent"
                        Content="保存实例设置"
                        IsEnabled="{Binding !IsInstanceEditorBusy}"
                        Command="{Binding SaveInstanceEditorCommand}" />
                <Button Classes="ghost"
                        Content="取消"
                        Command="{Binding CloseInstanceEditorCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 换加载器面板。与上面的实例设置面板共用第 2 行、靠 IsVisible 互斥：
               两个都展开会把页面变成一叠表单，而它们从不同时有用。 -->
          <Border Grid.Row="2"
                  IsVisible="{Binding IsLoaderSwitchOpen}"
                  Background="{DynamicResource Surface.Sunken}"
                  BorderBrush="{DynamicResource Stroke.Default}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Sm}"
                  Padding="14,12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="换加载器"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding LoaderSwitchInstance.Name}"
                             Classes="muted"
                             VerticalAlignment="Center"
                             MaxWidth="170"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Content="关闭"
                        Command="{Binding CloseLoaderSwitchCommand}" />
              </Grid>

              <TextBlock Text="{Binding LoaderSwitchCurrentText}"
                         Classes="muted"
                         TextWrapping="Wrap" />

              <!-- 目标加载器：胶囊互斥由 ViewModel 保证，与下载页同一套视觉。 -->
              <StackPanel Spacing="6">
                <TextBlock Text="目标加载器" Classes="label" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="pill"
                          Classes.active="{Binding IsSwitchTargetVanilla}"
                          Content="原版"
                          Command="{Binding SetSwitchTargetCommand}"
                          CommandParameter="{x:Static models:LoaderKind.Vanilla}" />
                  <Button Classes="pill"
                          Classes.active="{Binding IsSwitchTargetFabric}"
                          Content="Fabric"
                          Command="{Binding SetSwitchTargetCommand}"
                          CommandParameter="{x:Static models:LoaderKind.Fabric}" />
                  <Button Classes="pill"
                          Classes.active="{Binding IsSwitchTargetQuilt}"
                          Content="Quilt"
                          Command="{Binding SetSwitchTargetCommand}"
                          CommandParameter="{x:Static models:LoaderKind.Quilt}" />
                  <Button Classes="pill"
                          Classes.active="{Binding IsSwitchTargetForge}"
                          Content="Forge"
                          Command="{Binding SetSwitchTargetCommand}"
                          CommandParameter="{x:Static models:LoaderKind.Forge}" />
                  <Button Classes="pill"
                          Classes.active="{Binding IsSwitchTargetNeoForge}"
                          Content="NeoForge"
                          Command="{Binding SetSwitchTargetCommand}"
                          CommandParameter="{x:Static models:LoaderKind.NeoForge}" />
                </StackPanel>
              </StackPanel>

              <!-- 加载器版本：原版没有这一项，直接整块隐藏而不是留一个空下拉。 -->
              <StackPanel Spacing="6" IsVisible="{Binding NeedsLoaderVersionPick}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="加载器版本" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Text="加载中…"
                             Classes="muted"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsLoadingLoaderSwitchVersions}" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding LoaderSwitchVersions}"
                          SelectedItem="{Binding SelectedLoaderSwitchVersion}"
                          IsEnabled="{Binding !IsLoadingLoaderSwitchVersions}"
                          MinWidth="220">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoaderVersionOption">
                      <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding LoaderSwitchVersionHint}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding LoaderSwitchVersionHint, Converter={x:Static conv:Converters.HasValue}}" />
              </StackPanel>

              <TextBlock Text="换加载器会切到新的版本目录：旧目录里的 mods、存档、config 留在原处，不会自动迁移；需要继续用就复制到新目录。"
                         Classes="muted"
                         TextWrapping="Wrap" />

              <!-- 兼容性提示：只要现有 mods 会失效就必须先看到，而不是点完「更换」才知道。 -->
              <Border IsVisible="{Binding LoaderSwitchNeedsConfirm}"
                      Background="{DynamicResource Status.Warning.Soft}"
                      BorderBrush="{DynamicResource Status.Warning}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Sm}"
                      Padding="10,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="模组兼容性会变"
                             FontWeight="Medium"
                             FontSize="{DynamicResource FontSize.Small}" />
                  <TextBlock Text="{Binding LoaderSwitchConsequence}"
                             Classes="muted"
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource FontSize.Small}" />
                </StackPanel>
              </Border>

              <!-- 二次确认：危险改动必须两步，不靠一个「更换」直接开始下载。 -->
              <Border IsVisible="{Binding IsLoaderSwitchConfirmOpen}"
                      Background="{DynamicResource Surface.Raised}"
                      BorderBrush="{DynamicResource Status.Warning}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Sm}"
                      Padding="10,8">
                <StackPanel Spacing="8">
                  <TextBlock Text="确认更换？接下来会下载并安装目标加载器，失败时实例仍指向原来的版本。"
                             Classes="muted"
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource FontSize.Small}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent"
                            Content="确认更换"
                            Command="{Binding BeginSwitchLoaderCommand}" />
                    <Button Classes="ghost"
                            Content="再想想"
                            Command="{Binding CancelSwitchLoaderCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding LoaderSwitchProgressText}"
                         Classes="muted"
                         IsVisible="{Binding IsLoaderSwitchBusy}"
                         TextWrapping="Wrap" />
              <ProgressBar IsVisible="{Binding IsLoaderSwitchBusy}"
                           IsIndeterminate="True"
                           Height="3" />

              <TextBlock Text="{Binding LoaderSwitchStatus}"
                         IsVisible="{Binding HasLoaderSwitchStatus}"
                         Classes="muted"
                         TextWrapping="Wrap" />

              <!-- 常驻按钮行。二次确认展开时让位：确认条自己带「确认更换 / 再想想」，
                   同时出现两个「更换」会让人不知道该点哪个，也白白把面板撑高一截。 -->
              <StackPanel Orientation="Horizontal" Spacing="8"
                          IsVisible="{Binding !IsLoaderSwitchConfirmOpen}">
                <Button Classes="accent"
                        Content="更换"
                        IsEnabled="{Binding CanConfirmLoaderSwitch}"
                        Command="{Binding BeginSwitchLoaderCommand}" />
                <Button Classes="ghost"
                        Content="取消"
                        Command="{Binding CloseLoaderSwitchCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 回收站：被移入回收站的实例，可恢复或彻底删除 -->
          <Border Grid.Row="3"
                  IsVisible="{Binding IsTrashOpen}"
                  Background="{DynamicResource Surface.Sunken}"
                  BorderBrush="{DynamicResource Stroke.Subtle}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Sm}"
                  Padding="12,10">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding TrashPanelTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TrashSummary}"
                           Classes="muted"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Classes="ghost"
                        Content="收起"
                        Padding="8,2"
                        MinHeight="24"
                        FontSize="{DynamicResource FontSize.Small}"
                        Command="{Binding ToggleTrashCommand}" />
              </Grid>

              <ListBox Classes="trash"
                       ItemsSource="{Binding TrashEntries}"
                       MaxHeight="88"
                       IsEnabled="{Binding IsTrashBusy, Converter={x:Static conv:Converters.InverseBool}}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrashRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="210"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SizeText}" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DeletedText}" Classes="muted" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="pill"
                              Content="恢复"
                              Padding="10,2"
                              MinHeight="24"
                              FontSize="{DynamicResource FontSize.Small}"
                              Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).RestoreTrashCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2"
                              Classes="pill danger"
                              Content="彻底删除"
                              Padding="10,2"
                              MinHeight="24"
                              FontSize="{DynamicResource FontSize.Small}"
                              Command="{Binding $parent[ItemsControl].((vm:VersionsViewModel)DataContext).RequestPurgeCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
  </Panel>
</UserControl>