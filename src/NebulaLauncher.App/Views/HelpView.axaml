<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:help="using:NebulaLauncher.Core.Help"
             xmlns:conv="using:NebulaLauncher.Converters"
             x:Class="NebulaLauncher.Views.HelpView"
             x:DataType="vm:HelpViewModel">
  <Grid ColumnDefinitions="330,*" ColumnSpacing="16">

    <!-- 左栏：搜索 + 分类 + 条目列表 -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
      <TextBox Grid.Row="0"
               Text="{Binding SearchText}"
               Watermark="搜索帮助：整合包 / Java / 崩溃…" />

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Button Classes="pill"
                    Margin="0,0,6,6"
                    Content="{Binding}"
                    Command="{Binding $parent[ItemsControl].((vm:HelpViewModel)DataContext).SelectCategoryCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="2"
                 Text="{Binding CountText}"
                 Classes="muted" />

      <ListBox Grid.Row="3"
               ItemsSource="{Binding FilteredTopics}"
               SelectedItem="{Binding SelectedTopic}"
               IsVisible="{Binding HasNoMatch, Converter={x:Static BoolConverters.Not}}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="help:HelpTopic">
            <StackPanel Spacing="2" Margin="0,2">
              <TextBlock Text="{Binding Title}"
                         FontWeight="Medium"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Category}" Classes="muted" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 空态：说明 + 一个动作（契约 §6 规则 9） -->
      <Border Grid.Row="3"
              Classes="card"
              IsVisible="{Binding HasNoMatch}"
              VerticalAlignment="Top">
        <StackPanel Spacing="6">
          <TextBlock Text="没有匹配的帮助条目" FontWeight="Medium" />
          <TextBlock Text="换个关键词，或清空筛选看完整清单。"
                     Classes="muted"
                     TextWrapping="Wrap" />
          <Button Classes="pill"
                  Content="清空筛选"
                  HorizontalAlignment="Left"
                  Command="{Binding ResetFilterCommand}" />
        </StackPanel>
      </Border>

      <!-- 加载态：契约 §8 骨架 4 行，行高=条目行高（两行文案 + 内间距）。声明在空态之后：加载优先于空态。 -->
      <StackPanel Grid.Row="3"
                  Spacing="4"
                  IsVisible="{Binding IsLoading}">
        <Border Classes="listrow" Height="42" Background="{DynamicResource Surface.Hover}" />
        <Border Classes="listrow" Height="42" Background="{DynamicResource Surface.Hover}" />
        <Border Classes="listrow" Height="42" Background="{DynamicResource Surface.Hover}" />
        <Border Classes="listrow" Height="42" Background="{DynamicResource Surface.Hover}" />
      </StackPanel>
    </Grid>

    <!-- 右栏：正文 + 页面级错误条（契约 §8：右侧，高 32 / 圆角 8 / 宽 ≤ 一半） -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
      <Border Height="32"
              MaxWidth="380"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              CornerRadius="{DynamicResource Radius.Sm}"
              Background="{DynamicResource Surface.Sunken}"
              BorderBrush="{DynamicResource Status.Danger}"
              BorderThickness="1"
              Padding="10,0"
              IsVisible="{Binding ErrorText, Converter={x:Static conv:Converters.HasValue}}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Border Grid.Column="0" Classes="badge danger" VerticalAlignment="Center">
            <TextBlock Text="错误" />
          </Border>
          <TextBlock Grid.Column="1"
                     Classes="caption"
                     Text="{Binding ErrorText}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ErrorText}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="ghost"
                    Height="24"
                    Padding="10,0"
                    Content="重试"
                    Command="{Binding ReloadCommand}" />
            <Button Classes="icon"
                    Width="22" Height="22"
                    ToolTip.Tip="关闭"
                    Command="{Binding DismissErrorCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

    <Border Grid.Row="1" Classes="card">
      <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <!-- 空态：未选中条目时显示（契约：图标 + 一句说明 + 一个动作） -->
        <StackPanel Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNull}}">
          <Path Data="{StaticResource Icon.Search}"
                Stroke="{DynamicResource Text.Muted}"
                StrokeThickness="1.8"
                StrokeLineCap="Round"
                Stretch="Uniform"
                Width="32" Height="32"
                HorizontalAlignment="Center" />
          <TextBlock Text="选择一个帮助条目查看详细说明"
                     Classes="muted"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Classes="pill"
                  Content="查看全部条目"
                  Command="{Binding SelectCategoryCommand}"
                  CommandParameter="全部"
                  HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="0"
                      IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedTopic.Title}" Classes="h3" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="badge">
                <TextBlock Text="{Binding SelectedTopic.Category}" />
              </Border>
              <TextBlock Text="{Binding SelectedTopic.Keywords}"
                         Classes="muted"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Stroke.Subtle}" />
            <SelectableTextBlock Text="{Binding SelectedTopic.Body}"
                                 TextWrapping="Wrap"
                                 LineHeight="22" />
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding StatusText}"
                     Classes="muted"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Grid.Column="1"
                  Classes="pill"
                  Content="重新加载"
                  Command="{Binding ReloadCommand}" />
          <Button Grid.Column="2"
                  Classes="pill"
                  Content="打开日志目录"
                  Command="{Binding OpenLogFolderCommand}" />
        </Grid>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
