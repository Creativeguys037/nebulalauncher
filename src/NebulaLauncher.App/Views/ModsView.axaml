<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NebulaLauncher.ViewModels"
             xmlns:controls="using:NebulaLauncher.Controls"
             xmlns:conv="using:NebulaLauncher.Converters"
             xmlns:views="using:NebulaLauncher.Views"
             x:Class="NebulaLauncher.Views.ModsView"
             x:DataType="vm:ModsViewModel">

  <UserControl.Resources>
    <!-- 模组图标：本地 png 路径 → Bitmap，失败返回 null 让立方体兜底透出来 -->
    <views:PathToImageConverter x:Key="PathToImage" />
  </UserControl.Resources>

  <!--
    内容页外壳 + 模组列表（票 #90）。

    结构与数值逐条取自样板 .oil-ui/nebula-2/explore/mods-glass.html：
      Row0 40  五页签（胶囊 36）+ 右端统计
      Row1 48  搜索 320 + 筛选分段 + 目标下拉 + 从文件安装（ghost）
      Row2 *   玻璃框内唯一滚动条，行高 56、行间距 4、框内边距 8
      Row3 44  批量条（选中 > 0 才出现）

    四条与旧实现的关键差异：
      1. 左栏 212 的常驻目标列表删掉，目标改 Row1 的下拉——1024 档那 212 是纯损失。
      2. 页签用 TabControl（同级视图），筛选用 ToggleButton 组（轻量选中）；
         旧实现用同一个 Button.pill.tab 同时扮演两个角色，违反契约 §6 规则 2。
      3. 列表从「WrapPanel 卡片网格」改成单列行列表：样板的行是一行数据，
         不是一张卡；卡片网格一屏只看得到 4 个，行列表能看到 8 个。
      4. 批量条是 Row3 的一条，不是浮层；删除确认走浮层（DialogOverlay 形态）。
  -->

  <Panel>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

      <!-- ==================== Row0（40）：内容页签 + 统计 ==================== -->
      <Grid Grid.Row="0" Height="40" ColumnDefinitions="*,Auto">

        <!-- 同级视图：模组 / 资源包 / 光影包 / 数据包 / 皮肤。
             皮肤不是 ContentKind 的一员，走 IsSkinTabActive 占位（见 TabIndex 注释）。 -->
        <TabControl Grid.Column="0"
                    Classes="strip"
                    VerticalAlignment="Center"
                    SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
          <TabItem Header="模组" />
          <TabItem Header="资源包" />
          <TabItem Header="光影包" />
          <TabItem Header="数据包" />
          <TabItem Header="皮肤" />
        </TabControl>

        <TextBlock Grid.Column="1"
                   Classes="caption"
                   Text="{Binding StatsText}"
                   Foreground="{DynamicResource Text.Tertiary}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <!-- ==================== Row1（48）：工具条 ==================== -->
      <Grid Grid.Row="1" Height="48" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">

        <!-- 搜索：文本框自带圆角与底色，外层不再套 Border，否则会有两个滚动/描边层 -->
        <TextBox Grid.Column="0"
                 Classes="modsearch"
                 Height="36"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Watermark="{Binding SearchWatermark}"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 CornerRadius="{DynamicResource Radius.Md}" />

        <!-- 筛选：轻量选中（白底蓝字），与实心主色的页签分开 -->
        <Border Grid.Column="1"
                Classes="sunken"
                Padding="3"
                Height="36"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource Radius.Md}">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton Classes="segmented"
                          Content="全部"
                          IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                          Command="{Binding SetFilterCommand}"
                          CommandParameter="{x:Static vm:ModsFilter.All}" />
            <ToggleButton Classes="segmented"
                          Content="已启用"
                          IsChecked="{Binding IsFilterEnabled, Mode=OneWay}"
                          Command="{Binding SetFilterCommand}"
                          CommandParameter="{x:Static vm:ModsFilter.Enabled}" />
            <ToggleButton Classes="segmented"
                          Content="已禁用"
                          IsChecked="{Binding IsFilterDisabled, Mode=OneWay}"
                          Command="{Binding SetFilterCommand}"
                          CommandParameter="{x:Static vm:ModsFilter.Disabled}" />
            <ToggleButton Classes="segmented"
                          Content="可更新"
                          IsChecked="{Binding IsFilterCanUpdate, Mode=OneWay}"
                          IsVisible="{Binding IsModTabActive}"
                          IsEnabled="{Binding HasKnownUpdates}"
                          ToolTip.Tip="从最近一次「检查更新」的结果派生；只在模组页可用"
                          Command="{Binding SetFilterCommand}"
                          CommandParameter="{x:Static vm:ModsFilter.CanUpdate}" />
          </StackPanel>
        </Border>

        <!--
          次要入口（检查更新 / 冲突检测 / 回收站 / 刷新 / 切换全部启用状态）。
          样板 Row1 只有四个元素，没有这些按钮；它们是既有功能，不能因为改版丢失，
          所以收进一个 30×30 的图标按钮，不占视觉重心。
        -->
        <Button Grid.Column="2"
                Classes="icon"
                Width="30" Height="30"
                VerticalAlignment="Center"
                ToolTip.Tip="更多操作">
          <!-- 用文字省略号而不是三点几何：18×18 视口里三个 0.01 长的圆头点在 Uniform 拉伸下会糊成一个点 -->
          <TextBlock Text="…"
                     FontSize="{DynamicResource FontSize.Subtitle}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Text.Secondary}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="检查更新" Command="{Binding CheckUpdatesCommand}" />
              <MenuItem Header="冲突检测" Command="{Binding CheckConflictsCommand}" />
              <MenuItem Header="刷新列表" Command="{Binding RefreshCommand}" />
              <Separator />
              <MenuItem Header="{Binding ToggleAllLabel}" Command="{Binding ToggleAllCommand}" />
              <MenuItem Header="{Binding TrashButtonText}" Command="{Binding ToggleTrashCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- 目标选择器：替代原来的左栏常驻列表 -->
        <ComboBox Grid.Column="3"
                  Classes="modtarget"
                  Height="36"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding AllTargets}"
                  SelectedItem="{Binding SelectedTarget, Mode=OneWay}"
                  SelectionChanged="OnTargetSelectionChanged"
                  CornerRadius="{DynamicResource Radius.Md}"
                  ToolTip.Tip="{Binding TargetDirectory}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TargetItemViewModel">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Path Grid.Column="0"
                      Data="{StaticResource Icon.Folder}"
                      Stroke="{DynamicResource Text.Tertiary}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      Width="14" Height="14" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           Classes="caption"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- 次级行动：ghost，不是实心主色（一屏唯一主行动在 Row3 的「启用」） -->
        <Button Grid.Column="4"
                Classes="ghost"
                Height="36"
                VerticalAlignment="Center"
                Click="OnInstallFromFileClick"
                ToolTip.Tip="把 .jar / .zip 文件复制进当前目标的对应目录">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource Icon.Upload}"
                  Stroke="{DynamicResource Text.Secondary}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="14" Height="14" />
            <TextBlock Text="从文件安装" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- ==================== Row2（*）：内容框 ==================== -->
      <controls:GlassPanel Grid.Row="2" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Panel Margin="8">

            <!-- 列表：行高 56、间距 4。一屏 8 行（(509−16)/60 ≈ 8.2） -->
            <ItemsControl ItemsSource="{Binding Items}"
                          IsVisible="{Binding IsContentViewActive}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContentCardViewModel">
                  <Border Classes="listrow"
                          Classes.compact="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).IsCompactRowKind}"
                          Classes.selected="{Binding IsChecked}"
                          ToolTip.Tip="{Binding ToolTipText}">

                    <!-- 右键菜单：批量动作之外的单条动作都在这里，行内只留一个图标按钮 -->
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="打开所在文件夹"
                                  Command="{Binding Owner.RevealCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="去资源站查找"
                                  Command="{Binding Owner.LookupInLibraryCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="在 MC 百科搜索"
                                  Command="{Binding Owner.SearchMcmodCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="复制文件名"
                                  Command="{Binding Owner.CopyFileNameCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="复制完整路径"
                                  Command="{Binding Owner.CopyPathCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="启用 / 禁用"
                                  Command="{Binding Owner.ToggleEnabledCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="删除…"
                                  Command="{Binding Owner.RequestDeleteCommand}"
                                  CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Border.ContextMenu>

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12">

                      <!-- 勾选 = 参与批量操作，与右侧「启用」开关是两件事 -->
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).IsBatchBusy, Converter={x:Static conv:Converters.InverseBool}}"
                                ToolTip.Tip="勾选后参与批量启用 / 禁用 / 删除" />

                      <!-- 图标：有真实项目图标就显示，没有用稳定的立方体几何兜底 -->
                      <Border Grid.Column="1"
                                Classes="rowicon"
                                Classes.small="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).IsCompactRowKind}"
                                VerticalAlignment="Center">
                        <Panel>
                          <Path Data="{StaticResource Icon.Mod}"
                                Stroke="{DynamicResource Accent.Primary}"
                                StrokeThickness="1.8"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Stretch="Uniform"
                                Width="17" Height="17"
                                IsVisible="{Binding !HasIcon}" />
                          <Image Source="{Binding DisplayIconPath, Converter={StaticResource PathToImage}}"
                                 Stretch="UniformToFill"
                                 IsVisible="{Binding HasIcon}" />
                        </Panel>
                      </Border>

                      <!-- 主名 13（Body）/ 副行 11（Caption）：样板 .row .rn 的口径 -->
                      <StackPanel Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding TitleText}" />
                        <TextBlock Text="{Binding DetailText}"
                                   Classes="caption"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <!-- 行尾徽标：可更新 / 已禁用 / 解析失败 -->
                      <Border Grid.Column="3"
                              Classes="badge warning"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasPendingUpdate}">
                        <TextBlock Text="可更新" />
                      </Border>

                      <Border Grid.Column="3"
                              Classes="badge"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasParseError}"
                              ToolTip.Tip="{Binding ParseErrorText}">
                        <TextBlock Text="解析失败" Foreground="{DynamicResource Status.Danger}" />
                      </Border>

                      <Border Grid.Column="3"
                              Classes="badge"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !IsEnabled}">
                        <TextBlock Text="已禁用" Foreground="{DynamicResource Text.Tertiary}" />
                      </Border>

                      <ToggleSwitch Grid.Column="4"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    OnContent="{x:Null}"
                                    OffContent="{x:Null}"
                                    MinWidth="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="启用 / 禁用" />

                      <!-- 行内动作只有一个：打开目录（样板 .ract 只放 .ibtn） -->
                      <Button Grid.Column="5"
                              Classes="icon"
                              Width="30" Height="30"
                              VerticalAlignment="Center"
                              ToolTip.Tip="打开所在目录"
                              Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).RevealCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="{StaticResource Icon.Folder}"
                              Stroke="{DynamicResource Text.Secondary}"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="Uniform"
                              Width="15" Height="15" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空态：图标 48 + 一句说明 + 一个动作，框内居中 -->
            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320"
                        Spacing="10">
              <Border Width="48" Height="48"
                      CornerRadius="{DynamicResource Radius.Md}"
                      Background="{DynamicResource Surface.CardSolid}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource Stroke.Subtle}"
                      HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Mod}"
                      Stroke="{DynamicResource Text.Tertiary}"
                      StrokeThickness="1.6"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      Width="24" Height="24" />
              </Border>
              <TextBlock Text="{Binding EmptyTitle}"
                         Classes="h3"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
              <TextBlock Text="{Binding EmptyHint}"
                         Classes="caption"
                         Foreground="{DynamicResource Text.Tertiary}"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         LineHeight="17" />
              <Button Classes="accent"
                      HorizontalAlignment="Center"
                      Content="从文件安装"
                      Click="OnInstallFromFileClick" />

              <!-- 数据包还有一条出路：它们是资源站上的项目，本地目录空了可以去搜（票 #91） -->
              <Button Classes="ghost"
                      HorizontalAlignment="Center"
                      Content="去资源页找数据包"
                      IsVisible="{Binding IsDataPackEmpty}"
                      Command="{Binding OpenLibraryForDataPacksCommand}" />
            </StackPanel>

            <!-- 加载态：4 条骨架，行高与真实行一致 -->
            <StackPanel IsVisible="{Binding IsLoading}" Spacing="4">
              <Border Classes="listrow" Height="56" Background="{DynamicResource Surface.Hover}" />
              <Border Classes="listrow" Height="56" Background="{DynamicResource Surface.Hover}" />
              <Border Classes="listrow" Height="56" Background="{DynamicResource Surface.Hover}" />
              <Border Classes="listrow" Height="56" Background="{DynamicResource Surface.Hover}" />
            </StackPanel>

            <!-- 皮肤占位：本票只留外框，完整换肤流程见 #92 -->
            <StackPanel IsVisible="{Binding IsSkinTabActive}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320"
                        Spacing="10">
              <Border Width="48" Height="48"
                      CornerRadius="{DynamicResource Radius.Md}"
                      Background="{DynamicResource Surface.CardSolid}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource Stroke.Subtle}"
                      HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Account}"
                      Stroke="{DynamicResource Text.Tertiary}"
                      StrokeThickness="1.6"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      Width="24" Height="24" />
              </Border>
              <TextBlock Text="皮肤不在这五个分类里"
                         Classes="h3"
                         HorizontalAlignment="Center"
                         TextAlignment="Center" />
              <TextBlock Text="皮肤有独立的来源、体型与 3D 预览流程，网格与固定 300 的预览列放不进这一格。"
                         Classes="caption"
                         Foreground="{DynamicResource Text.Tertiary}"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         LineHeight="17" />

              <Button Classes="accent"
                      HorizontalAlignment="Center"
                      Content="打开皮肤页"
                      Command="{Binding OpenSkinPageCommand}" />
            </StackPanel>
          </Panel>
        </ScrollViewer>
      </controls:GlassPanel>

      <!-- ==================== Row3（44）：批量条 / 结果条 ==================== -->
      <Grid Grid.Row="3" Height="44">

        <!-- 批量条：有选中才出现 -->
        <Border IsVisible="{Binding HasSelection}"
                Padding="12,0"
                CornerRadius="{DynamicResource Radius.Md}"
                Background="{DynamicResource Surface.Sunken}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Stroke.Subtle}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Classes="caption"
                       FontWeight="SemiBold"
                       Text="{Binding SelectionSummary}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Classes="ghost"
                    Height="28"
                    Padding="8,0"
                    Content="全选"
                    Command="{Binding SelectAllCommand}" />

            <Button Grid.Column="2"
                    Classes="ghost"
                    Height="28"
                    Padding="8,0"
                    Content="清除选择"
                    Command="{Binding ClearSelectionCommand}" />

            <Button Grid.Column="4"
                    Classes="accent"
                    Height="30"
                    Content="启用"
                    IsEnabled="{Binding CanBatch}"
                    Command="{Binding EnableSelectedCommand}" />

            <Button Grid.Column="5"
                    Classes="ghost"
                    Height="30"
                    Content="禁用"
                    IsEnabled="{Binding CanBatch}"
                    Command="{Binding DisableSelectedCommand}" />

            <Button Grid.Column="6"
                    Classes="danger"
                    Height="30"
                    Content="删除"
                    IsEnabled="{Binding CanBatch}"
                    Command="{Binding RequestBatchDeleteCommand}" />
          </Grid>
        </Border>

        <!-- 结果条：与批量条同格，互斥显示 -->
        <Border IsVisible="{Binding HasBatchResult}"
                Padding="12,0"
                CornerRadius="{DynamicResource Radius.Md}"
                Background="{DynamicResource Surface.Sunken}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Stroke.Subtle}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Classes="caption"
                       FontWeight="SemiBold"
                       Text="{Binding BatchResultText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1"
                       Classes="caption"
                       Foreground="{DynamicResource Status.Danger}"
                       Text="{Binding BatchFailureText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasBatchFailures}" />

            <Button Grid.Column="2"
                    Classes="icon"
                    Width="26" Height="26"
                    VerticalAlignment="Center"
                    ToolTip.Tip="关闭结果"
                    Command="{Binding ClearBatchResultCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </Grid>
        </Border>

        <!-- 页面级错误：同一格，优先级最高 -->
        <Border IsVisible="{Binding HasError}"
                Padding="12,0"
                CornerRadius="{DynamicResource Radius.Md}"
                Background="{DynamicResource Surface.Sunken}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Status.Danger}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Classes="caption"
                       Foreground="{DynamicResource Status.Danger}"
                       Text="{Binding ErrorText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Width="26" Height="26"
                    VerticalAlignment="Center"
                    ToolTip.Tip="关闭"
                    Click="OnDismissErrorClick">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ==================== 浮层：批量删除确认 ==================== -->
    <Panel IsVisible="{Binding IsBatchDeleteConfirmOpen}">
      <Border Background="{DynamicResource Surface.Scrim}" />

      <Border Width="420"
              Padding="20"
              CornerRadius="{DynamicResource Radius.Xl}"
              Background="{DynamicResource Surface.CardSolid}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Default}"
              BoxShadow="{DynamicResource Shadow.Overlay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="删除选中的内容？"
                     Classes="h3" />

          <TextBlock Text="{Binding BatchDeleteSummary}"
                     Classes="caption"
                     Foreground="{DynamicResource Text.Tertiary}"
                     TextWrapping="Wrap"
                     LineHeight="17" />

          <Border Classes="sunken" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding BatchDeleteListText}"
                         Classes="mono"
                         TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>

          <CheckBox Content="永久删除（不进回收站）"
                    IsChecked="{Binding BatchDeletePermanent, Mode=TwoWay}" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Classes="ghost"
                    Content="取消"
                    Command="{Binding CancelBatchDeleteCommand}" />
            <Button Classes="danger"
                    Content="删除"
                    IsEnabled="{Binding CanBatch}"
                    Command="{Binding ConfirmBatchDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- ==================== 浮层：单条删除确认 ==================== -->
    <Panel IsVisible="{Binding HasPendingDelete}">
      <Border Background="{DynamicResource Surface.Scrim}" />

      <Border Width="420"
              Padding="20"
              CornerRadius="{DynamicResource Radius.Xl}"
              Background="{DynamicResource Surface.CardSolid}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Default}"
              BoxShadow="{DynamicResource Shadow.Overlay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="删除这个内容？"
                     Classes="h3" />

          <TextBlock Text="{Binding PendingDelete.TitleText}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <TextBlock Text="删除默认进回收站，可以恢复。依赖该项的整合包记录会同时失效。"
                     Classes="caption"
                     Foreground="{DynamicResource Text.Tertiary}"
                     TextWrapping="Wrap"
                     LineHeight="17" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Classes="ghost"
                    Content="取消"
                    Command="{Binding CancelDeleteCommand}" />
            <Button Classes="ghost"
                    Content="永久删除"
                    Command="{Binding ConfirmDeletePermanentCommand}" />
            <Button Classes="danger"
                    Content="删除"
                    Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- ==================== 浮层：回收站 ==================== -->
    <Panel IsVisible="{Binding IsTrashOpen}">
      <Border Background="{DynamicResource Surface.Scrim}" />

      <Border Width="520"
              MaxHeight="440"
              Padding="20"
              CornerRadius="{DynamicResource Radius.Xl}"
              Background="{DynamicResource Surface.CardSolid}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Default}"
              BoxShadow="{DynamicResource Shadow.Overlay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="回收站" Classes="h3" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Width="26" Height="26"
                    ToolTip.Tip="关闭"
                    Command="{Binding ToggleTrashCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <Border Classes="toneBar danger"
                      IsVisible="{Binding HasTrashError}">
                <TextBlock Text="{Binding TrashError}" Classes="caption" TextWrapping="Wrap" />
              </Border>

              <ItemsControl ItemsSource="{Binding TrashEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContentTrashRow">
                    <Border Classes="listrow" MinHeight="40" ToolTip.Tip="{Binding OriginalPath}">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding MetaText}"
                                     Classes="caption"
                                     Foreground="{DynamicResource Text.Tertiary}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Height="26" Content="恢复"
                                Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).RestoreTrashCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="ghost" Height="26" Content="彻底删除"
                                Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).PurgeTrashCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding TrashSummary}"
                         Classes="caption"
                         Foreground="{DynamicResource Text.Tertiary}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>

    <!-- ==================== 浮层：更新结果 ==================== -->
    <Panel IsVisible="{Binding HasUpdates}">
      <Border Background="{DynamicResource Surface.Scrim}" />

      <Border Width="560"
              MaxHeight="480"
              Padding="20"
              CornerRadius="{DynamicResource Radius.Xl}"
              Background="{DynamicResource Surface.CardSolid}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Stroke.Default}"
              BoxShadow="{DynamicResource Shadow.Overlay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="更新检查" Classes="h3" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Width="26" Height="26"
                    ToolTip.Tip="关闭"
                    Command="{Binding CloseUpdatesCommand}">
              <Path Data="{StaticResource Icon.Close}"
                    Stroke="{DynamicResource Text.Tertiary}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="11" Height="11" />
            </Button>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{Binding UpdateSummary}"
                       Classes="caption"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding UpdateError}"
                       Classes="caption"
                       Foreground="{DynamicResource Status.Danger}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasUpdateError}" />
          </StackPanel>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Updates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModUpdateRowViewModel">
                  <Border Classes="listrow" MinHeight="40">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DetailText}"
                                   Classes="caption"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>
  </Panel>
</UserControl>