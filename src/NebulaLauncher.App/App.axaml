<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NebulaLauncher"
             x:Class="NebulaLauncher.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NebulaLauncher/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://NebulaLauncher/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        UI 字体栈：嵌入字体，西文/数字走 Mojang，缺字（含全部汉字）回退安托圆黑。
        字体令牌由 Themes/Tokens.axaml 的根级定义提供，运行期不再按平台覆盖：
        平台分支会让嵌入字体静默失效（用户看到「改了字体但界面没变」）。见 #103。
      -->
      <FontFamily x:Key="Font.UI">avares://NebulaLauncher/Assets/Fonts#Mojang, avares://NebulaLauncher/Assets/Fonts#AFYuanheiCS</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://NebulaLauncher/Themes/Controls.axaml" />
  </Application.Styles>

</Application>
