<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    设计令牌（Design Tokens）— Nebula 2.0 液态玻璃规范。

    规则：页面与控件一律通过 {DynamicResource ...} 取用，禁止写死颜色字面量。
    命名分三层：palette.<色名> → surface/text/accent 语义层 → 组件层直接引用语义层。

    双主题结构（Avalonia 11 ThemeDictionaries）：
    - 语义层（Surface.* / Glass.* / Stroke.* / Text.* / Accent.* / Status.* / Gradient.* / Shadow.*）
      在 Dark 与 Light 两个字典里各写一份，**键名必须完全一致**，否则切主题时页面会掉资源。
    - 主题字典内部一律写字面色值：主题字典是独立资源作用域，引用外层 Palette.* 依赖
      解析顺序，容易在运行期变成「找不到静态资源」。Palette 只作为命名对照表保留。
    - 非颜色令牌（圆角 / 字号 / 字重 / 动效时长）与主题无关，留在字典根部。

    旧键零删除：Accent.Secondary / Accent.Tertiary / Gradient.Aurora / Gradient.CardOverlay /
    Memory.* / Radius.Xs 等全部保留键名，只换值，避免页面引用断裂。
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ==================== 深色（黑红玻璃：近黑底、红强调、白副色） ==================== -->
    <ResourceDictionary x:Key="Dark">

      <!-- 表面 -->
      <SolidColorBrush x:Key="Surface.Base" Color="#0A0205" />
      <SolidColorBrush x:Key="Surface.Canvas" Color="#0F0407" />
      <SolidColorBrush x:Key="Surface.Card" Color="#0FE80018" />
      <SolidColorBrush x:Key="Surface.CardSolid" Color="#1A0810" />
      <SolidColorBrush x:Key="Surface.Raised" Color="#1A0810" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#1FE80018" />
      <SolidColorBrush x:Key="Surface.Pressed" Color="#29E80018" />
      <SolidColorBrush x:Key="Surface.Sunken" Color="#140305" />
      <SolidColorBrush x:Key="Surface.Glass" Color="#14E80018" />
      <SolidColorBrush x:Key="Surface.Sidebar" Color="#12050A" />
      <!-- 导航 hover：深色是白 8%，浅色是白 70%（票 #85） -->
      <SolidColorBrush x:Key="Surface.NavHover" Color="#14FFFAFA" />
      <!-- 背景层色块：硬边圆形，深色红黑、浅色蓝白（票 #85） -->
      <SolidColorBrush x:Key="Surface.BackdropBlob1" Color="#1FE80018" />
      <SolidColorBrush x:Key="Surface.BackdropBlob2" Color="#14B53131" />
      <SolidColorBrush x:Key="Surface.BackdropBlob3" Color="#0FFFFAFA" />

      <!-- 玻璃组：tint 底、edge 亮边、topLight 顶亮线、innerShadow 底内阴影、shadow 外投影 -->
      <SolidColorBrush x:Key="Glass.Tint" Color="#0FE80018" />
      <SolidColorBrush x:Key="Glass.Edge" Color="#2EB53131" />
      <SolidColorBrush x:Key="Glass.TopLight" Color="#14FFFAFA" />
      <SolidColorBrush x:Key="Glass.InnerShadow" Color="#66000000" />
      <SolidColorBrush x:Key="Glass.Shadow" Color="#99000000" />

      <!-- 描边 -->
      <SolidColorBrush x:Key="Stroke.Subtle" Color="#14FFFAFA" />
      <SolidColorBrush x:Key="Stroke.Default" Color="#24FFFAFA" />
      <SolidColorBrush x:Key="Stroke.Strong" Color="#3DFFFAFA" />
      <SolidColorBrush x:Key="Stroke.Focus" Color="#E80018" />

      <!-- 文字 -->
      <SolidColorBrush x:Key="Text.Primary" Color="#FFFAFA" />
      <SolidColorBrush x:Key="Text.Secondary" Color="#F0F0F0" />
      <SolidColorBrush x:Key="Text.Tertiary" Color="#DBD6D2" />
      <SolidColorBrush x:Key="Text.Muted" Color="#80DBD6D2" />
      <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFAFA" />
      <SolidColorBrush x:Key="Text.OnBrand" Color="#FFFAFA" />

      <!-- 强调：主行动只用 Primary 红，品牌红只做装饰与渐变尾 -->
      <SolidColorBrush x:Key="Accent.Primary" Color="#E80018" />
      <SolidColorBrush x:Key="Accent.Brand" Color="#B53131" />
      <SolidColorBrush x:Key="Accent.Secondary" Color="#B53131" />
      <SolidColorBrush x:Key="Accent.Tertiary" Color="#22D3EE" />
      <SolidColorBrush x:Key="Accent.Soft" Color="#1FE80018" />
      <SolidColorBrush x:Key="Accent.Glow" Color="#40E80018" />

      <!-- 状态 -->
      <SolidColorBrush x:Key="Status.Success" Color="#34D399" />
      <SolidColorBrush x:Key="Status.Warning" Color="#FBBF24" />
      <SolidColorBrush x:Key="Status.Danger" Color="#B53131" />
      <SolidColorBrush x:Key="Status.Info" Color="#22D3EE" />
      <SolidColorBrush x:Key="Status.Success.Soft" Color="#1F34D399" />
      <SolidColorBrush x:Key="Status.Warning.Soft" Color="#1FFBBF24" />
      <SolidColorBrush x:Key="Status.Danger.Soft" Color="#1FB53131" />
      <SolidColorBrush x:Key="Status.Danger.Edge" Color="#4DB53131" />

      <!--
        内存三段条（设置页「游戏启动参数」）。
        单独一组令牌而不是直接复用 Status.Warning / Accent.Primary：条是三个色块并排，
        并排时的可读性由三者的相对亮度决定，将来调色只动这里，不影响状态徽标。
      -->
      <SolidColorBrush x:Key="Memory.BarFree" Color="#33FFFAFA" />
      <SolidColorBrush x:Key="Memory.BarUsed" Color="#B3FBBF24" />
      <SolidColorBrush x:Key="Memory.BarGame" Color="#B3E80018" />

      <!-- 渐变 -->
      <!-- 窗口底：152° 渐变（StartPoint→EndPoint 约 47%,88% 即为 CSS 152deg 方向） -->
      <LinearGradientBrush x:Key="Gradient.Canvas" StartPoint="0%,0%" EndPoint="47%,88%">
        <GradientStop Color="#0A0205" Offset="0" />
        <GradientStop Color="#1A0810" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.Accent" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#E80018" Offset="0" />
        <GradientStop Color="#B53131" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.Progress" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#E80018" Offset="0" />
        <GradientStop Color="#FF6B6B" Offset="1" />
      </LinearGradientBrush>

      <!-- 装饰渐变：保留旧键名，换新方向（红 → 品牌红） -->
      <LinearGradientBrush x:Key="Gradient.Aurora" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#E80018" Offset="0" />
        <GradientStop Color="#B53131" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.Sheen" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.CardOverlay" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#12FFFAFA" Offset="0" />
        <GradientStop Color="#00FFFAFA" Offset="1" />
      </LinearGradientBrush>

      <!-- 阴影 -->
      <BoxShadows x:Key="Shadow.Card">0 2 8 0 #66000000</BoxShadows>
      <BoxShadows x:Key="Shadow.CardHover">0 10 28 -6 #99000000</BoxShadows>
      <BoxShadows x:Key="Shadow.Overlay">0 26 60 -12 #B3000000</BoxShadows>
      <BoxShadows x:Key="Shadow.Glow">0 0 24 0 #40E80018</BoxShadows>
      <!-- inset 语法不带 px：inset 0 2 0 可解析，inset 0 2px 0 抛 FormatException -->
      <BoxShadows x:Key="Shadow.Glass">inset 0 2 0 #14FFFAFA, inset 0 -16 30 -16 #66000000, 0 26 60 -12 #99000000</BoxShadows>

      <!-- 组件层 -->
      <SolidColorBrush x:Key="Scrollbar.Thumb" Color="#40FFFAFA" />
      <SolidColorBrush x:Key="Window.CloseHover" Color="#B53131" />

    </ResourceDictionary>

    <!--
      ==================== 浅色（蓝白玻璃：浅蓝底、白承载、黑副色） ====================
      目标：背景 #E8F0FF 系（不是纯白），卡片白 70% + 细描边，文字 #0A0D14 系四档。
    -->
    <ResourceDictionary x:Key="Light">

      <!-- 表面 -->
      <SolidColorBrush x:Key="Surface.Base" Color="#E8F0FF" />
      <SolidColorBrush x:Key="Surface.Canvas" Color="#F7FAFF" />
      <SolidColorBrush x:Key="Surface.Card" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="Surface.CardSolid" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface.Raised" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#F0F4FF" />
      <SolidColorBrush x:Key="Surface.Pressed" Color="#E2EAFC" />
      <SolidColorBrush x:Key="Surface.Sunken" Color="#E9EFFC" />
      <SolidColorBrush x:Key="Surface.Glass" Color="#57FFFFFF" />
      <SolidColorBrush x:Key="Surface.Sidebar" Color="#EDF3FF" />
      <SolidColorBrush x:Key="Surface.NavHover" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="Surface.BackdropBlob1" Color="#1A1668FF" />
      <SolidColorBrush x:Key="Surface.BackdropBlob2" Color="#4DFFFFFF" />
      <SolidColorBrush x:Key="Surface.BackdropBlob3" Color="#241668FF" />

      <!-- 玻璃组 -->
      <SolidColorBrush x:Key="Glass.Tint" Color="#57FFFFFF" />
      <SolidColorBrush x:Key="Glass.Edge" Color="#DBFFFFFF" />
      <SolidColorBrush x:Key="Glass.TopLight" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Glass.InnerShadow" Color="#47103078" />
      <SolidColorBrush x:Key="Glass.Shadow" Color="#38103078" />

      <!-- 描边：冷灰系，Focus 走品牌蓝 -->
      <SolidColorBrush x:Key="Stroke.Subtle" Color="#140F1724" />
      <SolidColorBrush x:Key="Stroke.Default" Color="#240F1724" />
      <SolidColorBrush x:Key="Stroke.Strong" Color="#3D0F1724" />
      <SolidColorBrush x:Key="Stroke.Focus" Color="#1668FF" />

      <!-- 文字 -->
      <SolidColorBrush x:Key="Text.Primary" Color="#0A0D14" />
      <SolidColorBrush x:Key="Text.Secondary" Color="#39445A" />
      <SolidColorBrush x:Key="Text.Tertiary" Color="#6B7891" />
      <SolidColorBrush x:Key="Text.Muted" Color="#8A93A6" />
      <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Text.OnBrand" Color="#FFFAFA" />

      <!-- 强调：浅色只蓝，品牌红是装饰色 -->
      <SolidColorBrush x:Key="Accent.Primary" Color="#1668FF" />
      <SolidColorBrush x:Key="Accent.Brand" Color="#B53131" />
      <SolidColorBrush x:Key="Accent.Secondary" Color="#B53131" />
      <SolidColorBrush x:Key="Accent.Tertiary" Color="#0891B2" />
      <SolidColorBrush x:Key="Accent.Soft" Color="#1A1668FF" />
      <SolidColorBrush x:Key="Accent.Glow" Color="#401668FF" />

      <!-- 状态 -->
      <SolidColorBrush x:Key="Status.Success" Color="#0B7A57" />
      <SolidColorBrush x:Key="Status.Warning" Color="#92400E" />
      <SolidColorBrush x:Key="Status.Danger" Color="#C42020" />
      <SolidColorBrush x:Key="Status.Info" Color="#0E7490" />
      <SolidColorBrush x:Key="Status.Success.Soft" Color="#140B7A57" />
      <SolidColorBrush x:Key="Status.Warning.Soft" Color="#1492400E" />
      <SolidColorBrush x:Key="Status.Danger.Soft" Color="#14C42020" />
      <SolidColorBrush x:Key="Status.Danger.Edge" Color="#4DC42020" />

      <!-- 内存三段条：浅底上黄色/蓝色都要压深一档，否则三块糊成一片 -->
      <SolidColorBrush x:Key="Memory.BarFree" Color="#2E0A0D14" />
      <SolidColorBrush x:Key="Memory.BarUsed" Color="#B392400E" />
      <SolidColorBrush x:Key="Memory.BarGame" Color="#B31668FF" />

      <!-- 渐变 -->
      <LinearGradientBrush x:Key="Gradient.Canvas" StartPoint="0%,0%" EndPoint="47%,88%">
        <GradientStop Color="#E8F0FF" Offset="0" />
        <GradientStop Color="#C9DCFF" Offset="0.33" />
        <GradientStop Color="#A8C6FF" Offset="0.66" />
        <GradientStop Color="#8FB4FF" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.Accent" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#1668FF" Offset="0" />
        <GradientStop Color="#0B3FCC" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.Progress" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#1668FF" Offset="0" />
        <GradientStop Color="#37D6FF" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.Aurora" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#1668FF" Offset="0" />
        <GradientStop Color="#37D6FF" Offset="1" />
      </LinearGradientBrush>

      <!-- 浅色底上的「高光」是深色极淡涂层，白色 sheen 在浅色背景上完全不可见 -->
      <LinearGradientBrush x:Key="Gradient.Sheen" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#000F1724" Offset="0" />
        <GradientStop Color="#120F1724" Offset="0.5" />
        <GradientStop Color="#000F1724" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="Gradient.CardOverlay" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#080F1724" Offset="0" />
        <GradientStop Color="#000F1724" Offset="1" />
      </LinearGradientBrush>

      <!-- 阴影：深色底上的黑投影在白底上会发脏，改成低 alpha 的墨蓝 -->
      <BoxShadows x:Key="Shadow.Card">0 2 8 0 #140F1724</BoxShadows>
      <BoxShadows x:Key="Shadow.CardHover">0 10 24 -6 #1F0F1724</BoxShadows>
      <BoxShadows x:Key="Shadow.Overlay">0 26 60 -12 #38103078</BoxShadows>
      <BoxShadows x:Key="Shadow.Glow">0 0 24 0 #331668FF</BoxShadows>
      <BoxShadows x:Key="Shadow.Glass">inset 0 2 0 #FFFFFF, inset 0 -16 30 -16 #47103078, 0 26 60 -12 #38103078</BoxShadows>

      <!-- 组件层 -->
      <SolidColorBrush x:Key="Scrollbar.Thumb" Color="#33000000" />
      <SolidColorBrush x:Key="Window.CloseHover" Color="#E81123" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!--
    ============ 基础色板（两套主题共用的命名对照表） ============
    主题字典里写字面色值，这里只记录色名与品牌色，改品牌色需要同时改两个字典里的引用值。
  -->
  <Color x:Key="Palette.Ink900">#05070C</Color>
  <Color x:Key="Palette.Ink850">#080B12</Color>
  <Color x:Key="Palette.Ink800">#0B0F18</Color>
  <Color x:Key="Palette.Ink750">#10151F</Color>
  <Color x:Key="Palette.Ink700">#151B27</Color>
  <Color x:Key="Palette.Ink650">#1A2130</Color>
  <Color x:Key="Palette.Ink600">#212A3B</Color>
  <Color x:Key="Palette.Ink500">#2C3648</Color>
  <Color x:Key="Palette.Ink400">#3D4A60</Color>

  <Color x:Key="Palette.Slate300">#8B97AB</Color>
  <Color x:Key="Palette.Slate200">#AEB9CA</Color>
  <Color x:Key="Palette.Slate100">#D7DEE9</Color>
  <Color x:Key="Palette.Snow">#FFFAFA</Color>

  <Color x:Key="Palette.Blue">#1668FF</Color>
  <Color x:Key="Palette.BlueBright">#6E8BFF</Color>
  <Color x:Key="Palette.Red">#E80018</Color>
  <Color x:Key="Palette.Brand">#B53131</Color>
  <!-- Palette.Violet / VioletDeep：Nebula 2.0 起不再使用紫系，键保留只为不打断旧引用。 -->
  <Color x:Key="Palette.Violet">#A855F7</Color>
  <Color x:Key="Palette.Cyan">#22D3EE</Color>
  <Color x:Key="Palette.Mint">#34D399</Color>
  <Color x:Key="Palette.Amber">#FBBF24</Color>
  <Color x:Key="Palette.Rose">#FB7185</Color>

  <Color x:Key="Palette.Mist">#E8F0FF</Color>
  <Color x:Key="Palette.MistDeep">#EDF3FF</Color>
  <Color x:Key="Palette.Navy">#0A0D14</Color>
  <Color x:Key="Palette.BlueDeep">#0B3FCC</Color>
  <!-- Palette.VioletDeep：同上，已废弃但保留键。 -->
  <Color x:Key="Palette.VioletDeep">#7C3AED</Color>

  <!--
    ToolTip 的底色：两套主题都是同一个近黑，不跟随主题。
    放在根部而不是主题字典：它是固定语义（黑底白字的高对比气泡），
    深色下换成别的颜色反而会和页面玻璃层混在一起。
  -->
  <SolidColorBrush x:Key="Surface.Tooltip" Color="#0A0D14" />

  <!-- 对话框遮罩：黑 40%，两套主题一致；深色下再深就会和背景糊成一片。 -->
  <SolidColorBrush x:Key="Surface.Scrim" Color="#66000000" />

  <!-- ============ 圆角 ============ -->
  <CornerRadius x:Key="Radius.Xs">4</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">8</CornerRadius>
  <CornerRadius x:Key="Radius.Md">12</CornerRadius>
  <CornerRadius x:Key="Radius.Lg">16</CornerRadius>
  <CornerRadius x:Key="Radius.Xl">20</CornerRadius>
  <CornerRadius x:Key="Radius.X2l">24</CornerRadius>
  <CornerRadius x:Key="Radius.X3l">28</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <!-- ============ 间距（Thickness 直接内联使用，此处仅列数值刻度）
       4 / 8 / 12 / 16 / 20 / 24 / 32 / 40 ============ -->

  <!-- ============ 字体 ============ -->
  <x:Double x:Key="FontSize.Caption">11</x:Double>
  <x:Double x:Key="FontSize.Small">12</x:Double>
  <x:Double x:Key="FontSize.Body">13</x:Double>
  <x:Double x:Key="FontSize.BodyLg">15</x:Double>
  <x:Double x:Key="FontSize.Subtitle">17</x:Double>
  <x:Double x:Key="FontSize.Title">20</x:Double>
  <x:Double x:Key="FontSize.Headline">26</x:Double>
  <x:Double x:Key="FontSize.Display">29</x:Double>
  <x:Double x:Key="FontSize.DisplayLg">38</x:Double>

  <!-- ============ 动效时长（毫秒），与 C# 侧 Motion.cs 的 TimeSpan 字段保持同值 ============ -->
  <x:Double x:Key="Motion.Instant">90</x:Double>
  <x:Double x:Key="Motion.Fast">150</x:Double>
  <x:Double x:Key="Motion.Normal">220</x:Double>
  <x:Double x:Key="Motion.Slow">320</x:Double>
  <x:Double x:Key="Motion.Loop">1400</x:Double>

</ResourceDictionary>
