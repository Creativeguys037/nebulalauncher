<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    线性图标资源字典（Nebula 2.0）。

    约定：全部 24×24 视口、圆头圆角、线宽 1.8，只存几何不存画笔；
    使用处自己给 Stroke / StrokeThickness，颜色跟随主题：

      <Path Data="{StaticResource Icon.Home}"
            Stroke="{DynamicResource Text.Tertiary}"
            StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
            Stretch="Uniform" Width="20" Height="20" />

    图标名按语义命名，新图标追加到这里，不再散落在页面或 NavigationItem 常量里。
  -->

  <!-- 主页：屋顶 + 门窗 -->
  <StreamGeometry x:Key="Icon.Home">M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z</StreamGeometry>

  <!-- 版本：立方体 + 三条棱 -->
  <StreamGeometry x:Key="Icon.Versions">M12 2.5 21 7v10l-9 4.5L3 17V7zM12 12l9-5M12 12v9.5M12 12 3 7</StreamGeometry>

  <!-- 内容：三层书脊 -->
  <StreamGeometry x:Key="Icon.Content">M4 4v16M8.5 4v16M13 4l3.6 15.4M18.5 5.4 21 4.4</StreamGeometry>

  <!-- 下载：向下箭头 + 托盘 -->
  <StreamGeometry x:Key="Icon.Download">M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M4 17v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3</StreamGeometry>

  <!-- 账户：头肩轮廓 -->
  <StreamGeometry x:Key="Icon.Account">M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4.5 21a7.5 7.5 0 0 1 15 0</StreamGeometry>

  <!-- 服务器：两层机箱 + 指示灯 -->
  <StreamGeometry x:Key="Icon.Server">M4 6h16v5H4zM4 13h16v5H4zM7.5 8.5h.01M7.5 15.5h.01</StreamGeometry>

  <!-- 设置：齿轮 -->
  <StreamGeometry x:Key="Icon.Settings">M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z</StreamGeometry>

  <!-- 窗口按钮：最小化 / 最大化 / 关闭（不使用字体图标） -->
  <StreamGeometry x:Key="Icon.WindowMinimize">M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.WindowMaximize">M6.5 6.5h11v11h-11z</StreamGeometry>
  <StreamGeometry x:Key="Icon.WindowClose">M6 6l12 12M18 6 6 18</StreamGeometry>
  
  <!-- 复制：两张错位的方框 -->
  <StreamGeometry x:Key="Icon.Copy">M9 9V6.5A1.5 1.5 0 0 1 10.5 5h7A1.5 1.5 0 0 1 19 6.5v7a1.5 1.5 0 0 1-1.5 1.5H15M5 9.5A1.5 1.5 0 0 1 6.5 8h7A1.5 1.5 0 0 1 15 9.5v7a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 5 16.5z</StreamGeometry>

  <!-- 搜索：放大镜（票 #107 主页搜索框） -->
  <StreamGeometry x:Key="Icon.Search">M4 10.5a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0ZM15.2 15.2 21 21</StreamGeometry>

  <!-- 世界：球体 + 经线（票 #89 世界分区空态） -->
  <StreamGeometry x:Key="Icon.World">M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0ZM3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18</StreamGeometry>

  <!-- 关闭：可关闭结果条 / 提示（不与 Icon.WindowClose 复用：那是窗口按钮语义） -->
  <StreamGeometry x:Key="Icon.Close">M6 6l12 12M18 6 6 18</StreamGeometry>

  <!-- 备份：向下箭头 + 托盘（票 #89 世界行） -->
  <StreamGeometry x:Key="Icon.Backup">M12 3v10m0 0 3.5-3.5M12 13l-3.5-3.5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3</StreamGeometry>

  <!-- 还原：逆时针回环箭头 -->
  <StreamGeometry x:Key="Icon.Restore">M4 12a8 8 0 1 0 2.4-5.7M4 5v5h5</StreamGeometry>

  <!-- 打开目录：文件夹轮廓 -->
  <StreamGeometry x:Key="Icon.Folder">M3 7a1 1 0 0 1 1-1h5l2 2h8a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z</StreamGeometry>

</ResourceDictionary>
