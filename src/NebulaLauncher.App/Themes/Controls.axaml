<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:NebulaLauncher.Services"
        xmlns:primitives="using:Avalonia.Controls.Primitives">

  <!--
    Nebula 控件样式表（A/B 档：只改属性、改模板内部件）。
    C 档（必须整体换模板的控件）在 Themes/ControlThemes/ 下，用 ControlTheme 定义，
    这里只负责把那份资源字典挂进来。分界：样式会积累、主题整体替换。

    动效统一走 Transitions，时长取自 Motion.* 令牌；页面不写颜色 / 字号 / 圆角 / 时长字面量。
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    页面根栅格必须占满 PageHost 画布：UserControl 与 ContentControl 的默认
    HorizontalContentAlignment/VerticalContentAlignment 都是 Left/Top，
    根 Grid 会塌到内容高度，`*` 行拿不到剩余空间（票 #106 的固定栅格就落空）。
    这是布局契约的地基，不是某个页面的样式。
  -->
  <Style Selector="UserControl">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!-- ================= 文本 ================= -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyLg}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Headline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
  </Style>

  <!-- ================= 按钮焦点环 ================= -->
  <!--
    Fluent 的 Button 样式会给 Button 重新设 FocusAdorner 与 :focus 前景，且 Style 的优先级高于
    ControlTheme，所以按钮的焦点环与聚焦文字色必须在这里覆盖（放在主题里会被 Fluent 抢回去）。
  -->
  <Style Selector="Button">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border primitives:AdornerLayer.IsClipEnabled="False"
                Margin="-3"
                BorderBrush="{DynamicResource Stroke.Focus}"
                BorderThickness="2"
                CornerRadius="{DynamicResource Radius.Lg}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Button:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.primary:focus, Button.primary:focus-visible">
    <Setter Property="Background" Value="{DynamicResource Gradient.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="Button.accent:focus, Button.accent:focus-visible">
    <Setter Property="Background" Value="{DynamicResource Gradient.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="Button.danger:focus, Button.danger:focus-visible">
    <Setter Property="Background" Value="{DynamicResource Status.Danger}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <!-- ================= 输入框 ================= -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyLg}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border primitives:AdornerLayer.IsClipEnabled="False"
                Margin="-3"
                BorderBrush="{DynamicResource Stroke.Focus}"
                BorderThickness="2"
                CornerRadius="{DynamicResource Radius.Md}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
  </Style>

  <Style Selector="TextBox.multiline">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="Padding" Value="36,0,12,0" />
  </Style>

  <!-- ================= 下拉框 ================= -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyLg}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border primitives:AdornerLayer.IsClipEnabled="False"
                Margin="-3"
                BorderBrush="{DynamicResource Stroke.Focus}"
                BorderThickness="2"
                CornerRadius="{DynamicResource Radius.Md}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#HighlightBackground">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
  </Style>

  <Style Selector="ComboBox:focus /template/ Border#HighlightBackground">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
  </Style>

  <!-- 下拉面板：玻璃层 + 16 圆角 + 浮层阴影。PopupBorder 的背景在 Fluent 模板里是独立资源，只改外框不会影响它。 -->
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Surface.Glass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Overlay}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- 展开时箭头翻转 180°。 -->
  <Style Selector="ComboBox[IsDropDownOpen=true] /template/ PathIcon#DropDownGlyph">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyLg}" />
  </Style>

  <!-- ================= 开关 ================= -->
  <!--
    ToggleSwitch 的轨道 40×20 写死在 Fluent 模板里，普通 Style 改不到尺寸。
    这里用 1.1 / 1.2 的 RenderTransform 把它放大到视觉上的 44×24；颜色覆盖到模板内部件。
    不重写模板的原因：ToggleSwitch 的实现会在 OnApplyTemplate 里取 PART_SwitchKnob /
    PART_MovingKnobs 做像素级动画，自写模板容易在运行期空引用，收益也只是一个尺寸。
  -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyLg}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="scale(1.1,1.2)" />
    <Setter Property="RenderTransformOrigin" Value="0%,50%" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border primitives:AdornerLayer.IsClipEnabled="False"
                Margin="-3"
                BorderBrush="{DynamicResource Stroke.Focus}"
                BorderThickness="2"
                CornerRadius="{DynamicResource Radius.Pill}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Stroke.Strong}" />
  </Style>

  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Stroke.Default}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
  </Style>

  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
  </Style>

  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff">
    <Setter Property="Fill" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- ================= 滚动条 ================= -->
  <!--
    滚动条是 C 档控件，但 11.3 的 ScrollBar 自定义模板里 Track 的 Thumb 在本机不渲染
    （独立 ScrollBar 与 ScrollViewer 内嵌两种情况都试过），会得到一条完全不显示的滚动条。
    这里退回到 Fluent 模板 + 样式覆盖：宽度 8（hover 10）、胶囊滑块、透明轨道、隐藏箭头。
    偏差已记在票 #84 的交付说明里：视觉达标，但实现手段是「改模板内部件」而非整体换主题。
  -->
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:vertical:pointerover">
    <Setter Property="Width" Value="10" />
  </Style>

  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:horizontal:pointerover">
    <Setter Property="Height" Value="10" />
  </Style>

  <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar /template/ RepeatButton#PART_PageUpButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar /template/ RepeatButton#PART_PageDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Scrollbar.Thumb}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Stroke.Strong}" />
  </Style>

  <!-- ================= 列表项 ================= -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border primitives:AdornerLayer.IsClipEnabled="False"
                Margin="-3"
                BorderBrush="{DynamicResource Stroke.Focus}"
                BorderThickness="2"
                CornerRadius="{DynamicResource Radius.Md}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static services:Motion.Fast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem.compact">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="RenderTransform" Value="translate(2px,0)" />
  </Style>

  <!--
    选中态：Fluent 默认用系统强调色 60% 填充，浅色底上会变成一整块高饱和紫蓝。
    统一改回 Accent.Soft（主色 10%）+ 正文色，并同时改模板里的 ContentPresenter，
    否则 Fluent 的 /template/ 规则优先级更高。
  -->
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
  </Style>

  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
  </Style>

  <Style Selector="ListBoxItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- ================= 卡片与玻璃面板 ================= -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface.CardSolid}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Xl}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glass}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static services:Motion.Fast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.card.hero">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.X3l}" />
    <Setter Property="Padding" Value="28" />
  </Style>

  <Style Selector="Border.card.hoverable:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="RenderTransform" Value="translate(0,-3px)" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.CardHover}" />
  </Style>

  <Style Selector="Border.card.accentEdge">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Soft}" />
  </Style>

  <!--
    列表行（票 #90 起）：高 56、圆角 12、横向内边距 12，L3 实心。

    取样板 _page-shell.html 的 .row：
      hover  = 白 62% 底 + 白 95% 边 + 右移 2px
      sel    = 主色 10% 底 + 主色 28% 边 + 左侧 3px 主色条
    主色条用 BoxShadow 的 inset 表达要写字面量，这里用 1px 主色边框近似——
    「选中」在一屏十几行里靠底色与边框已经足够分辨。

    与 Border.card 的区别是语义：card 是可嵌套的容器（圆角 20、内边距 20），
    listrow 是一行数据（圆角 12、横向 12），行里禁止再放 card。
  -->
  <Style Selector="Border.listrow">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static services:Motion.Fast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.listrow:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
    <Setter Property="RenderTransform" Value="translate(2px,0)" />
  </Style>

  <Style Selector="Border.listrow.selected">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
  </Style>

  <!--
    行内图标底座：32×32 圆角 9、白 80% 底 + 白 95% 边（样板 .row .ric）。
    深色主题下 Surface.CardSolid 是近黑，Counter 一样成立：图标始终坐在「比行底亮一点」的方块上。
  -->
  <Style Selector="Border.rowicon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    <Setter Property="Background" Value="{DynamicResource Surface.CardSolid}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource Surface.Glass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Xl}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glass}" />
  </Style>

  <Style Selector="Border.glass.hero">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.X3l}" />
    <Setter Property="Padding" Value="28" />
    <!-- 高度必须写在样式里：内联 Height 是本地值，会压过 Window.compact 的 1024 档（PITFALLS 4.2）。 -->
    <Setter Property="Height" Value="200" />  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Stroke.Subtle}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <!-- 内凹区域：日志、代码、路径展示 -->
  <Style Selector="Border.sunken">
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- ================= 状态徽标 ================= -->
  <Style Selector="Border.badge">
    <Setter Property="Height" Value="20" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.badge.success">
    <Setter Property="Background" Value="{DynamicResource Status.Success.Soft}" />
  </Style>

  <Style Selector="Border.badge.warning">
    <Setter Property="Background" Value="{DynamicResource Status.Warning.Soft}" />
  </Style>

  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{DynamicResource Status.Danger.Soft}" />
  </Style>

  <Style Selector="Border.badge.info">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
  </Style>

  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="Border.badge.success > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Status.Success}" />
  </Style>

  <Style Selector="Border.badge.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
  </Style>

  <Style Selector="Border.badge.danger > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
  </Style>

  <Style Selector="Border.badge.info > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
  </Style>

  <!-- ================= 筛选分段 ================= -->
  <!--
    筛选分段与页签是两件东西：页签用 TabControl（.TabItem），筛选用 ToggleButton 组 + .segmented。
    类名不共用，避免「筛选被当成页签」——见票 #84 的边界条款。
  -->
  <Style Selector="ToggleButton.segmented">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Background" Value="Transparent" />
    <!-- 边框常态占位：选中态只换颜色不换厚度，否则按钮内容会横向跳 2px。 -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="Foreground" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="BorderBrush" Duration="{x:Static services:Motion.Fast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.segmented:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
  </Style>

  <!--
    选中态是「白底 + 主色字 + 主色细边」，不是实心主色块。
    取样板 mods-glass.html 的 .tgls a.on：筛选是**轻量选中**，与页签（实心主色胶囊）
    是两种控件、两套视觉——同屏若都用实心主色，用户会分不清哪个在切换视图、哪个在过滤。
  -->
  <Style Selector="ToggleButton.segmented:checked">
    <Setter Property="Background" Value="{DynamicResource Surface.CardSolid}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
  </Style>

  <Style Selector="ToggleButton.segmented:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface.CardSolid}" />
  </Style>

  <!--
    必须打到模板内部的 ContentPresenter：Fluent 的 ToggleButton 主题在
    `^:checked /template/ ContentPresenter#PART_ContentPresenter` 上直接设了
    Background / Foreground，控件级的 setter 会被它盖掉（截图上表现为「选中仍是实心主色」）。
    这是 PITFALLS 记的同一类坑：模板内部件的本地值优先于外层样式。
  -->
  <Style Selector="ToggleButton.segmented:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.CardSolid}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ToggleButton.segmented /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!--
    内容页工具条的宽度档（票 #90）：宽屏 320 / 216，紧凑 196 / 168。
    写进样式而不是页面内联——内联 Width 是本地值，会压过 Window.compact 档（PITFALLS 4.2）。
    取样板 mods-glass.html 的 .search 与 .pick。
  -->
  <Style Selector="TextBox.modsearch">
    <Setter Property="MaxWidth" Value="320" />
  </Style>

  <Style Selector="Window.compact TextBox.modsearch">
    <Setter Property="MaxWidth" Value="196" />
  </Style>

  <Style Selector="ComboBox.modtarget">
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="MaxWidth" Value="216" />
  </Style>

  <Style Selector="Window.compact ComboBox.modtarget">
    <Setter Property="MinWidth" Value="130" />
    <Setter Property="MaxWidth" Value="168" />
  </Style>

  <!-- 紧凑档筛选按钮收窄内边距（样板 .tgls a 在 1024 档是 0 8px） -->
  <Style Selector="Window.compact ToggleButton.segmented">
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- ================= 一级导航（票 #85） ================= -->
  <!--
    左侧玻璃竖栏里的导航项，形态取自已定版样张 home-glass.html 的 .navb：
    宽 52、高 46、圆角 14，图标在上、文字在下，选中是主色实心块 + 辉光。
    样式放在控件层而不是 MainWindow.Styles：§7.5 要求 A/B 档样式集中在 Themes/Controls.axaml。
  -->
  <Style Selector="Button.nav">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="46" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border primitives:AdornerLayer.IsClipEnabled="False"
                Margin="-3"
                BorderBrush="{DynamicResource Stroke.Focus}"
                BorderThickness="2"
                CornerRadius="{DynamicResource Radius.Md}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{x:Static services:Motion.Fast}" />
        <BrushTransition Property="Foreground" Duration="{x:Static services:Motion.Fast}" />
        <DoubleTransition Property="Opacity" Duration="{x:Static services:Motion.Instant}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.nav Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- 栏宽只有 82，导航文字用 11（FontSize.Caption）；再大就折行。 -->
  <Style Selector="TextBlock.nav-label">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface.NavHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.nav:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.nav:pointerover TextBlock.nav-label">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="Button.nav.active Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="Button.nav.active TextBlock.nav-label">
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="Button.nav.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <!-- 选中态辉光落在模板内的底板上；这是控件层样式，不是页面级模板侵入。 -->
  <Style Selector="Button.nav.active /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glow}" />
  </Style>

  <!-- 1024×660：栏宽 68、项 46×40、图标 17、标题 26、窗口三键 29×25。 -->
  <Style Selector="Window.compact Button.nav">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
  </Style>

  <Style Selector="Window.compact Button.nav Path">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
  </Style>

  <Style Selector="Window.compact Button.window-btn">
    <Setter Property="Width" Value="29" />
    <Setter Property="Height" Value="25" />
    <Setter Property="MinHeight" Value="25" />
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
  </Style>

  <!-- 启动页 hero（票 #86）：实例名 26 / 版本与加载器 13 / 上次游玩与账户 11。 -->
  <Style Selector="TextBlock.hero-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Headline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style Selector="TextBlock.hero-meta">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <Style Selector="TextBlock.hero-account">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>

  <!-- 1024×660：hero 降到 168，实例名降一档，避免首屏被大卡吃掉 4 行实例的位置。 -->
  <Style Selector="Window.compact Border.glass.hero">
    <Setter Property="Height" Value="168" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Window.compact TextBlock.hero-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}" />
  </Style>

  <Style Selector="Window.compact TextBlock.page-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Headline}" />
  </Style>
  <!-- ================= 窗口三键 ================= -->
  <!-- 33×29、8 圆角；关闭 hover 用危险色。图标尺寸由使用方的 Path / Rectangle 设（10px）。 -->
  <Style Selector="Button.window-btn">
    <Setter Property="Width" Value="33" />
    <Setter Property="Height" Value="29" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 图标默认描边必须在样式里：Path 上的本地值会压过 :pointerover 的样式 setter。 -->
  <Style Selector="Button.window-btn Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="StrokeThickness" Value="1.1" />
  </Style>

  <Style Selector="Button.window-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.window-btn.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource Window.CloseHover}" />
  </Style>

  <!-- 红色底上浅灰叉号在浅色主题里对比度不足，悬停时统一转成反白色（两种主题都是白）。 -->
  <Style Selector="Button.window-btn.close:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <!-- ================= 三键胶囊（票 #107） =================
       三键收进一枚 L2 玻璃胶囊：主页停在 TitleBar 搜索框右侧，其余页贴右。
       按钮沿用 Button.window-btn 的尺寸与六态，只加 .solid 修饰类换实块背景；
       演示页（ControlsGalleryView）仍用不带 .solid 的透明形态。 -->
  <Style Selector="Border.winpill">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Surface.Glass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Glass}" />
  </Style>

  <Style Selector="Button.window-btn.solid">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
  </Style>

  <!-- 实块上图标要更重一档：10px 缩放下 1.1 的线在白块上几乎看不见 -->
  <Style Selector="Button.window-btn.solid Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

  <Style Selector="Button.window-btn.solid:pointerover">
    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
  </Style>

  <Style Selector="Button.window-btn.solid:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.OnAccent}" />
  </Style>

  <Style Selector="Button.window-btn.close.solid:pointerover">
    <Setter Property="Background" Value="{DynamicResource Window.CloseHover}" />
  </Style>

  <Style Selector="Button.window-btn.solid:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>

  <!-- 主页专属搜索框：只在主页出现，其余页 IsVisible=false 不占位 -->
  <Style Selector="Border.titlesearch">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="15,0" />
  </Style>

  <!-- 搜索框里的放大镜：描边交给样式。Path 上写内联 Stroke 会压过样式 setter，
       下次给搜索框加 hover 换色就会静默失效（PITFALLS 4.2）。 -->
  <Style Selector="Border.titlesearch Path">
    <Setter Property="Stroke" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>

  <!-- ================= 滚动容器 ================= -->
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ================= 页签条（只切视图，不承载内容） ================= -->
  <!--
    版本页的三视图要求「切走再切回原样恢复」筛选与滚动位置。TabControl 默认只为选中项
    实例化 content，切走的那份会被从可视树摘下并在回来时重建，滚动位置随之归零；
    所以三份列表同时留在可视树、靠 IsVisible 切换，页签条单独用这个 strip 变体。
    主题模板在 ControlThemes/TabControl.axaml，这里只把类名接到它上面。
  -->
  <Style Selector="TabControl.strip">
    <Setter Property="Theme" Value="{StaticResource TabControlStrip}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ================= 版本页详情栏 ================= -->
  <!--
    设计稿要求详情宽 380、1024 档收成 320。宽度必须写在样式里而不是内联：
    内联 Width 是本地值，会压过这里的 Window.compact 档（PITFALLS 4.2）。
    阈值与外壳同一档（1120）：两处各写一个阈值时，窗口停在两者之间会出现
    「侧栏已经是紧凑档、详情还是宽档」的错配。
  -->
  <Style Selector="Border.detail-pane">
    <Setter Property="Width" Value="380" />
  </Style>

  <Style Selector="Window.compact Border.detail-pane">
    <Setter Property="Width" Value="320" />
  </Style>

</Styles>
