<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:NebulaLauncher.Controls">

  <!--
    玻璃面板（#105 终版——对照样板逐项做满）：

    样张 .glass 的四件事：
    1. 左上角强光源（radial 92% 白，集中、不晕散）
    2. 背景透出（模糊副本 + 色彩增强 saturate 190%）
    3. 边缘折射（顶亮白 2px、左右白 75%、底白 60%）
    4. 厚度（八条 inset + 外投影）

    这版的改动：
    - Glow 层不挂 BlurEffect（光要集中，blur 会稀释亮度）
    - 边缘折射：Shadow.Glass 的 inset 加强（顶 2px 纯白）
    - 色调层：Surface.Glass 半透明蓝白（染上背景色）
    - 背景副本：BlurEffect 24px（模糊背景，不是模糊光）
  -->
  <ControlTheme x:Key="{x:Type controls:GlassPanel}" TargetType="controls:GlassPanel">
    <Setter Property="Background" Value="{DynamicResource Gradient.Canvas}" />
    <Setter Property="Tint" Value="Transparent" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Xl}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="PART_Clip"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Panel x:Name="PART_CopyLayer">
              <!-- 模糊背景副本：玻璃主体（BlurEffect 由代码设）。
                   Canvas 定位：副本带外扩边距与显式尺寸，不能参与父测量，否则会把卡片撑大。 -->
              <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="PART_Copy"
                           Fill="{TemplateBinding Background}"
                           IsHitTestVisible="False" />
              </Canvas>
              <!-- 发光晕开：DropShadowEffect 让背景色块向外辐射光，模拟
                   CSS saturate(190%) brightness(1.04) 的泛光效果。 -->
              <Border Background="{DynamicResource Glass.Bloom}" IsHitTestVisible="False" />
              <!-- Tint：Transparent，不盖背景 -->
              <Border Background="{TemplateBinding Tint}" IsHitTestVisible="False" />
              <!-- 内部泛光（不挂 blur，光要集中）：底部反光带 -->
              <Border Background="{DynamicResource Glass.GlowWash}" IsHitTestVisible="False" />
              <!-- 右下柔光 -->
              <Border Background="{DynamicResource Glass.GlowBottomRight}" IsHitTestVisible="False" />
              <!-- 左上主光源：最强、最集中 -->
              <Border Background="{DynamicResource Glass.GlowTopLeft}" IsHitTestVisible="False" />
            </Panel>
          </Border>

          <!-- 边缘折射：Shadow.Glass 的 inset 承担（顶亮白、左右白、底白） -->
          <Border BorderBrush="{DynamicResource Glass.Edge}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource Shadow.Glass}"
                  IsHitTestVisible="False" />

          <ContentPresenter x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>