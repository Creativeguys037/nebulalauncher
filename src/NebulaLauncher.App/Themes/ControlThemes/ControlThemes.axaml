<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    C 档控件主题（必须整体替换 Fluent 模板的控件）。
    每个文件一个控件，集中在这里合并；App 侧只认这一个入口。
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/Button.axaml" />
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/CheckBox.axaml" />
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/DialogOverlay.axaml" />
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/GlassPanel.axaml" />
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/ProgressBar.axaml" />
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/TabControl.axaml" />
    <ResourceInclude Source="avares://NebulaLauncher/Themes/ControlThemes/ToolTip.axaml" />
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
